{% layout none %}
<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Gift Card &ndash; {{ shop.name }}</title>
    {{ 'asmaan-prototype.css' | asset_url | stylesheet_tag }}
    {{ content_for_header }}
  </head>
  <body class="bg-black text-white min-h-screen flex flex-col items-center justify-center p-6 text-center">
    <div class="loader_mark mb-6">
      ASMAAN
      <span class="loader_tagline">AMBITION TONIC</span>
    </div>
    <h1 class="text-3xl font-bold mb-4">Your Gift Card</h1>
    <div class="text-4xl font-mono mb-6">{{ gift_card.balance | money_with_currency }}</div>
    <p class="font-mono bg-white/10 px-6 py-3 rounded-full text-lg mb-8 tracking-wider">{{ gift_card.code | format_code }}</p>
    <a href="{{ shop.url }}" class="button">Start shopping</a>
  </body>
</html>
