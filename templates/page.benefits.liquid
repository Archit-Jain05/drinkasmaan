<section class="asmaan-subpage-section">
  <div class="padding-global">
    <div class="container-large max-w-5xl mx-auto px-4">
      <div class="asmaan-subpage-hero">
        <span class="asmaan-subpage-tag">Formulated for Performance</span>
        <h1 class="asmaan-subpage-title">The Science of Asmaan</h1>
        <p class="asmaan-subpage-sub">
          Energy drinks were engineered for athletes and video gamers. Asmaan is engineered for creators, builders, and deep thinkers who need sustained focus without jitters or burnout.
        </p>
      </div>

      <!-- 4 Pillars Deep-Dive Grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-16">
        <!-- Pillar 1 -->
        <div class="asmaan-pillar-item p-6 md:p-8">
          <div class="flex items-center gap-3 mb-4">
            <span class="asmaan-pillar-icon h-8 w-8">
              {% render 'asmaan-icons', name: 'benefit', icon: 'sugar', class: 'h-4 w-4' %}
            </span>
            <div>
              <span class="font-mono text-xs text-white/50 uppercase tracking-widest">Pillar 01</span>
              <h2 class="text-xl font-bold uppercase tracking-tight text-white">Zero Sugar &bull; 10 Calories</h2>
            </div>
          </div>
          <p class="text-white/70 leading-relaxed text-sm">
            Sugar causes insulin spikes followed by debilitating mental fog. Asmaan contains 0g added sugar and only 10 calories per can. The subtle flavor comes entirely from cold-pressed Himalayan fruit essences and botanicals.
          </p>
          <div class="mt-4 pt-4 border-t border-white/10 font-mono text-xs uppercase tracking-widest text-[#9089D3]">
            10 kcal per 250ml &bull; Low Glycemic
          </div>
        </div>

        <!-- Pillar 2 -->
        <div class="asmaan-pillar-item p-6 md:p-8">
          <div class="flex items-center gap-3 mb-4">
            <span class="asmaan-pillar-icon h-8 w-8">
              {% render 'asmaan-icons', name: 'benefit', icon: 'bean', class: 'h-4 w-4' %}
            </span>
            <div>
              <span class="font-mono text-xs text-white/50 uppercase tracking-widest">Pillar 02</span>
              <h2 class="text-xl font-bold uppercase tracking-tight text-white">Clean Botanical Caffeine</h2>
            </div>
          </div>
          <p class="text-white/70 leading-relaxed text-sm">
            Standard energy drinks use harsh synthetic caffeine anhydrous. We extract 100mg of natural caffeine directly from unroasted green coffee beans. It metabolizes smoothly over 4–6 hours without the steep spike or abrupt crash.
          </p>
          <div class="mt-4 pt-4 border-t border-white/10 font-mono text-xs uppercase tracking-widest text-[#EFB36B]">
            100mg Raw Green Coffee &bull; Smooth Curve
          </div>
        </div>

        <!-- Pillar 3 -->
        <div class="asmaan-pillar-item p-6 md:p-8">
          <div class="flex items-center gap-3 mb-4">
            <span class="asmaan-pillar-icon h-8 w-8">
              {% render 'asmaan-icons', name: 'benefit', icon: 'curve', class: 'h-4 w-4' %}
            </span>
            <div>
              <span class="font-mono text-xs text-white/50 uppercase tracking-widest">Pillar 03</span>
              <h2 class="text-xl font-bold uppercase tracking-tight text-white">L-Theanine + Ashwagandha</h2>
            </div>
          </div>
          <p class="text-white/70 leading-relaxed text-sm">
            The golden 2:1 ratio. 200mg of fermented L-Theanine stimulates alpha brain waves, smoothing out caffeine's nervous edge. Paired with 300mg of KSM-66 Ashwagandha to balance cortisol and maintain relaxed mental composure.
          </p>
          <div class="mt-4 pt-4 border-t border-white/10 font-mono text-xs uppercase tracking-widest text-[#E6A0E8]">
            200mg L-Theanine &bull; 300mg KSM-66
          </div>
        </div>

        <!-- Pillar 4 -->
        <div class="asmaan-pillar-item p-6 md:p-8">
          <div class="flex items-center gap-3 mb-4">
            <span class="asmaan-pillar-icon h-8 w-8">
              {% render 'asmaan-icons', name: 'cross', class: 'h-4 w-4' %}
            </span>
            <div>
              <span class="font-mono text-xs text-white/50 uppercase tracking-widest">Pillar 04</span>
              <h2 class="text-xl font-bold uppercase tracking-tight text-white">Clean Label &bull; No Synthetic Dyes</h2>
            </div>
          </div>
          <p class="text-white/70 leading-relaxed text-sm">
            Zero artificial food coloring, no Red 40, no Yellow 5, no proprietary blends. Every single milligram is printed directly on the front of the can. The deep purple and golden colors come naturally from the fruit itself.
          </p>
          <div class="mt-4 pt-4 border-t border-white/10 font-mono text-xs uppercase tracking-widest text-white/50">
            100% Vegan &bull; Non-GMO &bull; Gluten Free
          </div>
        </div>
      </div>

      <!-- Comparative Table -->
      <div class="mb-16">
        <div class="text-center mb-8">
          <span class="font-mono text-xs uppercase tracking-widest text-white/50">Direct Comparison</span>
          <h2 class="text-2xl sm:text-3xl font-bold uppercase tracking-tight text-white mt-1">How Asmaan Compares</h2>
        </div>

        <div class="overflow-x-auto">
          <table class="asmaan-comp-table">
            <thead>
              <tr>
                <th>Feature</th>
                <th class="brand-col bg-white/10">ASMAAN TONIC</th>
                <th>Standard Energy Drink</th>
                <th>Cold Brew Coffee</th>
              </tr>
            </thead>
            <tbody>
              <tr class="highlight">
                <td class="font-medium text-white">Added Sugar</td>
                <td class="brand-col text-[#9089D3] font-bold">0g (10 kcal)</td>
                <td class="text-white/60">27g - 54g (High)</td>
                <td class="text-white/60">0g</td>
              </tr>
              <tr>
                <td class="font-medium text-white">Caffeine Source</td>
                <td class="brand-col text-white font-bold">Green Coffee Bean (100mg)</td>
                <td class="text-white/60">Synthetic Anhydrous (160mg+)</td>
                <td class="text-white/60">Roasted Beans (150-200mg)</td>
              </tr>
              <tr class="highlight">
                <td class="font-medium text-white">Jitters &amp; Crash</td>
                <td class="brand-col text-emerald-400 font-bold">Zero (L-Theanine smoothed)</td>
                <td class="text-rose-400">Severe Jitters &amp; Crash</td>
                <td class="text-amber-400">Moderate Jitters</td>
              </tr>
              <tr>
                <td class="font-medium text-white">Nootropics &amp; Adaptogens</td>
                <td class="brand-col text-emerald-400 font-bold">L-Theanine + KSM-66</td>
                <td class="text-white/40">None</td>
                <td class="text-white/40">None</td>
              </tr>
              <tr class="highlight">
                <td class="font-medium text-white">Artificial Dyes</td>
                <td class="brand-col text-emerald-400 font-bold">None (100% Real Fruit)</td>
                <td class="text-rose-400">Red 40, Yellow 5, Blue 1</td>
                <td class="text-white/60">None</td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>

      <!-- Action Footer -->
      <div class="text-center py-8">
        <a href="/#range" class="button is-hero is-primary">
          <span>Taste the Difference &bull; Shop Range</span>
          <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
          </svg>
        </a>
      </div>
    </div>
  </div>
</section>

{% section 'asmaan-newsletter' %}
