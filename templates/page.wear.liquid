<section class="asmaan-subpage-section">
  <div class="padding-global">
    <div class="container-large max-w-6xl mx-auto px-4">
      <div class="asmaan-subpage-hero">
        <span class="asmaan-subpage-tag">Studio Uniform</span>
        <h1 class="asmaan-subpage-title">Asmaan Studio Wear</h1>
        <p class="asmaan-subpage-sub">
          Architectural apparel designed for long sessions of creative discipline. Heavyweight textiles, minimal branding, and tailored utilitarian cuts.
        </p>
      </div>

      <!-- Studio Wear Grid -->
      <div class="asmaan-wear-grid mb-16">
        <!-- Item 1 -->
        <div class="asmaan-wear-card group">
          <div class="asmaan-wear-img-wrap">
            <span class="asmaan-wear-badge">DROP 01</span>
            <div class="text-center p-6">
              <svg class="h-24 w-24 mx-auto text-white/40 group-hover:text-white transition-colors duration-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z" />
              </svg>
            </div>
          </div>
          <div class="flex items-center justify-between mb-1">
            <h2 class="font-bold text-base uppercase tracking-tight text-white">Studio Heavyweight Tee</h2>
            <span class="font-mono text-sm text-white/80">&#8377;2,499</span>
          </div>
          <p class="text-xs text-white/50 mb-4">300 GSM combed loopback cotton, relaxed drop-shoulder cut, tonal insignia print.</p>
          <a href="#wear-waitlist" class="button is-hero is-secondary is-full text-center text-xs py-2 mt-auto">
            Join Drop Waitlist
          </a>
        </div>

        <!-- Item 2 -->
        <div class="asmaan-wear-card group">
          <div class="asmaan-wear-img-wrap">
            <span class="asmaan-wear-badge">DROP 01</span>
            <div class="text-center p-6">
              <svg class="h-24 w-24 mx-auto text-white/40 group-hover:text-white transition-colors duration-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M12 4v16m8-8H4" />
              </svg>
            </div>
          </div>
          <div class="flex items-center justify-between mb-1">
            <h2 class="font-bold text-base uppercase tracking-tight text-white">Creative Flow Hoodie</h2>
            <span class="font-mono text-sm text-white/80">&#8377;4,999</span>
          </div>
          <p class="text-xs text-white/50 mb-4">480 GSM dense French terry, double-layered architectural hood, hidden tech pocket.</p>
          <a href="#wear-waitlist" class="button is-hero is-secondary is-full text-center text-xs py-2 mt-auto">
            Join Drop Waitlist
          </a>
        </div>

        <!-- Item 3 -->
        <div class="asmaan-wear-card group">
          <div class="asmaan-wear-img-wrap">
            <span class="asmaan-wear-badge">DROP 01</span>
            <div class="text-center p-6">
              <svg class="h-24 w-24 mx-auto text-white/40 group-hover:text-white transition-colors duration-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4" />
              </svg>
            </div>
          </div>
          <div class="flex items-center justify-between mb-1">
            <h2 class="font-bold text-base uppercase tracking-tight text-white">Matte Field Cap</h2>
            <span class="font-mono text-sm text-white/80">&#8377;1,899</span>
          </div>
          <p class="text-xs text-white/50 mb-4">Weatherproof matte nylon, FIDLOCK magnetic buckle, anti-sweat internal headband.</p>
          <a href="#wear-waitlist" class="button is-hero is-secondary is-full text-center text-xs py-2 mt-auto">
            Join Drop Waitlist
          </a>
        </div>

        <!-- Item 4 -->
        <div class="asmaan-wear-card group">
          <div class="asmaan-wear-img-wrap">
            <span class="asmaan-wear-badge">DROP 01</span>
            <div class="text-center p-6">
              <svg class="h-24 w-24 mx-auto text-white/40 group-hover:text-white transition-colors duration-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" />
              </svg>
            </div>
          </div>
          <div class="flex items-center justify-between mb-1">
            <h2 class="font-bold text-base uppercase tracking-tight text-white">Studio Aluminum Tote</h2>
            <span class="font-mono text-sm text-white/80">&#8377;1,499</span>
          </div>
          <p class="text-xs text-white/50 mb-4">Reinforced 24oz waxed canvas with custom anodized aluminum hardware clip.</p>
          <a href="#wear-waitlist" class="button is-hero is-secondary is-full text-center text-xs py-2 mt-auto">
            Join Drop Waitlist
          </a>
        </div>
      </div>

      <!-- Waitlist Signup Banner -->
      <div id="wear-waitlist" class="max-w-xl mx-auto text-center p-8 rounded-2xl bg-white/[0.03] border border-white/10 mb-12">
        <span class="font-mono text-xs uppercase tracking-widest text-[#9089D3] block mb-2">Exclusive Allocation</span>
        <h2 class="text-2xl font-bold uppercase tracking-tight text-white mb-2">Drop 01 Access</h2>
        <p class="text-sm text-white/70 mb-6">
          Quantities are strictly limited to 250 units per garment. Register your email for early password-protected access 1 hour before general release.
        </p>
        {% form 'customer' %}
          <input type="hidden" name="contact[tags]" value="wear_waitlist">
          <div class="flex flex-col sm:flex-row gap-3">
            <input
              type="email"
              name="contact[email]"
              required
              placeholder="Enter your email"
              class="newsletter_input flex-1 !h-12 !text-sm !bg-black/60 !border-white/20"
            >
            <button type="submit" class="button is-hero is-primary !h-12 whitespace-nowrap px-6">
              Request Access
            </button>
          </div>
          {%- if form.posted_successfully? -%}
            <p class="text-emerald-400 text-xs mt-3 font-mono">You are on the VIP waitlist for Drop 01.</p>
          {%- endif -%}
        {% endform %}
      </div>
    </div>
  </div>
</section>

{% section 'asmaan-newsletter' %}
