<!doctype html>
<html class="no-js min-h-full antialiased" lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0">
    <meta name="theme-color" content="#000000">

    <link rel="canonical" href="{{ canonical_url }}">

    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
    {%- endif -%}

    <title>
      {{ page_title }}
      {%- if current_tags %} &ndash; tagged "{{ current_tags | join: ', ' }}"{% endif -%}
      {%- if current_page != 1 %} &ndash; Page {{ current_page }}{% endif -%}
      {%- unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless -%}
    </title>

    {% if page_description %}
      <meta name="description" content="{{ page_description | escape }}">
    {% endif %}

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Geist+Mono:wght@400;500&family=Geist:wght@300;400;500;700;800&family=Libre+Franklin:ital,wght@0,300;0,400;0,700;0,900;1,900&display=swap" rel="stylesheet">

    {{ 'asmaan-prototype.css' | asset_url | stylesheet_tag }}
    {{ 'asmaan-can-3d.css' | asset_url | stylesheet_tag }}
    {%- comment -%} Tailwind utilities used by the theme but missing from asmaan-prototype.css (see PROJECT_HANDOFF.md). {%- endcomment -%}
    {{ 'asmaan-utilities.css' | asset_url | stylesheet_tag }}
    {%- comment -%} Small-screen corrections; must load last. {%- endcomment -%}
    {{ 'asmaan-mobile.css' | asset_url | stylesheet_tag }}

    <script>
      window.ASMAAN_CONFIG = {
        engineType: {{ settings.engine_type | default: 'cylinder_can' | json }},
        canShape: {{ settings.can_shape | default: '250ml_slim' | json }},
        enableCondensation: {{ settings.enable_condensation | default: true | json }},
        autoSpinSpeed: {{ settings.auto_spin_speed | default: 0.3 | json }},
        cartType: {{ settings.cart_type | default: 'drawer' | json }},
        freeShippingThreshold: {{ settings.free_shipping_threshold | default: 99900 | json }},
        predictiveSearchEnabled: {{ settings.predictive_search_enabled | default: true | json }},
        routes: {
          cart_url: '{{ routes.cart_url }}',
          cart_add_url: '{{ routes.cart_add_url }}',
          cart_change_url: '{{ routes.cart_change_url }}',
          predictive_search_url: '{{ routes.predictive_search_url }}'
        }
      };
    </script>

    {{ content_for_header }}
  </head>

  <body class="template-{{ template.name | default: 'index' }} min-h-full text-white antialiased bg-black">
    <a class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-50 focus:bg-white focus:text-black focus:p-4" href="#MainContent">
      Skip to content
    </a>

    {% section 'asmaan-navbar' %}
    <script>
      // Expose the fixed navbar height as --asmaan-header-h for sections that sit below it.
      (function () {
        var nav = document.querySelector('header.navbar');
        if (!nav) return;
        function set() { document.documentElement.style.setProperty('--asmaan-header-h', nav.getBoundingClientRect().height + 'px'); }
        set();
        if ('ResizeObserver' in window) new ResizeObserver(set).observe(nav);
      })();
    </script>

    <script src="{{ 'three.min.js' | asset_url }}" defer></script>
    <div id="top">
      <main id="MainContent" role="main" tabindex="-1">
        {{ content_for_layout }}
      </main>
    </div>

    {% section 'asmaan-footer' %}

    {% section 'cart-drawer' %}
    {% section 'predictive-search' %}

    <script src="{{ 'cart-drawer.js' | asset_url }}" defer></script>
    <script src="{{ 'predictive-search.js' | asset_url }}" defer></script>
    <script src="{{ 'asmaan-can-3d.js' | asset_url }}" defer></script>
    <script src="{{ 'asmaan-prototype.js' | asset_url }}" defer></script>
  </body>
</html>
