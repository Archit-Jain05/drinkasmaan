{%- comment -%}
  Asmaan SVG Icons snippet
  Usage:
    {% render 'asmaan-icons', name: 'arrow', direction: 'left', class: 'h-5 w-5' %}
    {% render 'asmaan-icons', name: 'benefit', icon: 'sugar', class: 'h-full w-full' %}
{%- endcomment -%}

{%- case name -%}
  {%- when 'arrow' -%}
    <svg viewBox="0 0 24 24" class="{{ class }}" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <g {% if direction == 'left' %}transform="rotate(180 12 12)"{% endif %}>
        <path d="M4 12h15" />
        <path d="M13.5 6.5 20 12l-6.5 5.5" />
      </g>
    </svg>

  {%- when 'plus' -%}
    <svg viewBox="0 0 24 24" class="{{ class }}" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M12 5v14M5 12h14" />
    </svg>

  {%- when 'cross' -%}
    <svg viewBox="0 0 12 12" class="{{ class }}" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M2.5 2.5 9.5 9.5M9.5 2.5 2.5 9.5" />
    </svg>

  {%- when 'corner' -%}
    <svg viewBox="0 0 8 8" class="{{ class }}" fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <g {% if flip %}transform="rotate(180 4 4)"{% endif %}>
        <path d="M0.5 7.5v-7h7" />
      </g>
    </svg>

  {%- when 'instagram' -%}
    <svg viewBox="0 0 24 24" class="{{ class }}" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <rect x="3.5" y="3.5" width="17" height="17" rx="5" />
      <circle cx="12" cy="12" r="4" />
      <circle cx="17.2" cy="6.8" r="0.9" fill="currentColor" stroke="none" />
    </svg>

  {%- when 'bars' -%}
    <svg viewBox="0 0 20 16" class="{{ class }}" aria-hidden="true">
      <rect x="1" y="5.5" width="2.4" height="5" rx="1.2" fill="currentColor" style="transition: y 0.3s ease, height 0.3s ease" />
      <rect x="6" y="2.5" width="2.4" height="11" rx="1.2" fill="currentColor" style="transition: y 0.3s ease, height 0.3s ease" />
      <rect x="11" y="4.5" width="2.4" height="7" rx="1.2" fill="currentColor" style="transition: y 0.3s ease, height 0.3s ease" />
      <rect x="16" y="1.5" width="2.4" height="13" rx="1.2" fill="currentColor" style="transition: y 0.3s ease, height 0.3s ease" />
    </svg>

  {%- when 'menu-dots' -%}
    <svg viewBox="0 0 12 12" class="{{ class }}" aria-hidden="true">
      <circle cx="2" cy="2" r="1.2" fill="currentColor" />
      <circle cx="10" cy="2" r="1.2" fill="currentColor" />
      <circle cx="2" cy="10" r="1.2" fill="currentColor" />
      <circle cx="10" cy="10" r="1.2" fill="currentColor" />
      <circle cx="6" cy="6" r="1.2" fill="currentColor" style="transform: scale(1); transform-origin: 6px 6px; transition: transform 0.35s ease" />
    </svg>

  {%- when 'benefit' -%}
    {%- case icon -%}
      {%- when 'sugar' -%}
        <svg viewBox="0 0 32 32" class="{{ class }}" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M6 12.5 16 7l10 5.5v7L16 25 6 19.5z" />
          <path d="M6 12.5 16 18l10-5.5M16 18v7" />
        </svg>
      {%- when 'bean' -%}
        <svg viewBox="0 0 32 32" class="{{ class }}" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <ellipse cx="16" cy="16" rx="7.5" ry="10.5" transform="rotate(35 16 16)" />
          <path d="M11.5 22.5c3-2.5 6-7.5 9-13" />
        </svg>
      {%- when 'drop' -%}
        <svg viewBox="0 0 32 32" class="{{ class }}" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M16 5.5c4.2 5.2 7 9 7 12.4a7 7 0 1 1-14 0C9 14.5 11.8 10.7 16 5.5z" />
          <path d="M12.5 18.6a3.5 3.5 0 0 0 3.5 3.5" opacity="0.6" />
        </svg>
      {%- when 'curve' -%}
        <svg viewBox="0 0 32 32" class="{{ class }}" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M4 23c4.2 0 5.6-13 9.8-13S18.8 20 23 20c2 0 3.7-1.3 5-2.8" />
          <path d="M4 27h24" opacity="0.45" />
        </svg>
    {%- endcase -%}

  {%- when 'star' -%}
    <svg viewBox="0 0 24 24" class="{{ class }}" aria-hidden="true">
      <path d="M12 0c.6 6.2 5.2 10.8 12 12-6.8 1.2-11.4 5.8-12 12-.6-6.2-5.2-10.8-12-12C6.8 10.8 11.4 6.2 12 0z" fill="currentColor" />
    </svg>
{%- endcase -%}
