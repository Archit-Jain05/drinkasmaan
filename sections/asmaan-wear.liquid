<section id="wear" class="section relative bg-black py-24 border-t border-white/10">
  <div class="padding-global">
    <div class="container-large max-w-6xl mx-auto px-4">
      <div class="asmaan-subpage-hero text-center mb-12">
        <span class="asmaan-subpage-tag">{{ section.settings.tag | default: 'Studio Uniform' }}</span>
        <h2 class="asmaan-subpage-title">{{ section.settings.title | default: 'Asmaan Studio Wear' }}</h2>
        <p class="asmaan-subpage-sub mx-auto">
          {{ section.settings.subtitle | default: 'Architectural apparel designed for long sessions of creative discipline. Heavyweight textiles, minimal branding, and tailored utilitarian cuts.' }}
        </p>
      </div>

      <!-- Studio Wear Grid -->
      <div class="asmaan-wear-grid mb-16">
        <!-- Item 1 -->
        <div class="asmaan-wear-card group">
          <div class="asmaan-wear-img-wrap">
            <span class="asmaan-wear-badge">{{ section.settings.item1_badge | default: 'DROP 01' }}</span>
            <div class="text-center p-6">
              <svg class="h-20 w-20 mx-auto text-white/40 group-hover:text-white transition-colors duration-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z" />
              </svg>
            </div>
          </div>
          <div class="flex items-center justify-between mb-1">
            <h3 class="font-bold text-base uppercase tracking-tight text-white">{{ section.settings.item1_title | default: 'Studio Heavyweight Tee' }}</h3>
            <span class="font-mono text-sm text-white/80">{{ section.settings.item1_price | default: '₹2,499' }}</span>
          </div>
          <p class="text-xs text-white/50 mb-4">{{ section.settings.item1_desc | default: '300 GSM combed loopback cotton, relaxed drop-shoulder cut, tonal insignia print.' }}</p>
          <a href="#newsletter" class="button is-hero is-secondary is-full text-center text-xs py-2 mt-auto">
            {{ section.settings.item_cta | default: 'Join Drop Waitlist' }}
          </a>
        </div>

        <!-- Item 2 -->
        <div class="asmaan-wear-card group">
          <div class="asmaan-wear-img-wrap">
            <span class="asmaan-wear-badge">{{ section.settings.item2_badge | default: 'DROP 01' }}</span>
            <div class="text-center p-6">
              <svg class="h-20 w-20 mx-auto text-white/40 group-hover:text-white transition-colors duration-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M12 4v16m8-8H4" />
              </svg>
            </div>
          </div>
          <div class="flex items-center justify-between mb-1">
            <h3 class="font-bold text-base uppercase tracking-tight text-white">{{ section.settings.item2_title | default: 'Creative Flow Hoodie' }}</h3>
            <span class="font-mono text-sm text-white/80">{{ section.settings.item2_price | default: '₹4,999' }}</span>
          </div>
          <p class="text-xs text-white/50 mb-4">{{ section.settings.item2_desc | default: '480 GSM dense French terry, double-layered architectural hood, hidden tech pocket.' }}</p>
          <a href="#newsletter" class="button is-hero is-secondary is-full text-center text-xs py-2 mt-auto">
            {{ section.settings.item_cta | default: 'Join Drop Waitlist' }}
          </a>
        </div>

        <!-- Item 3 -->
        <div class="asmaan-wear-card group">
          <div class="asmaan-wear-img-wrap">
            <span class="asmaan-wear-badge">{{ section.settings.item3_badge | default: 'DROP 01' }}</span>
            <div class="text-center p-6">
              <svg class="h-20 w-20 mx-auto text-white/40 group-hover:text-white transition-colors duration-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4" />
              </svg>
            </div>
          </div>
          <div class="flex items-center justify-between mb-1">
            <h3 class="font-bold text-base uppercase tracking-tight text-white">{{ section.settings.item3_title | default: 'Matte Field Cap' }}</h3>
            <span class="font-mono text-sm text-white/80">{{ section.settings.item3_price | default: '₹1,899' }}</span>
          </div>
          <p class="text-xs text-white/50 mb-4">{{ section.settings.item3_desc | default: 'Weatherproof matte nylon, FIDLOCK magnetic buckle, anti-sweat internal headband.' }}</p>
          <a href="#newsletter" class="button is-hero is-secondary is-full text-center text-xs py-2 mt-auto">
            {{ section.settings.item_cta | default: 'Join Drop Waitlist' }}
          </a>
        </div>

        <!-- Item 4 -->
        <div class="asmaan-wear-card group">
          <div class="asmaan-wear-img-wrap">
            <span class="asmaan-wear-badge">{{ section.settings.item4_badge | default: 'DROP 01' }}</span>
            <div class="text-center p-6">
              <svg class="h-20 w-20 mx-auto text-white/40 group-hover:text-white transition-colors duration-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" />
              </svg>
            </div>
          </div>
          <div class="flex items-center justify-between mb-1">
            <h3 class="font-bold text-base uppercase tracking-tight text-white">{{ section.settings.item4_title | default: 'Studio Aluminum Tote' }}</h3>
            <span class="font-mono text-sm text-white/80">{{ section.settings.item4_price | default: '₹1,499' }}</span>
          </div>
          <p class="text-xs text-white/50 mb-4">{{ section.settings.item4_desc | default: 'Reinforced 24oz waxed canvas with custom anodized aluminum hardware clip.' }}</p>
          <a href="#newsletter" class="button is-hero is-secondary is-full text-center text-xs py-2 mt-auto">
            {{ section.settings.item_cta | default: 'Join Drop Waitlist' }}
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

