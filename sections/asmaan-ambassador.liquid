{{ 'asmaan-ambassador.css' | asset_url | stylesheet_tag }}
<script src="{{ 'asmaan-ambassador.js' | asset_url }}" defer></script>

<div class="ambassador_page">
  <div class="ambassador_ambient-glow" aria-hidden="true"></div>

  <div class="ambassador_container">
    {%- comment -%} 1. HERO SECTION {%- endcomment -%}
    <section class="ambassador_hero">
      {%- if section.settings.hero_kicker != blank -%}
        <div class="ambassador_kicker">
          <span>{{ section.settings.hero_kicker }}</span>
        </div>
      {%- endif -%}

      <h1>{{ section.settings.hero_title | default: 'Become an Asmaan Ambassador' }}</h1>

      <div class="ambassador_hero-sub">
        <p>
          {{ section.settings.hero_subtext | default: 'The Asmaan Ambassador Program is a <strong>hand-selected circle</strong> of creators, athletes, and visionaries fueled by relentless ambition. <strong>Apply to join.</strong>' }}
        </p>
      </div>

      {%- if section.settings.enable_reveal_form -%}
        <button type="button" class="ambassador_btn" data-ambassador-open-form>
          <span>{{ section.settings.cta_text | default: 'Apply Now' }}</span>
          <svg class="ambassador_btn-icon" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M6 3L11 8L6 13" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </button>
      {%- else -%}
        <a href="{{ section.settings.cta_url | default: '#ambassador-form' }}" class="ambassador_btn">
          <span>{{ section.settings.cta_text | default: 'Apply Now' }}</span>
          <svg class="ambassador_btn-icon" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M6 3L11 8L6 13" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </a>
      {%- endif -%}
    </section>

    {%- comment -%} 2. SHOWCASE BUNDLE IMAGE {%- endcomment -%}
    <div class="ambassador_showcase">
      <div class="ambassador_showcase-inner">
        {%- if section.settings.showcase_image != blank -%}
          {{ section.settings.showcase_image | image_url: width: 1400 | image_tag: loading: 'lazy', alt: section.settings.hero_title }}
        {%- else -%}
          <div class="ambassador_fallback-bundle">
            <div class="ambassador_fallback-item is-can">
              <img src="{{ 'asmaan-can-jamun.webp' | asset_url }}" alt="Asmaan Jamun" loading="lazy">
            </div>
            <div class="ambassador_fallback-item is-hoodie">
              <img src="{{ 'hoodie-front.webp' | asset_url }}" alt="Asmaan Ambition Hoodie" loading="lazy">
            </div>
            <div class="ambassador_fallback-item is-can">
              <img src="{{ 'asmaan-can-magenta.webp' | asset_url }}" alt="Asmaan Magenta" loading="lazy">
            </div>
          </div>
        {%- endif -%}
      </div>
    </div>

    {%- comment -%} 3. HOW IT WORKS SECTION {%- endcomment -%}
    <section class="ambassador_how">
      <h2>{{ section.settings.steps_title | default: 'How It Works' }}</h2>

      <div class="ambassador_steps">
        <div class="ambassador_step">
          <div class="ambassador_step-num">{{ section.settings.step1_num | default: '01' }}</div>
          <h3>{{ section.settings.step1_title | default: 'Apply' }}</h3>
          <p>{{ section.settings.step1_desc | default: 'Complete your creator application and hear back from our team within 48 hours.' }}</p>
        </div>

        <div class="ambassador_step">
          <div class="ambassador_step-num">{{ section.settings.step2_num | default: '02' }}</div>
          <h3>{{ section.settings.step2_title | default: 'Get Your Kit' }}</h3>
          <p>{{ section.settings.step2_desc | default: 'Receive an exclusive Asmaan tonic allocation, limited capsule merch, and your personal tracking code.' }}</p>
        </div>

        <div class="ambassador_step">
          <div class="ambassador_step-num">{{ section.settings.step3_num | default: '03' }}</div>
          <h3>{{ section.settings.step3_title | default: 'Fuel The Culture' }}</h3>
          <p>{{ section.settings.step3_desc | default: 'Share your routine and ambition across your socials to earn competitive commissions and tier rewards.' }}</p>
        </div>
      </div>

      {%- if section.settings.enable_reveal_form -%}
        <button type="button" class="ambassador_btn" data-ambassador-open-form>
          <span>{{ section.settings.cta_text | default: 'Apply Now' }}</span>
          <svg class="ambassador_btn-icon" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M6 3L11 8L6 13" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </button>
      {%- else -%}
        <a href="{{ section.settings.cta_url | default: '#ambassador-form' }}" class="ambassador_btn">
          <span>{{ section.settings.cta_text | default: 'Apply Now' }}</span>
          <svg class="ambassador_btn-icon" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M6 3L11 8L6 13" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </a>
      {%- endif -%}
    </section>

    {%- comment -%} 4. AMBASSADOR PERKS MATRIX {%- endcomment -%}
    {%- if section.settings.show_perks -%}
      <section class="ambassador_perks">
        <h2>{{ section.settings.perks_title | default: 'Ambassador Perks' }}</h2>
        <div class="ambassador_perks-grid">
          <div class="ambassador_perk-card">
            <svg class="ambassador_perk-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            <div class="ambassador_perk-title">Competitive Commission</div>
            <p class="ambassador_perk-desc">Earn generous revenue share on every single purchase made with your personal creator code or tracking link.</p>
          </div>

          <div class="ambassador_perk-card">
            <svg class="ambassador_perk-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4" />
            </svg>
            <div class="ambassador_perk-title">Monthly Cans & Merch</div>
            <p class="ambassador_perk-desc">Complimentary monthly allocations of Asmaan Ambition Tonic and first access to limited-edition apparel capsules.</p>
          </div>

          <div class="ambassador_perk-card">
            <svg class="ambassador_perk-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d="M13 10V3L4 14h7v7l9-11h-7z" />
            </svg>
            <div class="ambassador_perk-title">Audience Discounts</div>
            <p class="ambassador_perk-desc">Offer your community an exclusive 15% discount code to experience clean cognitive botanical energy.</p>
          </div>

          <div class="ambassador_perk-card">
            <svg class="ambassador_perk-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z" />
            </svg>
            <div class="ambassador_perk-title">Creator Spotlight</div>
            <p class="ambassador_perk-desc">Get featured across Asmaan digital campaigns, editorial lookbooks, and private brand gatherings.</p>
          </div>
        </div>
      </section>
    {%- endif -%}

    {%- comment -%} 5. INTEGRATED EXPANDABLE REVEAL FORM {%- endcomment -%}
    <section id="ambassador-form-section" class="ambassador_form-section">
      <div class="ambassador_form-card">
        <div class="ambassador_form-header">
          <h3>{{ section.settings.form_title | default: 'Ambassador Application' }}</h3>
          <p>{{ section.settings.form_subtitle | default: 'Join the Ambition Collective. Tell us about your craft and where to send your creator package.' }}</p>
        </div>

        {% form 'contact', id: 'ambassador-form', class: 'ambassador_form', data-google-sheet-url: section.settings.google_sheet_url %}
          <input type="hidden" name="contact[tags]" value="ambassador_applicant,ambition_collective">
          <input type="hidden" name="contact[subject]" value="New Ambassador Application">

          <div class="ambassador_form-grid">
            <div class="ambassador_form-group">
              <label for="AmbassadorName" class="ambassador_label">Full Name *</label>
              <input type="text" name="contact[name]" id="AmbassadorName" class="ambassador_input" placeholder="e.g. Alex Rivera" required>
            </div>

            <div class="ambassador_form-group">
              <label for="AmbassadorEmail" class="ambassador_label">Email Address *</label>
              <input type="email" name="contact[email]" id="AmbassadorEmail" class="ambassador_input" placeholder="alex@domain.com" required>
            </div>

            <div class="ambassador_form-group">
              <label for="AmbassadorPhone" class="ambassador_label">Phone / WhatsApp</label>
              <input type="tel" name="contact[phone]" id="AmbassadorPhone" class="ambassador_input" placeholder="+1 (555) 000-0000">
            </div>

            <div class="ambassador_form-group">
              <label for="AmbassadorInstagram" class="ambassador_label">Instagram Handle *</label>
              <input type="text" name="contact[instagram]" id="AmbassadorInstagram" class="ambassador_input" placeholder="@yourhandle" required>
            </div>

            <div class="ambassador_form-group">
              <label for="AmbassadorTikTok" class="ambassador_label">TikTok or YouTube URL</label>
              <input type="text" name="contact[tiktok_youtube]" id="AmbassadorTikTok" class="ambassador_input" placeholder="@handle or channel link">
            </div>

            <div class="ambassador_form-group">
              <label for="AmbassadorAudience" class="ambassador_label">Audience Size *</label>
              <select name="contact[audience_size]" id="AmbassadorAudience" class="ambassador_select" required>
                <option value="" disabled selected>Select follower range</option>
                <option value="Under 5,000">Under 5,000</option>
                <option value="5,000 - 25,000">5,000 - 25,000</option>
                <option value="25,000 - 100,000">25,000 - 100,000</option>
                <option value="100,000+">100,000+</option>
              </select>
            </div>

            <div class="ambassador_form-group is-full">
              <label for="AmbassadorNiche" class="ambassador_label">Primary Content Focus *</label>
              <select name="contact[niche]" id="AmbassadorNiche" class="ambassador_select" required>
                <option value="" disabled selected>Select primary focus</option>
                <option value="Fitness, Athletics & Training">Fitness, Athletics & Training</option>
                <option value="Software, Tech & Startups">Software, Tech & Startups</option>
                <option value="Design, Architecture & Creative Arts">Design, Architecture & Creative Arts</option>
                <option value="Streetwear, Fashion & Aesthetics">Streetwear, Fashion & Aesthetics</option>
                <option value="Gaming & Digital Creation">Gaming & Digital Creation</option>
                <option value="Daily Routine & Productivity">Daily Routine & Productivity</option>
              </select>
            </div>

            <div class="ambassador_form-group is-full">
              <label for="AmbassadorMessage" class="ambassador_label">Why Asmaan? What drives your ambition?</label>
              <textarea name="contact[body]" id="AmbassadorMessage" class="ambassador_textarea" placeholder="Tell us about your routine, your goals, or why you want to represent Asmaan..."></textarea>
            </div>

            <div class="ambassador_form-submit-wrap">
              <button type="submit" id="ambassador-submit-btn" class="ambassador_submit-btn">
                <span class="ambassador_spinner"></span>
                <span class="ambassador_submit-text">Submit Application</span>
              </button>
            </div>
          </div>

          <div id="ambassador-success" class="ambassador_success-box">
            <div class="ambassador_success-title">Application Submitted</div>
            <p class="ambassador_success-desc">Thank you for applying to the Asmaan Ambition Collective. Our team reviews creator applications and will get in touch via email or Instagram within 48 hours.</p>
          </div>
        {% endform %}
      </div>
    </section>

    {%- comment -%} 6. FREQUENTLY ASKED QUESTIONS {%- endcomment -%}
    {%- if section.settings.show_faq -%}
      <section class="ambassador_faq">
        <h2>{{ section.settings.faq_title | default: 'Frequently Asked Questions' }}</h2>

        <div class="ambassador_faq-list">
          {%- if section.blocks.size > 0 -%}
            {%- for block in section.blocks -%}
              {%- if block.type == 'faq_item' -%}
                <div class="ambassador_faq-item" {{ block.shopify_attributes }}>
                  <button type="button" class="ambassador_faq-q" aria-expanded="false">
                    <span>{{ block.settings.question }}</span>
                    <svg class="ambassador_faq-icon" viewBox="0 0 16 16" fill="none" stroke="currentColor">
                      <path d="M8 3V13M3 8H13" stroke-width="2" stroke-linecap="round"/>
                    </svg>
                  </button>
                  <div class="ambassador_faq-a">
                    <div class="ambassador_faq-a-inner">
                      {{ block.settings.answer }}
                    </div>
                  </div>
                </div>
              {%- endif -%}
            {%- endfor -%}
          {%- else -%}
            <div class="ambassador_faq-item">
              <button type="button" class="ambassador_faq-q" aria-expanded="false">
                <span>Who qualifies for the Asmaan Ambassador Program?</span>
                <svg class="ambassador_faq-icon" viewBox="0 0 16 16" fill="none" stroke="currentColor">
                  <path d="M8 3V13M3 8H13" stroke-width="2" stroke-linecap="round"/>
                </svg>
              </button>
              <div class="ambassador_faq-a">
                <div class="ambassador_faq-a-inner">
                  We look for dedicated creators, athletes, designers, founders, and students who have an active digital voice and genuinely align with clean cognitive performance and thoughtful aesthetics. Quality of content and engagement matter more than raw follower numbers.
                </div>
              </div>
            </div>

            <div class="ambassador_faq-item">
              <button type="button" class="ambassador_faq-q" aria-expanded="false">
                <span>How and when do I get paid?</span>
                <svg class="ambassador_faq-icon" viewBox="0 0 16 16" fill="none" stroke="currentColor">
                  <path d="M8 3V13M3 8H13" stroke-width="2" stroke-linecap="round"/>
                </svg>
              </button>
              <div class="ambassador_faq-a">
                <div class="ambassador_faq-a-inner">
                  Commissions are tracked in real-time via your custom affiliate link or discount code. Payouts are distributed monthly via direct bank transfer or PayPal.
                </div>
              </div>
            </div>

            <div class="ambassador_faq-item">
              <button type="button" class="ambassador_faq-q" aria-expanded="false">
                <span>What is included in the creator welcome package?</span>
                <svg class="ambassador_faq-icon" viewBox="0 0 16 16" fill="none" stroke="currentColor">
                  <path d="M8 3V13M3 8H13" stroke-width="2" stroke-linecap="round"/>
                </svg>
              </button>
              <div class="ambassador_faq-a">
                <div class="ambassador_faq-a-inner">
                  Accepted ambassadors receive a complimentary shipment of Asmaan Ambition Tonic cases, custom merchandise from our active capsule, and personalized creator promotional collateral.
                </div>
              </div>
            </div>

            <div class="ambassador_faq-item">
              <button type="button" class="ambassador_faq-q" aria-expanded="false">
                <span>What are my commitments as an ambassador?</span>
                <svg class="ambassador_faq-icon" viewBox="0 0 16 16" fill="none" stroke="currentColor">
                  <path d="M8 3V13M3 8H13" stroke-width="2" stroke-linecap="round"/>
                </svg>
              </button>
              <div class="ambassador_faq-a">
                <div class="ambassador_faq-a-inner">
                  We ask for 1 to 2 authentic posts, reels, or stories per month featuring Asmaan in your real routine (working, training, designing, or studying), along with sharing your community discount code.
                </div>
              </div>
            </div>
          {%- endif -%}
        </div>
      </section>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Ambassador Page",
  "settings": [
    {
      "type": "header",
      "content": "Hero Section"
    },
    {
      "type": "text",
      "id": "hero_kicker",
      "label": "Hero Kicker",
      "default": "Creator Program / Ambition Collective"
    },
    {
      "type": "text",
      "id": "hero_title",
      "label": "Hero Title",
      "default": "Become an Asmaan Ambassador"
    },
    {
      "type": "textarea",
      "id": "hero_subtext",
      "label": "Hero Subtext",
      "default": "The Asmaan Ambassador Program is a hand-selected circle of creators, athletes, and visionaries fueled by relentless ambition. Apply to join."
    },
    {
      "type": "text",
      "id": "cta_text",
      "label": "CTA Button Text",
      "default": "Apply Now"
    },
    {
      "type": "checkbox",
      "id": "enable_reveal_form",
      "label": "Reveal Integrated Form on Click",
      "default": true,
      "info": "When enabled, clicking Apply Now expands the embedded form. When disabled, links to CTA URL."
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "External CTA URL",
      "info": "Used if 'Reveal Integrated Form on Click' is disabled"
    },
    {
      "type": "header",
      "content": "Showcase Banner"
    },
    {
      "type": "image_picker",
      "id": "showcase_image",
      "label": "Custom Showcase Banner Image",
      "info": "Upload a bundle image. If left blank, Asmaan's 3D cans and capsule hoodie will render automatically."
    },
    {
      "type": "header",
      "content": "How It Works"
    },
    {
      "type": "text",
      "id": "steps_title",
      "label": "Steps Section Title",
      "default": "How It Works"
    },
    {
      "type": "text",
      "id": "step1_num",
      "label": "Step 1 Number",
      "default": "01"
    },
    {
      "type": "text",
      "id": "step1_title",
      "label": "Step 1 Title",
      "default": "Apply"
    },
    {
      "type": "textarea",
      "id": "step1_desc",
      "label": "Step 1 Description",
      "default": "Complete your creator application and hear back from our team within 48 hours."
    },
    {
      "type": "text",
      "id": "step2_num",
      "label": "Step 2 Number",
      "default": "02"
    },
    {
      "type": "text",
      "id": "step2_title",
      "label": "Step 2 Title",
      "default": "Get Your Kit"
    },
    {
      "type": "textarea",
      "id": "step2_desc",
      "label": "Step 2 Description",
      "default": "Receive an exclusive Asmaan tonic allocation, limited capsule merch, and your personal tracking code."
    },
    {
      "type": "text",
      "id": "step3_num",
      "label": "Step 3 Number",
      "default": "03"
    },
    {
      "type": "text",
      "id": "step3_title",
      "label": "Step 3 Title",
      "default": "Fuel The Culture"
    },
    {
      "type": "textarea",
      "id": "step3_desc",
      "label": "Step 3 Description",
      "default": "Share your routine and ambition across your socials to earn competitive commissions and tier rewards."
    },
    {
      "type": "header",
      "content": "Google Sheets Database Integration"
    },
    {
      "type": "text",
      "id": "google_sheet_url",
      "label": "Google Apps Script Webhook URL",
      "placeholder": "https://script.google.com/macros/s/.../exec",
      "info": "Paste your Google Apps Script Web App URL here to store all submitted applications in your Google Sheet automatically."
    },
    {
      "type": "header",
      "content": "Application Form Texts"
    },
    {
      "type": "text",
      "id": "form_title",
      "label": "Form Title",
      "default": "Ambassador Application"
    },
    {
      "type": "textarea",
      "id": "form_subtitle",
      "label": "Form Subtitle",
      "default": "Join the Ambition Collective. Tell us about your craft and where to send your creator package."
    },
    {
      "type": "header",
      "content": "Perks Section"
    },
    {
      "type": "checkbox",
      "id": "show_perks",
      "label": "Show Perks Section",
      "default": true
    },
    {
      "type": "text",
      "id": "perks_title",
      "label": "Perks Title",
      "default": "Ambassador Perks"
    },
    {
      "type": "header",
      "content": "FAQ Section"
    },
    {
      "type": "checkbox",
      "id": "show_faq",
      "label": "Show FAQ Section",
      "default": true
    },
    {
      "type": "text",
      "id": "faq_title",
      "label": "FAQ Title",
      "default": "Frequently Asked Questions"
    }
  ],
  "blocks": [
    {
      "type": "faq_item",
      "name": "FAQ Item",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Question",
          "default": "How does the ambassador program work?"
        },
        {
          "type": "textarea",
          "id": "answer",
          "label": "Answer",
          "default": "As an ambassador, you receive free monthly product allocations and earn commission on every order placed using your creator link."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Ambassador Page"
    }
  ]
}
{% endschema %}
