<section class="asmaan-subpage-section pt-24 pb-20">
  <div class="padding-global">
    <div class="container-large max-w-4xl mx-auto px-4">
      <div class="asmaan-subpage-hero mb-8 text-left">
        <span class="font-mono text-xs uppercase tracking-[0.25em] text-[#9089D3] block mb-2">Checkout Pipeline</span>
        <h1 class="text-3xl sm:text-5xl font-black uppercase tracking-tight text-white mb-2">Shopping Cart</h1>
      </div>

      {%- if cart.item_count > 0 -%}
        <form action="/cart" method="post" class="p-6 sm:p-8 rounded-3xl bg-white/[0.02] border border-white/10">
          <!-- Free shipping bar -->
          <div class="p-4 rounded-xl bg-white/[0.03] border border-white/10 mb-6 flex items-center justify-between text-xs font-mono">
            {%- assign threshold = 99900 -%}
            {%- if cart.total_price >= threshold -%}
              <span class="text-emerald-400 font-bold">&check; You have unlocked Free Nationwide Shipping!</span>
              <span class="text-white/60">Dispatched in Insulated Box</span>
            {%- else -%}
              {%- assign remaining = threshold | minus: cart.total_price -%}
              <span class="text-white/80">Add <strong class="text-white">{{ remaining | money }}</strong> more to unlock Free Shipping!</span>
              <a href="/collections/all" class="text-emerald-400 underline">Add Cans</a>
            {%- endif -%}
          </div>

          <div class="divide-y divide-white/10 mb-8">
            {%- for item in cart.items -%}
              <div class="py-6 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
                <div class="flex items-center gap-4">
                  {%- if item.image -%}
                    <img src="{{ item.image | image_url: width: 140 }}" alt="{{ item.title | escape }}" class="h-20 w-auto object-contain rounded-xl bg-white/[0.02] p-2 border border-white/10">
                  {%- else -%}
                    <img src="{{ 'can-asmaan.png' | asset_url }}" alt="{{ item.title | escape }}" class="h-20 w-auto object-contain rounded-xl bg-white/[0.02] p-2 border border-white/10">
                  {%- endif -%}
                  <div>
                    <h3 class="font-bold text-white text-base">{{ item.product.title }}</h3>
                    {%- unless item.product.has_only_default_variant -%}
                      <p class="text-white/50 text-xs mt-0.5 font-mono">{{ item.variant.title }}</p>
                    {%- endunless -%}
                    <a href="/cart/change?line={{ forloop.index }}&quantity=0" class="text-xs text-rose-400/80 hover:text-rose-400 font-mono mt-2 inline-block">
                      &times; Remove
                    </a>
                  </div>
                </div>

                <div class="flex items-center justify-between sm:justify-end gap-6">
                  <div class="flex items-center rounded-lg bg-white/[0.06] border border-white/15 px-2 py-1">
                    <input
                      type="number"
                      name="updates[]"
                      value="{{ item.quantity }}"
                      min="0"
                      class="w-12 text-center font-mono text-white bg-transparent border-none focus:outline-none text-xs"
                      aria-label="Quantity for {{ item.title | escape }}"
                    >
                  </div>
                  <div class="font-mono text-white text-right font-bold text-base min-w-[5rem]">
                    {{ item.final_line_price | money }}
                  </div>
                </div>
              </div>
            {%- endfor -%}
          </div>

          <div class="pt-6 border-t border-white/10 flex flex-col sm:flex-row items-center justify-between gap-6">
            <div class="flex gap-3">
              <button type="submit" name="update" class="button is-secondary is-small !text-xs">
                Update Quantities
              </button>
              <a href="/collections/all" class="button is-secondary is-small !text-xs">
                Continue Shopping
              </a>
            </div>
            <div class="text-right flex flex-col sm:flex-row items-center gap-4">
              <span class="font-mono text-lg text-white">Total: <strong>{{ cart.total_price | money }}</strong></span>
              <button type="submit" name="checkout" class="button is-hero is-primary">
                Proceed to Checkout
              </button>
            </div>
          </div>
        </form>
      {%- else -%}
        <div class="p-16 text-center rounded-3xl bg-white/[0.02] border border-white/10 max-w-lg mx-auto">
          <div class="h-16 w-16 mx-auto mb-6 rounded-full bg-white/[0.04] border border-white/10 flex items-center justify-center">
            <svg class="h-7 w-7 text-white/50" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z" />
            </svg>
          </div>
          <h2 class="text-xl font-bold uppercase text-white mb-2">Your Cart Is Empty</h2>
          <p class="text-white/60 mb-8 text-sm leading-relaxed">Ready to experience elevated focus? Select a flagship 12-pack sampler or choose individual flavors.</p>
          <a href="/collections/all" class="button is-hero is-primary">
            Explore The Shop
          </a>
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

{% section 'asmaan-newsletter' %}

{% schema %}
{
  "name": "Cart",
  "settings": []
}
{% endschema %}
