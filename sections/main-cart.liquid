<section class="section relative bg-black text-white min-h-[70vh] py-16">
  <div class="padding-global">
    <div class="container-large max-w-4xl mx-auto px-4">
      <h1 class="text-3xl sm:text-5xl font-bold tracking-tight mb-8">Your cart</h1>
      {%- if cart.item_count > 0 -%}
        <form action="/cart" method="post">
          <div class="divide-y divide-white/10 mb-8">
            {%- for item in cart.items -%}
              <div class="py-6 flex items-center justify-between">
                <div>
                  <h3 class="font-bold">{{ item.product.title }}</h3>
                  <p class="text-white/60 text-sm">{{ item.variant.title }} &times; {{ item.quantity }}</p>
                </div>
                <div class="font-mono">{{ item.final_line_price | money }}</div>
              </div>
            {%- endfor -%}
          </div>
          <div class="text-right">
            <p class="text-xl mb-4 font-mono">Subtotal: {{ cart.total_price | money }}</p>
            <button type="submit" name="checkout" class="button">Checkout</button>
          </div>
        </form>
      {%- else -%}
        <p class="text-white/70 mb-8">Your cart is currently empty.</p>
        <a href="/" class="button">Continue shopping</a>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Cart",
  "settings": []
}
{% endschema %}
