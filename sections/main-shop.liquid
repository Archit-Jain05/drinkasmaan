{%- assign free_shipping_money = settings.free_shipping_threshold | money_without_trailing_zeros -%}
<section class="asmaan-subpage-section pt-24 pb-20">
  <div class="padding-global">
    <div class="container-large max-w-6xl mx-auto px-4">
      <div class="asmaan-subpage-hero text-center mb-12">
        <span class="font-mono text-xs uppercase tracking-[0.25em] text-[#9089D3] block mb-2">{{ section.settings.kicker | default: 'Direct Allocation • Founders Run' }}</span>
        <h1 class="text-4xl sm:text-6xl font-black uppercase tracking-tight text-white mb-4">{{ section.settings.title | default: 'Complete Shop' }}</h1>
        <p class="max-w-xl mx-auto text-white/70 text-sm leading-relaxed">
          {{ section.settings.subtitle | default: 'Elevated botanical tonics formulated with raw green coffee bean caffeine, L-theanine, and KSM-66 ashwagandha. Zero sugar. Zero jitters.' }}
        </p>
      </div>

      <!-- Shop Category Filter Tabs -->
      <div class="flex items-center justify-center gap-2 mb-12 flex-wrap" data-shop-filters>
        <button type="button" class="shop-filter-btn is-active" data-filter="all">All Products</button>
        <button type="button" class="shop-filter-btn" data-filter="tonic">Ambition Tonics</button>
        <button type="button" class="shop-filter-btn" data-filter="wear">Studio Wear</button>
      </div>

      <!-- Products Grid -->
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 sm:gap-8 mb-16" id="shop-catalog-grid">
        {%- assign shop_collection = section.settings.collection | default: collections.all -%}
        {%- if shop_collection != blank and shop_collection.products.size > 0 -%}
          {%- for product in shop_collection.products -%}
            {%- liquid
              assign p_cat = 'tonic'
              assign p_type = product.type | downcase
              assign p_tags = product.tags | join: ' ' | downcase
              if p_type contains 'wear' or p_type contains 'apparel' or p_tags contains 'wear' or p_tags contains 'apparel'
                assign p_cat = 'wear'
              endif
            -%}
            <div class="shop-product-card group" data-category="{{ p_cat }}">
              {%- if product.metafields.custom.badge != blank -%}
                <div class="shop-card-badge">{{ product.metafields.custom.badge }}</div>
              {%- elsif p_cat == 'wear' -%}
                <div class="shop-card-badge">Studio Wear</div>
              {%- else -%}
                <div class="shop-card-badge">Ambition Tonic</div>
              {%- endif -%}

              <div class="shop-card-image-wrap">
                {%- if product.featured_media != blank -%}
                  <img src="{{ product.featured_media | image_url: width: 500 }}" width="{{ product.featured_media.preview_image.width }}" height="{{ product.featured_media.preview_image.height }}" alt="{{ product.title | escape }}" class="shop-card-img" loading="lazy">
                {%- elsif product.featured_image != blank -%}
                  <img src="{{ product.featured_image | image_url: width: 500 }}" width="{{ product.featured_image.width }}" height="{{ product.featured_image.height }}" alt="{{ product.title | escape }}" class="shop-card-img" loading="lazy">
                {%- endif -%}
              </div>

              <div class="shop-card-details">
                <span class="shop-card-tag">{{ product.metafields.custom.tagline | default: product.type | default: 'Asmaan Formulation' }}</span>
                <h3 class="shop-card-title">{{ product.title }}</h3>
                <p class="shop-card-desc">{{ product.description | strip_html | truncate: 90 }}</p>
                <div class="shop-card-meta">
                  <div class="shop-card-price">{{ product.price | money }}</div>
                  {%- if product.available -%}
                    <span class="shop-card-spec text-emerald-400">In Stock</span>
                  {%- else -%}
                    <span class="shop-card-spec text-rose-400">Sold Out</span>
                  {%- endif -%}
                </div>
                <div class="mt-4 flex gap-2">
                  <a href="{{ product.url }}" class="button is-small is-secondary flex-1 !text-xs">Details</a>
                  {%- if product.available -%}
                    <form action="/cart/add" method="post" class="flex-1">
                      <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
                      <button type="submit" class="button is-small is-primary w-full !text-xs">Add to Cart</button>
                    </form>
                  {%- endif -%}
                </div>
              </div>
            </div>
          {%- endfor -%}
        {%- else -%}
          <div class="col-span-full py-16 text-center">
            <p class="text-white/60 font-mono text-sm">No products found in this store.</p>
            <a href="/" class="button is-small is-secondary mt-4 inline-block">Return to Home</a>
          </div>
        {%- endif -%}
      </div>

      <!-- Free Shipping Banner -->
      <div class="p-6 sm:p-8 rounded-2xl bg-white/[0.03] border border-white/10 flex flex-col sm:flex-row items-center justify-between gap-6 text-center sm:text-left">
        <div>
          <span class="font-mono text-xs uppercase tracking-widest text-emerald-400 block mb-1">{{ section.settings.banner_kicker | default: 'Direct from Bengaluru Studio' }}</span>
          <h3 class="text-xl font-bold uppercase tracking-tight text-white">{{ section.settings.banner_heading | escape | replace: '[free_shipping_threshold]', free_shipping_money }}</h3>
          <p class="text-white/60 text-xs mt-1">{{ section.settings.banner_sub | default: 'Dispatched chilled in custom-insulated recyclable corrugated packs.' }}</p>
        </div>
        <a href="{{ section.settings.banner_cta_url | default: '/#range' }}" class="button is-primary is-small whitespace-nowrap">
          {{ section.settings.banner_cta_label | default: 'Order Cans' }}
        </a>
      </div>
    </div>
  </div>
</section>

<script>
  (function() {
    var filterBtns = document.querySelectorAll('[data-shop-filters] .shop-filter-btn');
    var cards = document.querySelectorAll('#shop-catalog-grid .shop-product-card');

    filterBtns.forEach(function(btn) {
      btn.addEventListener('click', function() {
        var filter = btn.getAttribute('data-filter');
        filterBtns.forEach(function(b) { b.classList.remove('is-active'); });
        btn.classList.add('is-active');

        cards.forEach(function(card) {
          var cat = card.getAttribute('data-category');
          if (filter === 'all' || cat === filter) {
            card.style.display = '';
          } else {
            card.style.display = 'none';
          }
        });
      });
    });
  })();
</script>

{% schema %}
{
  "name": "Shop Catalog",
  "tag": "section",
  "class": "section-main-shop",
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "Hero Kicker",
      "default": "Direct Allocation • Founders Run"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Hero Title",
      "default": "Complete Shop"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Hero Subtitle",
      "default": "Elevated botanical tonics formulated with raw green coffee bean caffeine, L-theanine, and KSM-66 ashwagandha. Zero sugar. Zero jitters."
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Shop Collection",
      "info": "Choose a collection to display in the shop grid (leave blank for all products)."
    },
    {
      "type": "header",
      "content": "Free Shipping Banner"
    },
    {
      "type": "text",
      "id": "banner_kicker",
      "label": "Banner Kicker",
      "default": "Direct from Bengaluru Studio"
    },
    {
      "type": "text",
      "id": "banner_heading",
      "label": "Banner Heading",
      "default": "Free Nationwide Shipping Over [free_shipping_threshold]"
    },
    {
      "type": "text",
      "id": "banner_sub",
      "label": "Banner Subtext",
      "default": "Dispatched chilled in custom-insulated recyclable corrugated packs."
    },
    {
      "type": "text",
      "id": "banner_cta_label",
      "label": "Banner CTA Label",
      "default": "Order Cans"
    },
    {
      "type": "url",
      "id": "banner_cta_url",
      "label": "Banner CTA Link"
    }
  ],
  "presets": [
    {
      "name": "Shop Catalog"
    }
  ]
}
{% endschema %}
