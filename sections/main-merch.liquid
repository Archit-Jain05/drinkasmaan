{{ 'asmaan-merch.css' | asset_url | stylesheet_tag }}

{%- comment -%}
  Merch capsule page. Each "Garment piece" block can point at a Shopify product; the product
  supplies title, price, description, sizes (from an option named Size) and front/back images
  (first and second product image). Every field can be overridden on the block. When neither a
  product image nor an uploaded image exists, the block's "theme asset" filename is used.
{%- endcomment -%}

{%- liquid
  assign piece_count = section.blocks.size
  assign total_label = piece_count | prepend: '0' | slice: -2, 2

  assign capsule_price = section.settings.price
  if capsule_price == blank
    for block in section.blocks
      if block.settings.product != blank
        assign capsule_price = block.settings.product.price | money_without_trailing_zeros
        break
      endif
    endfor
  endif

  assign capsule_sizes = section.settings.sizes
  assign shop_open = false
  for block in section.blocks
    if block.settings.product != blank and block.settings.product.available
      assign shop_open = true
    endif
  endfor
-%}

<div class="merch_wash" style="--wash: 0.55;" aria-hidden="true"></div>

<div class="merch_page-content">
  <section class="merch_hero" aria-label="{{ shop.name | escape }} — {{ section.settings.kicker | escape }}">
    <div class="merch_meta">
      <span>{{ section.settings.kicker | escape }}</span>
      <span aria-hidden="true">/</span>
      <span>{{ section.settings.tagline | escape }}</span>
    </div>

    <div class="merch_hero-stack">
      <div class="merch_hero-type" aria-hidden="true">
        <span>{{ section.settings.headline_line1 | escape }}</span>
        <span>{{ section.settings.headline_line2 | escape }}</span>
      </div>

      <div class="merch_hero-rail" data-merch-rail>
        {%- for block in section.blocks -%}
          {%- liquid
            assign p = block.settings.product
            assign piece_title = block.settings.line1 | append: ' ' | append: block.settings.line2 | strip
            if piece_title == blank
              assign piece_title = p.title
            endif
            assign front_img = block.settings.front_image | default: p.images[0]
          -%}
          <div
            class="merch_hero-piece"
            style="--h: {{ block.settings.hero_height }}; --tilt: {{ block.settings.hero_tilt }}; --lap: {{ block.settings.hero_lap }};"
            data-drift="{{ block.settings.hero_drift }}"
            {{ block.shopify_attributes }}
          >
            <span class="merch_glow" style="--glow: {{ block.settings.secondary_color }};" aria-hidden="true"></span>
            {%- if front_img != blank -%}
              {{ front_img | image_url: width: 1200 | image_tag: alt: piece_title, class: 'w-auto h-full object-contain', loading: 'lazy' }}
            {%- elsif block.settings.front_asset != blank -%}
              <img src="{{ block.settings.front_asset | asset_url }}" alt="{{ piece_title | escape }}" width="764" height="742" loading="lazy">
            {%- endif -%}
          </div>
        {%- endfor -%}
      </div>
    </div>

    <div class="merch_hero-row">
      <h1 class="sr-only">{{ shop.name | escape }} — {{ section.settings.kicker | escape }}</h1>
      <p class="max-width-medium text-size-medium text-white/70">{{ section.settings.sub | escape }}</p>

      <div class="merch_meta">
        <span><b>{{ piece_count }}</b> {{ section.settings.label_pieces | escape }}</span>
        {%- if capsule_price != blank %}
          <span aria-hidden="true">·</span>
          <span><b>{{ capsule_price }}</b> {{ section.settings.label_each | escape }}</span>
        {%- endif %}
        {%- if capsule_sizes != blank %}
          <span aria-hidden="true">·</span>
          <span>{{ capsule_sizes | escape }}</span>
        {%- endif %}
      </div>
    </div>
  </section>

  {%- if section.settings.marquee_items != blank -%}
    {%- assign marquee_items = section.settings.marquee_items | newline_to_br | split: '<br />' -%}
    <div class="merch_marquee" data-merch-marquee data-running="true" aria-label="{{ section.settings.kicker | escape }}">
      {%- for track in (1..2) -%}
        <div class="merch_marquee-track"{% if track == 2 %} aria-hidden="true"{% endif %}>
          {%- for item in marquee_items -%}
            {%- assign item_text = item | strip | escape | replace: '[kicker]', section.settings.kicker | replace: '[sizes]', capsule_sizes | replace: '[price]', capsule_price -%}
            {%- if item_text != blank -%}
              <span class="merch_marquee-item">{{ item_text }} {% render 'asmaan-icons', name: 'star', class: 'w-3 h-3' %}</span>
            {%- endif -%}
          {%- endfor -%}
        </div>
      {%- endfor -%}
    </div>
  {%- endif -%}

  {%- if piece_count > 0 -%}
    {%- assign hold_multiplier = piece_count | times: 1.9 | times: 100 -%}
    <div
      class="merch_run"
      style="height: {{ hold_multiplier }}svh; height: {{ hold_multiplier }}vh;"
      data-label-add="{{ section.settings.label_add | escape }}"
      data-label-pick="{{ section.settings.label_pick_size | escape }}"
      data-label-adding="{{ section.settings.label_adding | escape }}"
      data-label-added="{{ section.settings.label_added | escape }}"
      data-label-error="{{ section.settings.label_add_error | escape }}"
      data-cart-type="{{ settings.cart_type | default: 'drawer' | escape }}"
    >
      <div class="merch_run-sticky">
        {%- for block in section.blocks -%}
          {%- liquid
            assign p = block.settings.product
            assign line1 = block.settings.line1
            assign line2 = block.settings.line2
            if line1 == blank and p != blank
              assign words = p.title | split: ' '
              assign line1 = words.first
              assign line2 = p.title | remove_first: words.first | strip
            endif
            assign piece_title = line1 | append: ' ' | append: line2 | strip

            assign tag = block.settings.tag | default: p.metafields.custom.tagline.value
            assign blurb = block.settings.blurb
            if blurb == blank and p.description != blank
              assign blurb = p.description | strip_html | strip
            endif
            assign spec = block.settings.spec | default: p.metafields.custom.spec.value

            assign price = block.settings.price
            if price == blank and p != blank
              assign price = p.price | money_without_trailing_zeros
            endif
            if price == blank
              assign price = capsule_price
            endif

            assign sizes = ''
            for option in p.options_with_values
              assign option_name = option.name | downcase
              if option_name == 'size'
                assign sizes = option.values | join: '·'
              endif
            endfor
            if sizes == blank
              assign sizes = block.settings.sizes | default: capsule_sizes
            endif
            assign size_list = sizes | replace: ',', '·' | split: '·'

            assign front_img = block.settings.front_image | default: p.images[0]
            assign back_img = block.settings.back_image | default: p.images[1]
            assign default_num = forloop.index | prepend: '0' | slice: -2, 2

            assign can_buy = false
            if p != blank and p.available
              assign can_buy = true
            endif
            assign size_pos = -1
            for option in p.options_with_values
              assign option_name = option.name | downcase
              if option_name == 'size'
                assign size_pos = option.position | minus: 1
              endif
            endfor
          -%}
          <section
            class="merch_piece"
            data-primary="{{ block.settings.primary_color }}"
            data-secondary="{{ block.settings.secondary_color }}"
            aria-label="{{ piece_title | escape }}"
            {{ block.shopify_attributes }}
          >
            <div class="merch_piece-container">
              <div class="merch_col">
                <span class="merch_number">{{ block.settings.number | default: default_num }} / {{ total_label }}</span>
                <h2 class="heading-style-h2">{{ line1 | escape }}{% if line2 != blank %}<br>{{ line2 | escape }}{% endif %}</h2>
                {%- if tag != blank -%}<span class="merch_tag">{{ tag | escape }}</span>{%- endif -%}
                {%- if blurb != blank -%}<p class="max-width-custom text-white/65">{{ blurb | escape }}</p>{%- endif -%}
              </div>

              <div>
                <div
                  class="merch_stage"
                  style="--stage: {% if block.settings.is_tall %}70svh{% else %}56svh{% endif %}; --stage-small: {% if block.settings.is_tall %}44svh{% else %}36svh{% endif %};"
                >
                  <span class="merch_glow" style="--glow: {{ block.settings.secondary_color }};" aria-hidden="true"></span>

                  <button type="button" class="merch_turn" aria-label="{{ section.settings.label_turn | escape }} — {{ piece_title | escape }}">
                    <span class="merch_face">
                      {%- if front_img != blank -%}
                        {{ front_img | image_url: width: 1200 | image_tag: alt: piece_title, class: 'w-full h-full object-contain', loading: 'lazy' }}
                      {%- elsif block.settings.front_asset != blank -%}
                        <img src="{{ block.settings.front_asset | asset_url }}" alt="{{ piece_title | escape }}, {{ section.settings.label_front | escape }}" width="764" height="742" loading="lazy">
                      {%- endif -%}
                    </span>
                    <span class="merch_face is-back">
                      {%- if back_img != blank -%}
                        {{ back_img | image_url: width: 1200 | image_tag: alt: piece_title, class: 'w-full h-full object-contain', loading: 'lazy' }}
                      {%- elsif block.settings.back_asset != blank -%}
                        <img src="{{ block.settings.back_asset | asset_url }}" alt="{{ piece_title | escape }}, {{ section.settings.label_back | escape }}" width="764" height="742" loading="lazy">
                      {%- endif -%}
                    </span>
                  </button>

                  <span class="merch_shadow" aria-hidden="true"></span>
                </div>

                <div class="merch_faces">
                  <button type="button" class="merch_face-button" data-face="front" aria-pressed="true">{{ section.settings.label_front | escape }}</button>
                  <button type="button" class="merch_face-button" data-face="back" aria-pressed="false">{{ section.settings.label_back | escape }}</button>
                </div>
              </div>

              <div class="merch_col is-end">
                {%- if spec != blank -%}
                  {%- assign specs = spec | newline_to_br | split: '<br />' -%}
                  <ul class="merch_spec">
                    {%- for s in specs -%}
                      {%- assign s_clean = s | strip -%}
                      {%- if s_clean != blank -%}<li>{{ s_clean | escape }}</li>{%- endif -%}
                    {%- endfor -%}
                  </ul>
                {%- endif -%}

                {%- if price != blank -%}<span class="merch_price">{{ price }}</span>{%- endif -%}

                {%- if can_buy -%}
                  {%- comment -%} Sizes are the product's own variants, so a sold-out size can't be picked. {%- endcomment -%}
                  {%- if size_pos >= 0 -%}
                    <div class="merch_sizes" role="group" aria-label="{{ section.settings.label_sizes_group | escape }}">
                      {%- for v in p.variants -%}
                        <button
                          type="button"
                          class="merch_size"
                          aria-pressed="false"
                          data-variant-id="{{ v.id }}"
                          {% unless v.available %}disabled aria-label="{{ v.options[size_pos] | escape }} — {{ section.settings.label_sold_out | escape }}"{% endunless %}
                        >{{ v.options[size_pos] | escape }}</button>
                      {%- endfor -%}
                    </div>
                  {%- endif -%}

                  <button
                    type="button"
                    class="button is-small merch_add"
                    data-merch-add
                    data-needs-size="{% if size_pos >= 0 %}true{% else %}false{% endif %}"
                    {% if size_pos < 0 %}data-variant-id="{{ p.selected_or_first_available_variant.id }}"{% endif %}
                  >{{ section.settings.label_add | escape }}</button>
                  <p class="merch_status" role="status" aria-live="polite" hidden></p>
                {%- else -%}
                  {%- if size_list.size > 0 -%}
                    <div class="merch_sizes" role="group" aria-label="{{ section.settings.label_sizes_group | escape }}">
                      {%- for size in size_list -%}
                        {%- assign size_label = size | strip -%}
                        {%- if size_label != blank -%}
                          <button type="button" class="merch_size" aria-pressed="false">{{ size_label | escape }}</button>
                        {%- endif -%}
                      {%- endfor -%}
                    </div>
                  {%- endif -%}

                  {%- if p != blank -%}
                    <button type="button" class="button is-small merch_add" disabled>{{ section.settings.label_sold_out | escape }}</button>
                  {%- else -%}
                    <button type="button" class="button is-small" data-open-drop>{{ section.settings.cta_text | escape }}</button>
                  {%- endif -%}
                {%- endif -%}

                {%- if section.settings.fit != blank -%}
                  <p class="text-size-tiny max-width-xsmall text-white/40">{{ section.settings.fit | escape }}</p>
                {%- endif -%}
              </div>
            </div>
          </section>
        {%- endfor -%}

        <nav class="merch_nav" aria-label="{{ section.settings.kicker | escape }}">
          {%- for block in section.blocks -%}
            {%- liquid
              assign def_num = forloop.index | prepend: '0' | slice: -2, 2
              assign nav_title = block.settings.line1 | append: ' ' | append: block.settings.line2 | strip
              if nav_title == blank
                assign nav_title = block.settings.product.title
              endif
            -%}
            <button
              type="button"
              class="merch_nav-item{% if forloop.first %} is-active{% endif %}"
              {% if forloop.first %}aria-current="true"{% endif %}
            >
              {{ block.settings.number | default: def_num }}
              <span class="sr-only">{{ nav_title | escape }}</span>
            </button>
          {%- endfor -%}
        </nav>
      </div>
    </div>
  {%- elsif request.design_mode -%}
    <p class="text-white/65" style="padding: 4rem 1.5rem; text-align: center;">Add a “Garment piece” block to show the capsule.</p>
  {%- endif -%}

  <div class="merch_drop-wrapper">
    <section id="drop" class="merch_drop">
      <h2 class="heading-style-h3">{{ section.settings.drop_title | escape }}</h2>

      {%- if capsule_price != blank -%}<p class="merch_drop-price">{{ capsule_price }}</p>{%- endif -%}
      {%- if section.settings.price_note != blank -%}<p class="merch_meta">{{ section.settings.price_note | escape }}</p>{%- endif -%}

      {%- if shop_open -%}
        <button type="button" class="wear_cta pointer-events-on" data-merch-shop>
          {{ section.settings.shop_cta_text | escape }}
          {% render 'asmaan-icons', name: 'star', class: 'wear_cta-star' %}
        </button>
        {%- if section.settings.shop_body != blank -%}
          <p class="max-width-medium text-white/60">{{ section.settings.shop_body | escape }}</p>
        {%- endif -%}
      {%- else -%}
        <button type="button" class="wear_cta pointer-events-on" data-open-drop>
          {{ section.settings.cta_text | escape }}
          {% render 'asmaan-icons', name: 'star', class: 'wear_cta-star' %}
        </button>
        {%- if section.settings.drop_body != blank -%}
          <p class="max-width-medium text-white/60">{{ section.settings.drop_body | escape }}</p>
        {%- endif -%}
      {%- endif -%}

      <dl class="merch_strip">
        {%- if section.settings.fit != blank -%}
          <div>
            <dt>{{ section.settings.label_fit | escape }}</dt>
            <dd>{{ section.settings.fit | escape }}</dd>
          </div>
        {%- endif -%}
        {%- if capsule_sizes != blank -%}
          <div>
            <dt>{{ section.settings.label_sizes | escape }}</dt>
            <dd>{{ capsule_sizes | escape }}</dd>
          </div>
        {%- endif -%}
        {%- if section.settings.drop_line != blank and shop_open == false -%}
          <div>
            <dt>{{ section.settings.label_drop | escape }}</dt>
            <dd>{{ section.settings.drop_line | escape }}</dd>
          </div>
        {%- endif -%}
      </dl>
    </section>
  </div>
</div>

<div class="drop_modal" data-open="false" aria-hidden="true">
  <div class="drop_sheet" role="dialog" aria-modal="true" aria-labelledby="drop-title">
    <button type="button" class="drop_close" aria-label="{{ section.settings.label_close | escape }}">
      {% render 'asmaan-icons', name: 'cross', class: 'h-3 w-3' %}
    </button>

    <h2 id="drop-title" class="heading-style-h2">{{ section.settings.modal_title | escape }}</h2>
    {%- if section.settings.modal_body != blank -%}
      <p class="mt-[var(--pad-s)] text-white/70">{{ section.settings.modal_body | escape }}</p>
    {%- endif -%}

    {% form 'customer', class: 'mt-[var(--pad-l)] text-left', id: 'MerchDropForm' %}
      <input type="hidden" name="contact[tags]" value="{{ section.settings.waitlist_tags | escape }}">
      {%- if form.posted_successfully? -%}
        <p class="mt-[var(--pad-l)] text-size-medium text-emerald-400 font-mono text-center" role="status">{{ section.settings.modal_success | escape }}</p>
      {%- else -%}
        <div class="newsletter_field relative">
          <input
            id="drop-email"
            type="email"
            name="contact[email]"
            required
            autocomplete="email"
            placeholder=" "
            class="newsletter_input"
            value="{{ form.email }}"
          >
          <label for="drop-email" class="newsletter_label">{{ section.settings.modal_placeholder | escape }}</label>
        </div>

        {%- if form.errors -%}
          <p class="mt-[var(--pad-xxs)] text-size-small text-[#ff7676]" role="alert">{{ section.settings.modal_error | escape }}</p>
        {%- endif -%}

        <button type="submit" class="button is-full mt-[var(--pad-m)]">{{ section.settings.modal_cta | escape }}</button>
      {%- endif -%}
    {% endform %}
  </div>
</div>

<script src="{{ 'asmaan-merch.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Merchandise capsule",
  "tag": "div",
  "class": "section-main-merch",
  "settings": [
    { "type": "header", "content": "Hero" },
    { "type": "text", "id": "kicker", "label": "Capsule kicker", "default": "Capsule 01" },
    { "type": "text", "id": "tagline", "label": "Tagline", "default": "Ambition Tonic" },
    { "type": "text", "id": "headline_line1", "label": "Headline line 1", "default": "Too much" },
    { "type": "text", "id": "headline_line2", "label": "Headline line 2", "default": "Ambition" },
    { "type": "text", "id": "sub", "label": "Subtitle", "default": "For a t-shirt. For a hoodie. For a pair of jeans." },
    { "type": "text", "id": "price", "label": "Capsule price", "default": "₹3,000", "info": "Leave empty to use the first linked product's price." },
    { "type": "text", "id": "price_note", "label": "Price note", "default": "One price, whichever one you take." },
    { "type": "text", "id": "sizes", "label": "Sizes", "default": "S · M · L", "info": "Separate with · or commas. Pieces linked to a product with a Size option use that option instead." },
    { "type": "text", "id": "fit", "label": "Fit note", "default": "Cut oversized. Take the size you always take." },
    { "type": "text", "id": "cta_text", "label": "Button text", "default": "Join the drop" },
    {
      "type": "textarea",
      "id": "marquee_items",
      "label": "Marquee items",
      "default": "[kicker]\nWashed black\nCut oversized\nTorn, not finished\n[sizes]\n[price]\nLimited run",
      "info": "One per line. [kicker], [sizes] and [price] are replaced with the values above."
    },
    { "type": "header", "content": "Closing drop" },
    { "type": "text", "id": "drop_title", "label": "Title", "default": "The drop" },
    { "type": "textarea", "id": "drop_body", "label": "Text", "default": "Three pieces, made once. When the run is gone there is no second one — the list gets the morning it lands, and nobody else gets told." },
    { "type": "text", "id": "drop_line", "label": "Urgency note", "default": "Drops land without warning. If you are not on the list, you will miss it.", "info": "Hidden once a linked product is on sale." },
    { "type": "header", "content": "Closing screen — on sale", "info": "Used instead of the drop copy above once any piece is linked to a product that's in stock." },
    { "type": "text", "id": "shop_cta_text", "label": "Button text", "default": "Shop the capsule" },
    { "type": "textarea", "id": "shop_body", "label": "Text", "default": "Three pieces, made once. When the run is gone there is no second one." },
    { "type": "header", "content": "Waitlist modal" },
    { "type": "text", "id": "modal_title", "label": "Title", "default": "On the list" },
    { "type": "textarea", "id": "modal_body", "label": "Text", "default": "One mail, the morning the drop goes live. Nothing else, ever." },
    { "type": "text", "id": "modal_placeholder", "label": "Email field label", "default": "Your email address" },
    { "type": "text", "id": "modal_cta", "label": "Button", "default": "Notify me" },
    { "type": "text", "id": "modal_success", "label": "Success message", "default": "You're on. Watch your inbox the morning it lands." },
    { "type": "text", "id": "modal_error", "label": "Error message", "default": "That address didn't look right. Try again?" },
    { "type": "text", "id": "waitlist_tags", "label": "Customer tags", "default": "merch_waitlist" },
    { "type": "header", "content": "Labels" },
    { "type": "text", "id": "label_pieces", "label": "Pieces", "default": "pieces" },
    { "type": "text", "id": "label_each", "label": "Each", "default": "each" },
    { "type": "text", "id": "label_front", "label": "Front", "default": "Front" },
    { "type": "text", "id": "label_back", "label": "Back", "default": "Back" },
    { "type": "text", "id": "label_turn", "label": "Turn button (accessibility)", "default": "Turn it over" },
    { "type": "text", "id": "label_sizes_group", "label": "Size group (accessibility)", "default": "Size selection" },
    { "type": "text", "id": "label_fit", "label": "Fit", "default": "Fit" },
    { "type": "text", "id": "label_sizes", "label": "Sizes", "default": "Sizes" },
    { "type": "text", "id": "label_drop", "label": "The drop", "default": "The drop" },
    { "type": "text", "id": "label_close", "label": "Close (accessibility)", "default": "Close" },
    { "type": "text", "id": "label_add", "label": "Add to bag", "default": "Add to bag" },
    { "type": "text", "id": "label_pick_size", "label": "Size needed", "default": "Pick a size first" },
    { "type": "text", "id": "label_adding", "label": "Adding", "default": "Adding…" },
    { "type": "text", "id": "label_added", "label": "Added", "default": "In your bag" },
    { "type": "text", "id": "label_sold_out", "label": "Sold out", "default": "Sold out" },
    { "type": "text", "id": "label_add_error", "label": "Add to bag failed", "default": "That didn't go through. Try again?" }
  ],
  "blocks": [
    {
      "type": "piece",
      "name": "Garment piece",
      "settings": [
        { "type": "product", "id": "product", "label": "Product", "info": "Optional. Supplies title, price, description, sizes and images when the fields below are empty." },
        { "type": "text", "id": "number", "label": "Piece number", "info": "Defaults to the block's position." },
        { "type": "text", "id": "line1", "label": "Title line 1" },
        { "type": "text", "id": "line2", "label": "Title line 2" },
        { "type": "text", "id": "tag", "label": "Tagline" },
        { "type": "textarea", "id": "blurb", "label": "Description" },
        { "type": "textarea", "id": "spec", "label": "Specifications (one per line)", "info": "Falls back to the product metafield custom.spec." },
        { "type": "text", "id": "price", "label": "Price", "info": "Leave empty to use the product price, then the capsule price." },
        { "type": "text", "id": "sizes", "label": "Sizes", "info": "Used when the product has no Size option. Leave empty to use the capsule sizes." },
        { "type": "image_picker", "id": "front_image", "label": "Front image" },
        { "type": "image_picker", "id": "back_image", "label": "Back image" },
        { "type": "text", "id": "front_asset", "label": "Front theme asset (fallback)", "info": "Theme asset filename used when no product or uploaded image exists." },
        { "type": "text", "id": "back_asset", "label": "Back theme asset (fallback)" },
