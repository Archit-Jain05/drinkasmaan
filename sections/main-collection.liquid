<section class="asmaan-subpage-section pt-24 pb-20">
  <div class="padding-global">
    <div class="container-large max-w-6xl mx-auto px-4">
      <div class="asmaan-subpage-hero text-left mb-12">
        <span class="font-mono text-xs uppercase tracking-[0.25em] text-[#9089D3] block mb-2">Curated Catalog &bull; All Batches</span>
        <h1 class="text-4xl sm:text-6xl font-black uppercase tracking-tight text-white mb-4">
          {% if collection.title != blank %}{{ collection.title }}{% else %}All Products{% endif %}
        </h1>
        <p class="text-white/60 text-sm max-w-lg">
          Cognitive focus tonics and architectural studio apparel. Pure functional botanical formulations.
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-8 mb-16">
        {%- if collection.products.size > 0 -%}
          {%- for product in collection.products -%}
            <div class="shop-product-card group">
              <div class="shop-card-badge">Catalog</div>
              <div class="shop-card-image-wrap">
                {%- if product.featured_image -%}
                  <img src="{{ product.featured_image | image_url: width: 500 }}" alt="{{ product.title | escape }}" class="shop-card-img">
                {%- else -%}
                  {%- assign p_handle = product.handle | downcase -%}
                  {%- assign p_title = product.title | downcase -%}
                  {%- if p_handle contains 'mango' or p_title contains 'mango' -%}
                    <img src="{{ 'mango-front.webp' | asset_url }}" alt="{{ product.title | escape }}" class="shop-card-img" onerror="this.src='{{ 'can-asmaan.png' | asset_url }}'">
                  {%- elsif p_handle contains 'magenta' or p_title contains 'magenta' or p_handle contains 'wild' or p_title contains 'wild' -%}
                    <img src="{{ 'print-front.webp' | asset_url }}" alt="{{ product.title | escape }}" class="shop-card-img" onerror="this.src='{{ 'can-asmaan.png' | asset_url }}'">
                  {%- else -%}
                    <img src="{{ 'jamun-front.webp' | asset_url }}" alt="{{ product.title | escape }}" class="shop-card-img" onerror="this.src='{{ 'can-asmaan.png' | asset_url }}'">
                  {%- endif -%}
                {%- endif -%}
              </div>
              <div class="shop-card-details">
                <span class="shop-card-tag">Asmaan Collection</span>
                <h3 class="shop-card-title">{{ product.title }}</h3>
                <p class="shop-card-desc">{{ product.description | strip_html | truncate: 90 }}</p>
                <div class="shop-card-meta">
                  <div class="shop-card-price">{{ product.price | money }}</div>
                </div>
                <div class="mt-4 flex gap-2">
                  <a href="{{ product.url }}" class="button is-small is-primary w-full !text-xs">View Details</a>
                </div>
              </div>
            </div>
          {%- endfor -%}
        {%- else -%}
          <!-- Flagship Cans & Packs Showcase -->
          <div class="shop-product-card group">
            <div class="shop-card-badge">Flagship 01</div>
            <div class="shop-card-image-wrap">
              <img src="{{ 'jamun-front.webp' | asset_url }}" alt="Kala Jamun Tonic" class="shop-card-img" onerror="this.src='{{ 'can-asmaan.png' | asset_url }}'">
            </div>
            <div class="shop-card-details">
              <span class="shop-card-tag">Ambition Tonic &bull; 250ml</span>
              <h3 class="shop-card-title">Kala Jamun</h3>
              <p class="shop-card-desc">Tart Indian blackberry, green coffee caffeine &amp; L-theanine. Zero sugar.</p>
              <div class="shop-card-meta">
                <div class="shop-card-price">&#8377;2,160 <span class="text-xs text-white/50 font-normal">/ 12 cans</span></div>
                <span class="shop-card-spec text-emerald-400">In Stock</span>
              </div>
              <div class="mt-4 flex gap-2">
                <a href="/#range" class="button is-small is-secondary flex-1 !text-xs">Explore</a>
                <form action="/cart/add" method="post" class="flex-1">
                  <input type="hidden" name="id" value="jamun-12pack">
                  <button type="submit" class="button is-small is-primary w-full !text-xs">Add to Cart</button>
                </form>
              </div>
            </div>
          </div>

          <div class="shop-product-card group">
            <div class="shop-card-badge">Flagship 02</div>
            <div class="shop-card-image-wrap">
              <img src="{{ 'mango-front.webp' | asset_url }}" alt="Alphonso Mango Tonic" class="shop-card-img" onerror="this.src='{{ 'can-asmaan.png' | asset_url }}'">
            </div>
            <div class="shop-card-details">
              <span class="shop-card-tag">Ambition Tonic &bull; 250ml</span>
              <h3 class="shop-card-title">Alphonso Mango</h3>
              <p class="shop-card-desc">Burnt amber finish with green tea botanicals. Clean focus curve.</p>
              <div class="shop-card-meta">
                <div class="shop-card-price">&#8377;2,160 <span class="text-xs text-white/50 font-normal">/ 12 cans</span></div>
                <span class="shop-card-spec text-emerald-400">In Stock</span>
              </div>
              <div class="mt-4 flex gap-2">
                <a href="/#range" class="button is-small is-secondary flex-1 !text-xs">Explore</a>
                <form action="/cart/add" method="post" class="flex-1">
                  <input type="hidden" name="id" value="mango-12pack">
                  <button type="submit" class="button is-small is-primary w-full !text-xs">Add to Cart</button>
                </form>
              </div>
            </div>
          </div>

          <div class="shop-product-card group">
            <div class="shop-card-badge">Flagship 03</div>
            <div class="shop-card-image-wrap">
              <img src="{{ 'print-front.webp' | asset_url }}" alt="Wild Magenta Tonic" class="shop-card-img" onerror="this.src='{{ 'can-asmaan.png' | asset_url }}'">
            </div>
            <div class="shop-card-details">
              <span class="shop-card-tag">Ambition Tonic &bull; 250ml</span>
              <h3 class="shop-card-title">Wild Magenta</h3>
              <p class="shop-card-desc">Rose and pink guava notes with crisp citrus bite. 10 calories.</p>
              <div class="shop-card-meta">
                <div class="shop-card-price">&#8377;2,160 <span class="text-xs text-white/50 font-normal">/ 12 cans</span></div>
                <span class="shop-card-spec text-emerald-400">In Stock</span>
              </div>
              <div class="mt-4 flex gap-2">
                <a href="/#range" class="button is-small is-secondary flex-1 !text-xs">Explore</a>
                <form action="/cart/add" method="post" class="flex-1">
                  <input type="hidden" name="id" value="magenta-12pack">
                  <button type="submit" class="button is-small is-primary w-full !text-xs">Add to Cart</button>
                </form>
              </div>
            </div>
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

