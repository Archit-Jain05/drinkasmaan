<section class="asmaan-subpage-section pt-24 pb-20">
  <div class="padding-global">
    <div class="container-large max-w-6xl mx-auto px-4">
      <div class="asmaan-subpage-hero text-left mb-12">
        <span class="font-mono text-xs uppercase tracking-[0.25em] text-[#9089D3] block mb-2">Curated Catalog &bull; All Batches</span>
        <h1 class="text-4xl sm:text-6xl font-black uppercase tracking-tight text-white mb-4">
          {% if collection.title != blank %}{{ collection.title }}{% else %}All Products{% endif %}
        </h1>
        <p class="text-white/60 text-sm max-w-lg">
          Cognitive focus tonics and architectural studio apparel. Pure functional botanical formulations.
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-8 mb-16">
        {%- if collection.products.size > 0 -%}
          {%- for product in collection.products -%}
            <div class="shop-product-card group">
              <div class="shop-card-badge">Catalog</div>
              <div class="shop-card-image-wrap">
                {%- if product.featured_image -%}
                  <img src="{{ product.featured_image | image_url: width: 500 }}" alt="{{ product.title | escape }}" class="shop-card-img">
                {%- endif -%}
              </div>
              <div class="shop-card-details">
                <span class="shop-card-tag">Asmaan Collection</span>
                <h3 class="shop-card-title">{{ product.title }}</h3>
                <p class="shop-card-desc">{{ product.description | strip_html | truncate: 90 }}</p>
                <div class="shop-card-meta">
                  <div class="shop-card-price">{{ product.price | money }}</div>
                </div>
                <div class="mt-4 flex gap-2">
                  <a href="{{ product.url }}" class="button is-small is-primary w-full !text-xs">View Details</a>
                </div>
              </div>
            </div>
          {%- endfor -%}
        {%- else -%}
          <div class="col-span-full py-16 text-center">
            <p class="text-white/60 font-mono text-sm">No products found in this collection.</p>
            <a href="/collections/all" class="button is-small is-secondary mt-4 inline-block">View All Products</a>
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Collection Grid",
  "settings": [],
  "presets": [
    {
      "name": "Collection Grid"
    }
  ]
}
{% endschema %}
