<section class="section relative bg-black text-white min-h-[70vh] py-16">
  <div class="padding-global">
    <div class="container-large max-w-6xl mx-auto px-4">
      <h1 class="text-3xl sm:text-5xl font-bold tracking-tight mb-12">{{ collection.title }}</h1>
      <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-8">
        {%- for product in collection.products -%}
          <a href="{{ product.url }}" class="group block text-center border border-white/10 rounded-2xl p-6 bg-white/[0.03] hover:border-white/30 transition-colors">
            {%- if product.featured_image -%}
              <img src="{{ product.featured_image | image_url: width: 400 }}" alt="{{ product.title | escape }}" class="h-64 mx-auto object-contain mb-4 group-hover:-translate-y-2 transition-transform">
            {%- endif -%}
            <h3 class="text-xl font-bold">{{ product.title }}</h3>
            <p class="text-white/60 mt-2">{{ product.price | money }}</p>
          </a>
        {%- endfor -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Collection Grid",
  "settings": []
}
{% endschema %}
