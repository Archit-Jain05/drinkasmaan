{%- assign free_shipping_money = settings.free_shipping_threshold | money_without_trailing_zeros -%}
{%- liquid
  assign accent_color = product.metafields.custom.accent_color.value
  if accent_color == blank
    assign colour_lines = section.settings.flavour_colours | newline_to_br | split: '<br />'
    for line in colour_lines
      assign pair = line | split: ':'
      assign pair_handle = pair.first | strip
      if pair_handle == product.handle
        assign accent_color = pair.last | strip
        break
      endif
    endfor
  endif
  assign accent_color = accent_color | default: section.settings.fallback_accent
  assign tint_color = accent_color

  assign label_asset = ''
  if product.images.size > 0
    assign label_asset = product.images.last | image_url: width: 2048
  elsif product.media.size > 0
    assign label_asset = product.media.last | image_url: width: 2048
  elsif product.metafields.custom.label_image != blank
    assign label_asset = product.metafields.custom.label_image | image_url: width: 2048
  elsif product.metafields.custom.label != blank
    assign label_asset = product.metafields.custom.label | image_url: width: 2048
  endif

  assign current_variant = product.selected_or_first_available_variant
  assign featured_img = current_variant.featured_media | default: product.featured_media | default: product.featured_image | default: product.images.first
  assign poster_asset = ''
  if featured_img != blank
    assign poster_asset = featured_img | image_url: width: 800
  endif
-%}

<style>
  .product-page-wrap {
    padding-top: 6rem;
    padding-bottom: 5rem;
    min-height: 100vh;
    background: #000;
  }
  .product-grid-layout {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
    align-items: start;
    max-width: 72rem;
    margin: 0 auto;
    padding: 0 1.5rem;
  }
  @media (min-width: 840px) {
    .product-grid-layout {
      grid-template-columns: 1fr 1fr;
      gap: 3.5rem;
    }
  }

  .product-gallery-stage {
    position: sticky;
    top: 6rem;
    background: rgba(255, 255, 255, 0.02);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 1.5rem;
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    width: 100%;
    box-sizing: border-box;
    position: relative;
  }
  @media (min-width: 640px) {
    .product-gallery-stage {
      padding: 2rem;
    }
  }

  .product-canvas-box {
    position: relative;
    width: 100%;
    height: 480px;
    min-height: 380px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0.5rem 0;
    overflow: hidden;
  }

  .product-canvas-box .asmaan-can {
    height: 100%;
    max-height: 420px;
    width: auto;
    aspect-ratio: 760 / 1950;
    max-width: 100%;
    margin-inline: auto;
  }

  @media (max-width: 640px) {
    .product-canvas-box {
      height: 400px;
      min-height: 340px;
    }
    .product-canvas-box .asmaan-can {
      max-height: 350px;
    }
  }

  .product-static-image {
    position: absolute;
    inset: 0;
    margin: auto;
    max-height: 420px;
    max-width: 90%;
    width: auto;
    height: 100%;
    object-fit: contain;
    z-index: 2;
    opacity: 1;
    transition: opacity 0.4s ease;
    pointer-events: none;
  }

  .can-angle-btn-list {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.4rem;
    margin: 0.5rem 0;
    flex-wrap: wrap;
    position: relative;
    z-index: 5;
  }

  .can-angle-btn {
    font-family: var(--font-mono, monospace);
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    padding: 0.35rem 0.85rem;
    border-radius: 9999px;
    border: 1px solid rgba(255, 255, 255, 0.12);
    background: rgba(255, 255, 255, 0.04);
    color: rgba(255, 255, 255, 0.65);
    cursor: pointer;
    transition: all 0.2s ease;
  }
  .can-angle-btn:hover {
    border-color: rgba(255, 255, 255, 0.35);
    color: #fff;
  }
  .can-angle-btn.is-active,
  .can-angle-btn[aria-pressed="true"] {
    background: rgba(255, 255, 255, 0.15);
    border-color: rgba(255, 255, 255, 0.35);
    color: #fff;
    font-weight: 600;
  }

  .pack-opt-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(110px, 1fr));
    gap: 0.75rem;
  }

  .pack-opt-btn {
    padding: 0.85rem 0.5rem;
    border-radius: 0.75rem;
    border: 1px solid rgba(255, 255, 255, 0.12);
    background: rgba(255, 255, 255, 0.03);
    cursor: pointer;
    text-align: center;
    transition: all 0.2s ease;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
  }
  .pack-opt-btn:hover {
    border-color: rgba(255, 255, 255, 0.3);
    background: rgba(255, 255, 255, 0.06);
  }
  .pack-opt-btn.is-selected {
    border-color: #fff;
    background: rgba(255, 255, 255, 0.12);
    box-shadow: 0 0 15px rgba(255, 255, 255, 0.08);
  }
  .pack-opt-btn.is-soldout {
    opacity: 0.45;
    cursor: not-allowed;
  }
</style>

<section class="product-page-wrap">
  <div class="product-grid-layout">
    <!-- Product Visual Gallery & 3D Interactive Stage -->
    <div class="product-gallery-stage{% unless section.settings.enable_sticky_gallery %} !static{% endunless %}" data-asmaan-can-group>
      <!-- Feature Badge -->
      {%- if section.settings.show_badge -%}
        <div style="position: absolute; top: 1rem; left: 1rem; z-index: 10;">
          <span style="display: inline-flex; align-items: center; gap: 0.4rem; padding: 0.25rem 0.75rem; border-radius: 9999px; background: rgba(255,255,255,0.08); border: 1px solid rgba(255,255,255,0.2); font-family: var(--font-mono, monospace); font-size: 11px; text-transform: uppercase; letter-spacing: 0.1em; color: {{ accent_color }};">
            <span style="height: 6px; width: 6px; border-radius: 50%; background: #34d399; display: inline-block;"></span>
            {{ section.settings.badge_text | default: 'Chilled Serving' }}
          </span>
        </div>
      {%- endif -%}

      <!-- 3D / 2D View Mode Switcher (if product has uploaded images) -->
      {%- if section.settings.show_3d_toggle and product.images.size > 0 -%}
        <div style="position: absolute; top: 1rem; right: 1rem; z-index: 10; display: flex; gap: 0.25rem; background: rgba(255,255,255,0.06); padding: 2px; border-radius: 0.5rem; border: 1px solid rgba(255,255,255,0.1); font-family: var(--font-mono, monospace); font-size: 10px; text-transform: uppercase;">
          <button type="button" id="view-mode-3d" style="padding: 0.25rem 0.65rem; border-radius: 0.35rem; background: rgba(255,255,255,0.2); color: #fff; font-weight: bold; cursor: pointer; border: none;">3D Can</button>
          <button type="button" id="view-mode-photo" style="padding: 0.25rem 0.65rem; border-radius: 0.35rem; background: transparent; color: rgba(255,255,255,0.6); cursor: pointer; border: none;">Photos</button>
        </div>
      {%- endif -%}

      <!-- Main 3D Can Viewport -->
      <div class="product-canvas-box" id="product-canvas-container">
        {% render 'asmaan-can-3d',
          label: label_asset,
          poster: poster_asset,
          alt: product.title,
          tint: tint_color,
          draggable: true,
          view: 'front',
          ratio: '760 / 1950',
          headroom: 1.18,
          idle_spin: 0.3
        %}

        <!-- Fallback / Multi-photo Viewer (hidden during 3D mode) -->
        <img
          src="{{ poster_asset }}"
          width="760"
          height="1950"
          alt="{{ product.title | default: 'Asmaan Ambition Tonic' | escape }}"
          class="product-static-image"
          id="main-product-image"
          style="display: none;"
        >
      </div>

      <!-- 3D Angle Preset Buttons -->
      {%- if section.settings.show_angle_controls -%}
        <div class="can-angle-btn-list" id="can-angle-controls">
          <button type="button" class="can-angle-btn is-active" data-asmaan-can-view="front" aria-pressed="true">Front</button>
          <button type="button" class="can-angle-btn" data-asmaan-can-view="left" aria-pressed="false">Botanicals</button>
          <button type="button" class="can-angle-btn" data-asmaan-can-view="back" aria-pressed="false">Nutrition</button>
          <button type="button" class="can-angle-btn" data-asmaan-can-view="right" aria-pressed="false">Disclaimer</button>
        </div>
      {%- endif -%}

      <!-- Multi-Image Thumbnails Gallery (if multiple images uploaded in Shopify) -->
      {%- if section.settings.show_thumbnails and product.images.size > 1 -%}
        <div style="display: flex; align-items: center; justify-content: center; gap: 0.5rem; margin-top: 0.75rem; flex-wrap: wrap;" id="product-thumbnails">
          {%- for image in product.images -%}
            <button
              type="button"
              style="width: 44px; height: 44px; border-radius: 0.5rem; border: 1px solid rgba(255,255,255,0.15); background: rgba(255,255,255,0.03); overflow: hidden; padding: 2px; cursor: pointer;"
              class="product-thumb-btn"
              data-full-img="{{ image | image_url: width: 800 }}"
              aria-label="View product image {{ forloop.index }}"
            >
              <img src="{{ image | image_url: width: 100 }}" width="{{ image.width }}" height="{{ image.height }}" alt="{{ image.alt | default: product.title | escape }}" style="width: 100%; height: 100%; object-fit: contain;">
            </button>
          {%- endfor -%}
        </div>
      {%- endif -%}

      {%- if section.settings.material_note != blank -%}
        <div style="width: 100%; text-align: center; padding-top: 0.75rem; margin-top: 0.5rem; border-top: 1px solid rgba(255,255,255,0.1);">
          <span style="font-family: var(--font-mono, monospace); font-size: 11px; color: rgba(255,255,255,0.5); text-transform: uppercase; letter-spacing: 0.1em;">
            {{ section.settings.material_note }}
          </span>
        </div>
      {%- endif -%}
    </div>

    <!-- Product Information & Purchase Flow -->
    <div>
      {%- if section.settings.show_vendor -%}
        <span style="font-family: var(--font-mono, monospace); font-size: 12px; text-transform: uppercase; letter-spacing: 0.25em; display: block; margin-bottom: 0.5rem; color: {{ accent_color }};">
          {{ product.type | default: 'Ambition Tonic' }} &bull; {{ product.vendor | default: 'Asmaan' }}
        </span>
      {%- endif -%}

      <h1 style="font-size: clamp(2rem, 4vw, 3rem); font-weight: 900; text-transform: uppercase; letter-spacing: -0.02em; color: #fff; margin: 0 0 0.75rem;">
        {{ product.title | default: 'Asmaan Ambition Tonic' }}
      </h1>
      
      <div style="font-size: 1.5rem; font-family: var(--font-mono, monospace); color: #fff; margin-bottom: 1.5rem; display: flex; align-items: baseline; gap: 0.75rem; flex-wrap: wrap;">
        <span id="product-price-display" style="font-weight: bold;">
          {{ current_variant.price | money }}
        </span>
        <span
          id="product-compare-price-display"
          style="font-size: 1.1rem; text-decoration: line-through; color: rgba(255, 255, 255, 0.4);{% unless current_variant.compare_at_price > current_variant.price %} display: none;{% endunless %}"
        >
          {% if current_variant.compare_at_price > current_variant.price %}
            {{ current_variant.compare_at_price | money }}
          {% endif %}
        </span>
        {%- if section.settings.show_shipping_notice -%}
          <span style="font-size: 12px; font-family: var(--font-mono, monospace); text-transform: uppercase; letter-spacing: 0.1em; color: #34d399;">
            &bull; {{ section.settings.shipping_notice_text | default: 'Free shipping across India' }}
          </span>
        {%- endif -%}
      </div>

      <div style="color: rgba(255,255,255,0.7); line-height: 1.6; font-size: 0.875rem; margin-bottom: 2rem;">
        {%- if product.description != blank -%}
          {{ product.description }}
        {%- else -%}
          <p>Formulated for deep creative work, late-night architecture, and cognitive stamina. Engineered with raw green coffee bean caffeine, L-theanine, KSM-66 ashwagandha, and mountain botanicals.</p>
        {%- endif -%}
      </div>

      <!-- Dynamic Variant / Pack Allocation Selector -->
      {%- if product.variants.size > 1 or product.has_only_default_variant == false -%}
        <div style="margin-bottom: 2rem;" id="variant-selection-container">
          <label style="display: block; font-family: var(--font-mono, monospace); font-size: 11px; text-transform: uppercase; letter-spacing: 0.15em; color: rgba(255,255,255,0.6); margin-bottom: 0.75rem;">
            Select {{ product.options.first | default: 'Pack Allocation' }}
          </label>
          <div class="pack-opt-grid" id="pack-selector">
            {%- for variant in product.variants -%}
              <button
                type="button"
                class="pack-opt-btn{% if variant.id == current_variant.id %} is-selected{% endif %}{% unless variant.available %} is-soldout{% endunless %}"
                data-variant-id="{{ variant.id }}"
                data-price="{{ variant.price | money }}"
                data-compare-price="{% if variant.compare_at_price > variant.price %}{{ variant.compare_at_price | money }}{% endif %}"
                data-available="{{ variant.available }}"
                data-title="{{ variant.title | escape }}"
                {% if variant.featured_media %}data-variant-media="{{ variant.featured_media | image_url: width: 800 }}"{% endif %}
              >
                <span style="display: block; font-size: 12px; font-weight: bold; color: #fff; text-transform: uppercase;">
                  {{ variant.title }}
                </span>
                <span style="display: block; font-size: 10px; color: {% if variant.available %}#34d399{% else %}rgba(255,255,255,0.4){% endif %}; font-family: var(--font-mono, monospace); margin-top: 2px;">
                  {% if variant.available %}
                    {{ variant.price | money }}
                  {% else %}
                    Sold Out
                  {% endif %}
                </span>
              </button>
            {%- endfor -%}
          </div>
        </div>
      {%- endif -%}

      <!-- Core Specs Pills -->
      {%- if section.settings.show_spec_pills -%}
        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem; margin-bottom: 2rem; font-family: var(--font-mono, monospace); font-size: 12px; color: rgba(255,255,255,0.7);">
          <div style="padding: 0.85rem; border-radius: 0.75rem; background: rgba(255,255,255,0.03); border: 1px solid rgba(255,255,255,0.1);">
            <span style="color: #fff; display: block; font-weight: bold; font-size: 14px;">{{ product.metafields.custom.spec_1_title | default: section.settings.spec_1_title | default: '0g Sugar' }}</span> {{ product.metafields.custom.spec_1_subtitle | default: section.settings.spec_1_subtitle | default: '10 Calories per can' }}
          </div>
          <div style="padding: 0.85rem; border-radius: 0.75rem; background: rgba(255,255,255,0.03); border: 1px solid rgba(255,255,255,0.1);">
            <span style="color: #fff; display: block; font-weight: bold; font-size: 14px;">{{ product.metafields.custom.spec_2_title | default: section.settings.spec_2_title | default: '100mg Caffeine' }}</span> {{ product.metafields.custom.spec_2_subtitle | default: section.settings.spec_2_subtitle | default: 'Raw Green Coffee' }}
          </div>
          <div style="padding: 0.85rem; border-radius: 0.75rem; background: rgba(255,255,255,0.03); border: 1px solid rgba(255,255,255,0.1);">
            <span style="color: #fff; display: block; font-weight: bold; font-size: 14px;">{{ product.metafields.custom.spec_3_title | default: section.settings.spec_3_title | default: 'L-Theanine 200mg' }}</span> {{ product.metafields.custom.spec_3_subtitle | default: section.settings.spec_3_subtitle | default: 'Smooth Focus Curve' }}
          </div>
          <div style="padding: 0.85rem; border-radius: 0.75rem; background: rgba(255,255,255,0.03); border: 1px solid rgba(255,255,255,0.1);">
            <span style="color: #fff; display: block; font-weight: bold; font-size: 14px;">{{ product.metafields.custom.spec_4_title | default: section.settings.spec_4_title | default: 'KSM-66 300mg' }}</span> {{ product.metafields.custom.spec_4_subtitle | default: section.settings.spec_4_subtitle | default: 'Cortisol Modulation' }}
          </div>
        </div>
      {%- endif -%}

      <!-- Add To Cart Form -->
      {%- form 'product', product, id: 'product-form-main', style: 'margin-bottom: 2rem;' -%}
        <input type="hidden" name="id" id="selected-variant-id" value="{{ current_variant.id }}">
        
        <div style="display: flex; gap: 0.75rem; align-items: stretch; flex-wrap: wrap;">
          {%- if section.settings.show_quantity_selector -%}
            <div style="display: flex; align-items: center; border-radius: 0.75rem; background: rgba(255,255,255,0.06); border: 1px solid rgba(255,255,255,0.15); padding: 0 0.75rem; min-height: 48px;">
              <button type="button" aria-label="Decrease quantity" style="color: rgba(255,255,255,0.6); background: transparent; border: none; font-size: 18px; cursor: pointer; padding: 0.5rem;" onclick="var q=document.getElementById('product-qty'); if(q.value>1) q.value--;">&minus;</button>
              <input type="number" id="product-qty" name="quantity" value="1" min="1" aria-label="Product quantity" style="width: 40px; text-align: center; font-family: var(--font-mono, monospace); color: #fff; background: transparent; border: none; outline: none; font-size: 14px;">
              <button type="button" aria-label="Increase quantity" style="color: rgba(255,255,255,0.6); background: transparent; border: none; font-size: 18px; cursor: pointer; padding: 0.5rem;" onclick="var q=document.getElementById('product-qty'); q.value++;">&plus;</button>
            </div>
          {%- else -%}
            <input type="hidden" id="product-qty" name="quantity" value="1">
          {%- endif -%}

          <button
            type="submit"
            name="add"
            id="add-to-cart-btn"
            class="button is-hero is-primary"
            style="flex: 1; display: flex; align-items: center; justify-content: center; height: auto; min-height: 48px; {% unless current_variant.available %}opacity: 0.5; cursor: not-allowed;{% endunless %}"
            {% unless current_variant.available %}disabled{% endunless %}
          >
            {%- if current_variant.available -%}
              {{ section.settings.add_to_cart_text | default: 'Add to Cart • Free Shipping' }}
            {%- else -%}
              Sold Out
            {%- endif -%}
          </button>
        </div>
      {%- endform -%}

      <!-- Botanical Accordion -->
      {%- if section.settings.show_accordions or section.blocks.size > 0 -%}
        <div style="margin-top: 2.5rem; padding-top: 2rem; border-top: 1px solid rgba(255,255,255,0.1);">
          {%- if section.settings.show_accordions -%}
            {%- if section.settings.acc_1_title != blank -%}
              <div class="product_spec_item" style="border-bottom: 1px solid rgba(255,255,255,0.1); padding-bottom: 1rem; margin-bottom: 1rem;">
                <button type="button" class="product_spec_question" style="padding: 0.5rem 0; font-size: 14px; font-weight: bold; text-transform: uppercase; color: #fff; display: flex; justify-content: space-between; align-items: center; width: 100%; background: transparent; border: none; cursor: pointer;" aria-expanded="false" aria-controls="spec-science">
                  <span>{{ section.settings.acc_1_title }}</span>
                  <span class="product_spec_icon" style="font-size: 18px; font-family: var(--font-mono, monospace);">&plus;</span>
                </button>
                <div id="spec-science" class="product_spec_answer" style="display: none; padding-top: 0.5rem; font-size: 12px; color: rgba(255,255,255,0.7); line-height: 1.6;" data-open="false">
                  {{ product.metafields.custom.scientific_formulation | default: section.settings.acc_1_content }}
                </div>
              </div>
            {%- endif -%}

            {%- if section.settings.acc_2_title != blank -%}
              <div class="product_spec_item" style="border-bottom: 1px solid rgba(255,255,255,0.1); padding-bottom: 1rem; margin-bottom: 1rem;">
                <button type="button" class="product_spec_question" style="padding: 0.5rem 0; font-size: 14px; font-weight: bold; text-transform: uppercase; color: #fff; display: flex; justify-content: space-between; align-items: center; width: 100%; background: transparent; border: none; cursor: pointer;" aria-expanded="false" aria-controls="spec-nutrition">
                  <span>{{ section.settings.acc_2_title }}</span>
                  <span class="product_spec_icon" style="font-size: 18px; font-family: var(--font-mono, monospace);">&plus;</span>
                </button>
                <div id="spec-nutrition" class="product_spec_answer" style="display: none; padding-top: 0.5rem; font-size: 12px; color: rgba(255,255,255,0.7); line-height: 1.6; font-family: var(--font-mono, monospace);" data-open="false">
                  {{ product.metafields.custom.nutrition_facts | default: section.settings.acc_2_content }}
                </div>
              </div>
            {%- endif -%}

            {%- if section.settings.acc_3_title != blank -%}
              <div class="product_spec_item" style="border-bottom: 1px solid rgba(255,255,255,0.1); padding-bottom: 1rem;">
                <button type="button" class="product_spec_question" style="padding: 0.5rem 0; font-size: 14px; font-weight: bold; text-transform: uppercase; color: #fff; display: flex; justify-content: space-between; align-items: center; width: 100%; background: transparent; border: none; cursor: pointer;" aria-expanded="false" aria-controls="spec-shipping">
                  <span>{{ section.settings.acc_3_title }}</span>
                  <span class="product_spec_icon" style="font-size: 18px; font-family: var(--font-mono, monospace);">&plus;</span>
                </button>
                <div id="spec-shipping" class="product_spec_answer" style="display: none; padding-top: 0.5rem; font-size: 12px; color: rgba(255,255,255,0.7); line-height: 1.6;" data-open="false">
                  {{ product.metafields.custom.shipping_details | default: section.settings.acc_3_content | replace: '[free_shipping_threshold]', free_shipping_money }}
                </div>
              </div>
            {%- endif -%}
          {%- endif -%}

          {%- for block in section.blocks -%}
            {%- case block.type -%}
              {%- when 'custom_accordion' -%}
                <div class="product_spec_item" style="border-bottom: 1px solid rgba(255,255,255,0.1); padding-bottom: 1rem; margin-top: 1rem;" {{ block.shopify_attributes }}>
                  <button type="button" class="product_spec_question" style="padding: 0.5rem 0; font-size: 14px; font-weight: bold; text-transform: uppercase; color: #fff; display: flex; justify-content: space-between; align-items: center; width: 100%; background: transparent; border: none; cursor: pointer;" aria-expanded="false" aria-controls="spec-block-{{ block.id }}">
                    <span>{{ block.settings.title }}</span>
                    <span class="product_spec_icon" style="font-size: 18px; font-family: var(--font-mono, monospace);">&plus;</span>
                  </button>
                  <div id="spec-block-{{ block.id }}" class="product_spec_answer" style="display: none; padding-top: 0.5rem; font-size: 12px; color: rgba(255,255,255,0.7); line-height: 1.6;" data-open="false">
                    {{ block.settings.content }}
                  </div>
                </div>
              {%- when '@app' -%}
                <div style="margin-top: 1.5rem;" {{ block.shopify_attributes }}>
                  {% render block %}
                </div>
            {%- endcase -%}
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

<!-- Product Page UI Interactivity -->
<script>
  (function() {
    // 1. Pack size / Variant button interactions
    var packBtns = document.querySelectorAll('#pack-selector .pack-opt-btn');
    var priceDisplay = document.getElementById('product-price-display');
    var comparePriceDisplay = document.getElementById('product-compare-price-display');
    var variantIdInput = document.getElementById('selected-variant-id');
    var addToCartBtn = document.getElementById('add-to-cart-btn');
    var stillImg = document.getElementById('main-product-image');

    packBtns.forEach(function(btn) {
      btn.addEventListener('click', function() {
        packBtns.forEach(function(b) { b.classList.remove('is-selected'); });
        btn.classList.add('is-selected');

        var variantId = btn.getAttribute('data-variant-id');
        var price = btn.getAttribute('data-price');
        var comparePrice = btn.getAttribute('data-compare-price');
        var isAvailable = btn.getAttribute('data-available') === 'true';
        var mediaUrl = btn.getAttribute('data-variant-media');

        if (variantIdInput && variantId) {
          variantIdInput.value = variantId;
        }
        if (priceDisplay && price) {
          priceDisplay.innerHTML = price;
        }
        if (comparePriceDisplay) {
          if (comparePrice && comparePrice.trim() !== '') {
            comparePriceDisplay.innerHTML = comparePrice;
            comparePriceDisplay.style.display = 'inline-block';
          } else {
            comparePriceDisplay.style.display = 'none';
          }
        }
        if (addToCartBtn) {
          if (isAvailable) {
            addToCartBtn.disabled = false;
            addToCartBtn.innerHTML = 'Add to Cart &bull; Free Shipping';
            addToCartBtn.style.opacity = '1';
            addToCartBtn.style.cursor = 'pointer';
          } else {
            addToCartBtn.disabled = true;
            addToCartBtn.innerHTML = 'Sold Out';
            addToCartBtn.style.opacity = '0.5';
            addToCartBtn.style.cursor = 'not-allowed';
          }
        }
        if (mediaUrl && stillImg) {
          stillImg.src = mediaUrl;
        }

        // Update URL query string without reloading page
        if (variantId && window.history && window.history.replaceState) {
          var url = new URL(window.location.href);
          url.searchParams.set('variant', variantId);
          window.history.replaceState({}, '', url.toString());
        }
      });
    });

    // 2. Botanical Accordions / Spec Drawers
    var specQuestions = document.querySelectorAll('.product_spec_question');
    specQuestions.forEach(function(btn) {
      btn.addEventListener('click', function() {
        var ctrlId = btn.getAttribute('aria-controls');
        var answer = document.getElementById(ctrlId);
        var isExpanded = btn.getAttribute('aria-expanded') === 'true';
        var icon = btn.querySelector('.product_spec_icon');

        // Close other drawers
        specQuestions.forEach(function(otherBtn) {
          if (otherBtn !== btn) {
            otherBtn.setAttribute('aria-expanded', 'false');
            var otherId = otherBtn.getAttribute('aria-controls');
            var otherAns = document.getElementById(otherId);
            if (otherAns) {
              otherAns.style.display = 'none';
              otherAns.setAttribute('data-open', 'false');
            }
            var otherIcon = otherBtn.querySelector('.product_spec_icon');
            if (otherIcon) otherIcon.innerHTML = '&plus;';
          }
        });

        // Toggle current drawer: if open -> close; if closed -> open
        if (isExpanded) {
          btn.setAttribute('aria-expanded', 'false');
          if (answer) {
            answer.style.display = 'none';
            answer.setAttribute('data-open', 'false');
          }
          if (icon) icon.innerHTML = '&plus;';
        } else {
          btn.setAttribute('aria-expanded', 'true');
          if (answer) {
            answer.style.display = 'block';
            answer.setAttribute('data-open', 'true');
          }
          if (icon) icon.innerHTML = '&minus;';
        }
      });
    });

    // 3. 3D Angle Preset Buttons Active state
    var angleBtns = document.querySelectorAll('.can-angle-btn');
    angleBtns.forEach(function(btn) {
      btn.addEventListener('click', function() {
        angleBtns.forEach(function(b) {
          b.classList.remove('is-active');
          b.setAttribute('aria-pressed', 'false');
        });
        btn.classList.add('is-active');
        btn.setAttribute('aria-pressed', 'true');
      });
    });

    // 4. Photo vs 3D Mode Toggle
    var btn3D = document.getElementById('view-mode-3d');
    var btnPhoto = document.getElementById('view-mode-photo');
    var can3dEl = document.querySelector('.product-canvas-box .asmaan-can');
    var controls = document.getElementById('can-angle-controls');

    if (btn3D && btnPhoto) {
      btn3D.addEventListener('click', function() {
        btn3D.style.background = 'rgba(255,255,255,0.2)';
        btn3D.style.color = '#fff';
        btnPhoto.style.background = 'transparent';
        btnPhoto.style.color = 'rgba(255,255,255,0.6)';
        if (can3dEl) can3dEl.style.display = '';
        if (stillImg) stillImg.style.display = 'none';
        if (controls) controls.style.display = 'flex';
      });

      btnPhoto.addEventListener('click', function() {
        btnPhoto.style.background = 'rgba(255,255,255,0.2)';
        btnPhoto.style.color = '#fff';
        btn3D.style.background = 'transparent';
        btn3D.style.color = 'rgba(255,255,255,0.6)';
        if (can3dEl) can3dEl.style.display = 'none';
        if (stillImg) stillImg.style.display = 'block';
        if (controls) controls.style.display = 'none';
      });
    }

    // 5. Thumbnail Click -> Switch to Photo Mode
    var thumbBtns = document.querySelectorAll('.product-thumb-btn');
    if (thumbBtns.length > 0 && stillImg) {
      thumbBtns.forEach(function(btn) {
        btn.addEventListener('click', function() {
          if (btnPhoto) btnPhoto.click();
          var fullSrc = btn.getAttribute('data-full-img');
          if (fullSrc) {
            stillImg.src = fullSrc;
          }
        });
      });
    }
  })();
</script>

