<div
  id="asmaan-loader"
  class="loader"
  data-frequency="{{ section.settings.frequency | default: 'always' }}"
  data-duration="{{ section.settings.duration | default: 1700 }}"
>
  <div class="loader_mark">
    {{ section.settings.wordmark | default: 'ASMAAN' }}
    <span class="loader_tagline">{{ section.settings.tagline | default: 'AMBITION TONIC' }}</span>
  </div>
  <div class="loader_percent" role="status" aria-live="polite">
    0%
  </div>
</div>

<script>
  (function () {
    var loader = document.getElementById('asmaan-loader');
    if (!loader) return;
    var freq = loader.getAttribute('data-frequency');
    var duration = Number(loader.getAttribute('data-duration')) || 1700;
    var key = 'asmaan:loader:seen';
    var shouldShow = true;

    if (freq === 'session') {
      try {
        if (sessionStorage.getItem(key)) shouldShow = false;
        else sessionStorage.setItem(key, '1');
      } catch (e) {}
    } else if (freq === 'once') {
      try {
        if (localStorage.getItem(key)) shouldShow = false;
        else localStorage.setItem(key, '1');
      } catch (e) {}
    }

    var root = document.documentElement;
    var percentEl = loader.querySelector('.loader_percent');

    if (!shouldShow) {
      loader.remove();
      root.style.setProperty('--loader-reveal', '0px');
      return;
    }

    document.body.style.overflow = 'hidden';
    root.style.setProperty('--loader-reveal', '100vh');
    var startTime = performance.now();

    var frame = requestAnimationFrame(function tick(now) {
      var t = Math.min((now - startTime) / duration, 1);
      var p = Math.round((1 - Math.pow(1 - t, 3)) * 100);
      if (percentEl) percentEl.textContent = p + '%';

      if (t < 1) {
        frame = requestAnimationFrame(tick);
      } else {
        loader.setAttribute('data-done', 'true');
        root.style.transition = '--loader-reveal 1.1s cubic-bezier(0.65, 0, 0.35, 1)';
        root.style.setProperty('--loader-reveal', '0px');
        document.body.style.overflow = '';
        setTimeout(function () {
          loader.remove();
        }, 900);
      }
    });
  })();
</script>

{% schema %}
{
  "name": "Asmaan Loader",
  "tag": "div",
  "class": "asmaan-loader-section",
  "settings": [
    {
      "type": "text",
      "id": "wordmark",
      "label": "Wordmark",
      "default": "ASMAAN"
    },
    {
      "type": "text",
      "id": "tagline",
      "label": "Tagline",
      "default": "AMBITION TONIC"
    },
    {
      "type": "range",
      "id": "duration",
      "label": "Duration (ms)",
      "min": 500,
      "max": 4000,
      "step": 100,
      "default": 1700
    },
    {
      "type": "select",
      "id": "frequency",
      "label": "Show",
      "options": [
        {
          "value": "always",
          "label": "Every page load"
        },
        {
          "value": "session",
          "label": "Once per session"
        },
        {
          "value": "once",
          "label": "Once ever"
        }
      ],
      "default": "always"
    }
  ],
  "presets": [
    {
      "name": "Asmaan Loader"
    }
  ]
}
{% endschema %}
