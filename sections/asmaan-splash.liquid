<div
  id="asmaan-loader"
  class="loader"
  data-frequency="{{ section.settings.frequency | default: 'always' }}"
  data-duration="{{ section.settings.duration | default: 2800 }}"
>
  <div class="loader_mark" aria-label="{{ section.settings.wordmark | default: 'ASMAAN' }}">
    <span class="loader_letters" aria-hidden="true">
      {%- assign letters = section.settings.wordmark | default: 'ASMAAN' | split: '' -%}
      {%- for letter in letters -%}
        <span class="loader_letter" data-index="{{ forloop.index0 }}">{{ letter }}</span>
      {%- endfor -%}
    </span>
    <span class="loader_tagline">{{ section.settings.tagline | default: 'AMBITION TONIC' }}</span>
  </div>
  <div class="loader_percent" role="status" aria-live="polite">
    0%
  </div>
</div>

<script>
  (function () {
    var loader = document.getElementById('asmaan-loader');
    if (!loader) return;

    var freq = loader.getAttribute('data-frequency');
    var totalDuration = Number(loader.getAttribute('data-duration')) || 2800;
    var key = 'asmaan:loader:seen';
    var shouldShow = true;

    if (freq === 'session') {
      try {
        if (sessionStorage.getItem(key)) shouldShow = false;
        else sessionStorage.setItem(key, '1');
      } catch (e) {}
    } else if (freq === 'once') {
      try {
        if (localStorage.getItem(key)) shouldShow = false;
        else localStorage.setItem(key, '1');
      } catch (e) {}
    }

    var root = document.documentElement;

    if (!shouldShow) {
      loader.remove();
      root.style.setProperty('--loader-reveal', '0px');
      return;
    }

    // Keep body scrolling locked during splash
    document.body.style.overflow = 'hidden';
    root.style.setProperty('--loader-reveal', '100vh');

    var letters = loader.querySelectorAll('.loader_letter');
    var tagline = loader.querySelector('.loader_tagline');
    var percentEl = loader.querySelector('.loader_percent');
    var letterCount = letters.length;

    // Timing constants (ms)
    var dropStart   = 180;   // first letter starts dropping after this delay
    var dropSpacing = 95;    // delay between each letter
    var dropDuration = 750;  // each letter's drop CSS transition duration
    var holdAfterDrop = 420; // pause after last letter lands before dismissing

    var lastLetterLand = dropStart + (letterCount - 1) * dropSpacing + dropDuration;
    var taglineReveal  = dropStart + (letterCount - 1) * dropSpacing + dropDuration * 0.6;
    var dismissAt      = lastLetterLand + holdAfterDrop;

    // Trigger drops with JS timeouts (so CSS transitions fire individually)
    letters.forEach(function (el, i) {
      setTimeout(function () {
        el.classList.add('is-dropped');
      }, dropStart + i * dropSpacing);
    });

    // Reveal tagline
    if (tagline) {
      setTimeout(function () {
        tagline.classList.add('is-visible');
      }, taglineReveal);
    }

    // Percentage counter synced to total dismiss duration
    var counterDuration = dismissAt;
    var startTime = performance.now();

    (function tick(now) {
      var t = Math.min((now - startTime) / counterDuration, 1);
      var p = Math.round((1 - Math.pow(1 - t, 3)) * 100);
      if (percentEl) percentEl.textContent = p + '%';
      if (t < 1) requestAnimationFrame(tick);
    })(startTime);

    // Dismiss splash
    setTimeout(function () {
      loader.setAttribute('data-done', 'true');
      root.style.transition = '--loader-reveal 1.1s cubic-bezier(0.65, 0, 0.35, 1)';
      root.style.setProperty('--loader-reveal', '0px');
      document.body.style.overflow = '';
      setTimeout(function () { loader.remove(); }, 1100);
    }, dismissAt);
  })();
</script>

{% schema %}
{
  "name": "Asmaan Loader",
  "tag": "div",
  "class": "asmaan-loader-section",
  "settings": [
    {
      "type": "text",
      "id": "wordmark",
      "label": "Wordmark",
      "default": "ASMAAN"
    },
    {
      "type": "text",
      "id": "tagline",
      "label": "Tagline",
      "default": "AMBITION TONIC"
    },
    {
      "type": "range",
      "id": "duration",
      "label": "Total Duration (ms)",
      "min": 1000,
      "max": 5000,
      "step": 100,
      "default": 2800
    },
    {
      "type": "select",
      "id": "frequency",
      "label": "Show",
      "options": [
        {
          "value": "always",
          "label": "Every page load"
        },
        {
          "value": "session",
          "label": "Once per session"
        },
        {
          "value": "once",
          "label": "Once ever"
        }
      ],
      "default": "always"
    }
  ],
  "presets": [
    {
      "name": "Asmaan Loader"
    }
  ]
}
{% endschema %}
