{%- comment -%}
  The range grid. Cards come from "Product card" blocks when there are any (and the source is
  set to blocks); otherwise from the chosen collection. Title, image, link, tagline and colours
  come from the product (tagline and colours via the metafields custom.tagline,
  custom.accent_color and custom.primary_color) unless overridden on the block.
{%- endcomment -%}

{%- liquid
  assign range_collection = section.settings.collection | default: settings.featured_can_collection
  if section.settings.card_source == 'blocks' and section.blocks.size > 0
    assign use_blocks = true
    assign card_source = section.blocks
  else
    assign use_blocks = false
    assign card_source = range_collection.products
  endif
-%}

<div class="relative z-10 bg-black before:absolute before:inset-x-0 before:bottom-full before:h-[30svh] before:bg-gradient-to-b before:from-transparent before:to-black before:content-['']">
  <section id="range-section" class="section relative bg-black">
    <div class="padding-global">
      <div class="container-large">
        <div class="padding-section-large">
          <h2 class="heading-style-display mb-[var(--pad-xxl)]">{{ section.settings.title | escape | newline_to_br }}</h2>

          <ul class="asmaan-range-grid" data-mobile-row="{{ section.settings.mobile_one_row }}">
            {%- assign card_index = 0 -%}
            {%- for item in card_source -%}
              {%- liquid
                if use_blocks
                  assign p = item.settings.product
                  assign c_title = item.settings.title | default: p.title
                  assign c_tag = item.settings.tag | default: p.metafields.custom.tagline.value
                  assign c_img = item.settings.image | default: p.featured_media | default: p.featured_image
                  assign c_url = item.settings.url | default: p.url
                  assign c_color_sec = item.settings.accent_secondary | default: p.metafields.custom.accent_color.value
                  assign c_color_pri = item.settings.accent_primary | default: p.metafields.custom.primary_color.value
                  assign attrs = item.shopify_attributes
                else
                  assign p = item
                  assign c_title = p.title
                  assign c_tag = p.metafields.custom.tagline.value
                  assign c_img = p.featured_media | default: p.featured_image
                  assign c_url = p.url
                  assign c_color_sec = p.metafields.custom.accent_color.value
                  assign c_color_pri = p.metafields.custom.primary_color.value
                  assign attrs = ''
                endif

                if c_title == blank
                  continue
                endif
                assign c_tag = c_tag | default: section.settings.default_tag
                assign c_color_sec = c_color_sec | default: section.settings.fallback_secondary
                assign c_color_pri = c_color_pri | default: section.settings.fallback_primary
              -%}
              <li {{ attrs }}>
                <button
                  type="button"
                  data-range-card="{{ card_index }}"
                  {% if c_url != blank %}data-href="{{ c_url }}"{% endif %}
                  aria-current="{% if card_index == 0 %}true{% else %}false{% endif %}"
                  class="group relative flex w-full flex-col items-center gap-[var(--pad-s)] rounded-[var(--radius-medium)] border border-white/10 bg-white/[0.03] px-[var(--pad-s)] py-[var(--pad-xl)] text-center transition-colors hover:border-white/30 aria-[current=true]:border-white/40 cursor-pointer"
                >
                  <span
                    aria-hidden="true"
                    class="pointer-events-none absolute inset-x-6 bottom-0 h-2/3 rounded-[50%] opacity-45 blur-3xl transition-opacity duration-500 group-hover:opacity-70"
                    style="background: radial-gradient(circle at 50% 100%, {{ c_color_sec }}, {{ c_color_pri }} 55%, transparent 75%);"
                  ></span>
                  {%- if c_img != blank -%}
                    <img
                      alt="{{ c_title | escape }}"
                      loading="lazy"
                      width="520"
                      height="1040"
                      decoding="async"
                      class="asmaan-range-can relative w-auto object-contain transition-transform duration-500 group-hover:-translate-y-2"
                      src="{{ c_img | image_url: width: 520 }}"
                    >
                  {%- endif -%}
                  <span class="asmaan-range-title relative heading-style-h3">{{ c_title | escape }}</span>
                  {%- if c_tag != blank -%}
                    <span class="asmaan-range-tag relative font-mono text-size-tiny uppercase tracking-[0.22em] text-white/40">{{ c_tag | escape }}</span>
                  {%- endif -%}
                </button>
              </li>
              {%- assign card_index = card_index | plus: 1 -%}
            {%- endfor -%}
          </ul>

          {%- if card_index == 0 and request.design_mode -%}
            <p class="text-white/65">Add “Product card” blocks or choose a collection to show the range.</p>
          {%- endif -%}
        </div>
      </div>
    </div>
  </section>
</div>

<style>
  #shopify-section-{{ section.id }} .asmaan-range-grid {
    display: grid;
    grid-template-columns: repeat({{ section.settings.columns }}, minmax(0, 1fr));
    gap: var(--pad-l);
  }
  #shopify-section-{{ section.id }} .asmaan-range-can { height: 38svh; }

  @media (max-width: 749px) {
    #shopify-section-{{ section.id }} .asmaan-range-grid[data-mobile-row="false"] { grid-template-columns: minmax(0, 1fr); }
    #shopify-section-{{ section.id }} .asmaan-range-grid[data-mobile-row="true"] { gap: 0.5rem; }
    #shopify-section-{{ section.id }} .asmaan-range-grid[data-mobile-row="true"] > li > button {
      padding: 1.25rem 0.25rem;
      gap: 0.5rem;
    }
    #shopify-section-{{ section.id }} .asmaan-range-grid[data-mobile-row="true"] .asmaan-range-can { height: 22svh; }
    #shopify-section-{{ section.id }} .asmaan-range-grid[data-mobile-row="true"] .asmaan-range-title {
      font-size: clamp(0.95rem, 4.2vw, 1.15rem);
      line-height: 1.1;
    }
    #shopify-section-{{ section.id }} .asmaan-range-grid[data-mobile-row="true"] .asmaan-range-tag {
      font-size: 0.6875rem;
      letter-spacing: 0.08em;
      line-height: 1.3;
    }
  }
</style>

{% schema %}
{
  "name": "Asmaan The Range",
  "tag": "div",
  "class": "asmaan-range-section",
  "settings": [
    { "type": "textarea", "id": "title", "label": "Heading", "default": "The range" },
    {
      "type": "select",
      "id": "card_source",
      "label": "Card source",
      "options": [
        { "value": "blocks", "label": "Product card blocks" },
        { "value": "collection", "label": "Collection" }
      ],
      "default": "blocks",
      "info": "With no blocks, the collection is used."
    },
    { "type": "collection", "id": "collection", "label": "Collection", "info": "Falls back to the homepage collection in Theme settings." },
    { "type": "text", "id": "default_tag", "label": "Fallback tagline", "default": "Ambition Tonic", "info": "Shown when a card has no tagline on its block or in the product metafield custom.tagline." },
    { "type": "color", "id": "fallback_secondary", "label": "Fallback glow colour", "default": "#9089D3" },
    { "type": "color", "id": "fallback_primary", "label": "Fallback glow base colour", "default": "#2A1D4A" },
    { "type": "header", "content": "Layout" },
    { "type": "range", "id": "columns", "label": "Cards per row", "min": 1, "max": 4, "step": 1, "default": 3 },
    { "type": "checkbox", "id": "mobile_one_row", "label": "Keep cards in one row on phones", "default": true, "info": "When off, cards stack on screens under 750px." }
  ],
  "blocks": [
    {
      "type": "product_card",
      "name": "Product card",
      "settings": [
        { "type": "product", "id": "product", "label": "Product" },
        { "type": "paragraph", "content": "Leave the fields below empty to use the product's own data." },
        { "type": "text", "id": "title", "label": "Title override" },
        { "type": "text", "id": "tag", "label": "Tagline override" },
        { "type": "image_picker", "id": "image", "label": "Image override" },
        { "type": "color", "id": "accent_secondary", "label": "Glow colour override" },
        { "type": "color", "id": "accent_primary", "label": "Glow base colour override" },
        { "type": "url", "id": "url", "label": "Link override" }
      ]
    }
  ],
  "presets": [
    { "name": "Asmaan The Range" }
  ]
}
{% endschema %}
