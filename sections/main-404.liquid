{{ 'asmaan-404.css' | asset_url | stylesheet_tag }}

<div class="asmaan-404_page">
  <div class="asmaan-404_glow" aria-hidden="true"></div>

  <div class="asmaan-404_container">
    <div class="asmaan-404_beacon">
      <span class="asmaan-404_beacon-dot"></span>
      <span class="asmaan-404_beacon-text">{{ section.settings.beacon_text | default: 'Error 404 // Lost Coordinate' }}</span>
    </div>

    <div class="asmaan-404_numeral" aria-label="404">404</div>

    <h1 class="asmaan-404_title">
      {{ section.settings.title | default: 'Off Course' }}
    </h1>

    <p class="asmaan-404_desc">
      {{ section.settings.subtext | default: 'The botanical frequency or coordinate you followed does not exist in our orbit. Step back into the realm or explore our formulation range.' }}
    </p>

    <div class="asmaan-404_actions">
      <a href="{{ section.settings.primary_url | default: routes.root_url }}" class="asmaan-404_btn-primary">
        <span>{{ section.settings.primary_text | default: 'Return Home' }}</span>
        <svg viewBox="0 0 16 16" fill="none" stroke="currentColor">
          <path d="M6 3L11 8L6 13" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </a>

      <a href="{{ section.settings.secondary_url | default: '/#range' }}" class="asmaan-404_btn-secondary">
        <span>{{ section.settings.secondary_text | default: 'Explore Range' }}</span>
      </a>
    </div>

    {%- if section.settings.show_quicklinks and section.settings.quicklinks_menu.links.size > 0 -%}
      <div class="asmaan-404_quicklinks">
        <div class="asmaan-404_quicklinks-title">{{ section.settings.quicklinks_title | escape }}</div>
        <ul class="asmaan-404_quicklinks-list">
          {%- for link in section.settings.quicklinks_menu.links -%}
            <li><a href="{{ link.url }}">{{ link.title | escape }}</a></li>
          {%- endfor -%}
        </ul>
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "404 Error Page",
  "settings": [
    {
      "type": "text",
      "id": "beacon_text",
      "label": "Beacon Badge Text",
      "default": "Error 404 // Lost Coordinate"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Headline",
      "default": "Off Course"
    },
    {
      "type": "textarea",
      "id": "subtext",
      "label": "Description",
      "default": "The botanical frequency or coordinate you followed does not exist in our orbit. Step back into the realm or explore our formulation range."
    },
    {
      "type": "text",
      "id": "primary_text",
      "label": "Primary Button Text",
      "default": "Return Home"
    },
    {
      "type": "url",
      "id": "primary_url",
      "label": "Primary Button Link"
    },
    {
      "type": "text",
      "id": "secondary_text",
      "label": "Secondary Button Text",
      "default": "Explore Range"
    },
    {
      "type": "url",
      "id": "secondary_url",
      "label": "Secondary Button Link"
    },
    {
      "type": "checkbox",
      "id": "show_quicklinks",
      "label": "Show Quick Links",
      "default": true
    },
    {
      "type": "text",
      "id": "quicklinks_title",
      "label": "Quick links title",
      "default": "Quick Coordinates"
    },
    {
      "type": "link_list",
      "id": "quicklinks_menu",
      "label": "Quick links menu"
    }
  ]
}
{% endschema %}
