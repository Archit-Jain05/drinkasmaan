<section class="section relative bg-black text-white min-h-[80vh] py-20 flex items-center">
  <div class="padding-global max-w-md mx-auto px-4 w-full">
    <div class="text-center mb-8">
      <h1 class="text-3xl font-black uppercase tracking-tight text-white mb-2">{{ 'customer.reset_password.title' | t | default: 'Reset Account Password' }}</h1>
      <p class="text-sm text-white/60">{{ 'customer.reset_password.subtext' | t: email: email | default: 'Enter a new password for your account.' }}</p>
    </div>

    {% form 'reset_customer_password' %}
      {% if form.errors %}
        <div class="p-3 mb-6 rounded-lg bg-red-500/10 border border-red-500/30 text-xs text-red-300">
          {{ form.errors | default_errors }}
        </div>
      {% endif %}

      <div class="space-y-4">
        <div>
          <label for="password" class="block text-xs font-mono uppercase tracking-wider text-white/60 mb-2">{{ 'customer.reset_password.password' | t | default: 'Password' }}</label>
          <input type="password" name="customer[password]" id="password" autocomplete="new-password" required class="w-full bg-white/5 border border-white/15 focus:border-white rounded-xl px-4 py-3 text-sm text-white focus:outline-none">
        </div>

        <div>
          <label for="password_confirmation" class="block text-xs font-mono uppercase tracking-wider text-white/60 mb-2">{{ 'customer.reset_password.password_confirm' | t | default: 'Confirm Password' }}</label>
          <input type="password" name="customer[password_confirmation]" id="password_confirmation" autocomplete="new-password" required class="w-full bg-white/5 border border-white/15 focus:border-white rounded-xl px-4 py-3 text-sm text-white focus:outline-none">
        </div>

        <button type="submit" class="w-full py-3.5 rounded-xl bg-white text-black font-semibold text-sm hover:bg-white/90 transition-colors">
          {{ 'customer.reset_password.submit' | t | default: 'Reset Password' }}
        </button>
      </div>
    {% endform %}
  </div>
</section>

{% schema %}
{
  "name": "Reset Password",
  "settings": []
}
{% endschema %}
