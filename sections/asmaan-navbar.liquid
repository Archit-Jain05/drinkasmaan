{%- if section.settings.show_announcement != false -%}
  <aside class="asmaan-announcement-bar" aria-label="Store Announcement">
    <a href="{{ section.settings.announcement_link | default: '/#range' }}" class="asmaan-announcement-track block text-inherit">
      <div class="asmaan-announcement-content">
        <span>{{ section.settings.announcement_text | default: 'FOUNDERS BATCH NOW LIVE • 100% BOTANICAL FOCUS TONIC • FREE SHIPPING OVER ₹999 • ZERO SUGAR • ZERO JITTERS' }}</span>
        <span aria-hidden="true">•</span>
        <span>{{ section.settings.announcement_text | default: 'FOUNDERS BATCH NOW LIVE • 100% BOTANICAL FOCUS TONIC • FREE SHIPPING OVER ₹999 • ZERO SUGAR • ZERO JITTERS' }}</span>
        <span aria-hidden="true">•</span>
        <span>{{ section.settings.announcement_text | default: 'FOUNDERS BATCH NOW LIVE • 100% BOTANICAL FOCUS TONIC • FREE SHIPPING OVER ₹999 • ZERO SUGAR • ZERO JITTERS' }}</span>
      </div>
    </a>
  </aside>
{%- endif -%}

<header class="navbar">
  <div class="navbar_slide-bg" aria-hidden="true"></div>
  <div class="navbar_overlay"></div>
  <div class="navbar_content">
    <div class="scroll_component" aria-hidden="true">
      <div class="scroll_point"></div>
      <div class="scroll_wrapper">
        <div class="scroll_indicator">
          <div class="scroll_indicator__halo"></div>
          <div class="scroll_indicator__mid"></div>
          <div class="scroll_indicator__core"></div>
          <div class="scroll_indicator__hotspot"></div>
        </div>
      </div>
      <div class="scroll_point"></div>
    </div>

    <div class="navbar_container">
      <div class="navbar_side">
        <button type="button" class="navbar_toggle" aria-pressed="true" aria-label="Toggle motion effects" data-motion-toggle>
          <span class="navbar_toggle-icon-on flex items-center">
            {% render 'asmaan-icons', name: 'bars', class: 'h-4 w-5' %}
          </span>
          <span class="navbar_toggle-icon-off hidden items-center">
            {% render 'asmaan-icons', name: 'bars-off', class: 'h-4 w-5' %}
          </span>
          <span class="hidden sm:inline navbar_toggle-label">{{ section.settings.motion_text | default: 'Motion' }}</span>
        </button>
      </div>

      <a class="navbar_wordmark" aria-label="{{ section.settings.wordmark | default: 'ASMAAN' }} — home" href="/">
        {{ section.settings.wordmark | default: 'ASMAAN' }}
      </a>

      <div class="navbar_side is-end">
        <button
          type="button"
          class="navbar_menu-button"
          aria-expanded="false"
          aria-controls="site-menu"
          data-menu-toggle
          aria-label="Toggle site navigation menu"
        >
          <span class="pointer-events-none flex items-center gap-1.5">
            {% render 'asmaan-icons', name: 'menu-dots', class: 'h-3.5 w-3.5' %}
            <span class="menu-button-text">{{ section.settings.menu_text | default: 'Menu' }}</span>
          </span>
        </button>

        {%- if section.settings.cta_text != blank -%}
          <a class="button is-small hidden lg:inline-flex" href="{{ section.settings.cta_link | default: '/#range' }}">
            {{ section.settings.cta_text | default: 'Get Early Access' }}
          </a>
        {%- endif -%}
      </div>
    </div>
  </div>
</header>

<div id="site-menu" class="navbar_dropdown" data-open="false" aria-hidden="true">
  <div class="navbar_dropdown-backdrop" data-menu-close></div>
  <div class="navbar_dropdown-menu">
    <div class="navbar_dropdown-header">
      <div class="flex items-center gap-2">
        <span class="ve-pill-glow"></span>
        <span class="font-mono text-[10px] uppercase tracking-[0.2em] text-white/60">
          Directory &bull; Shop
        </span>
      </div>
      <button type="button" class="navbar_dropdown-close" data-menu-close aria-label="Close menu">
        <svg class="h-3 w-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>

    <nav class="navbar_dropdown-links" aria-label="Primary">
      {%- if section.settings.use_custom_menu and section.settings.menu != blank -%}
        {%- for link in linklists[section.settings.menu].links -%}
          <a class="navbar_dropdown-link" href="{{ link.url }}">
            <span class="navbar_dropdown-index">0{{ forloop.index }}</span>
            <span class="navbar_dropdown-text">{{ link.title }}</span>
          </a>
        {%- endfor -%}
      {%- else -%}
        <a class="navbar_dropdown-link" href="/#range">
          <span class="navbar_dropdown-index">01</span>
          <span class="navbar_dropdown-text">The Range</span>
          <span class="navbar_dropdown-tag">3 Flavors</span>
        </a>
        <a class="navbar_dropdown-link" href="/collections/all">
          <span class="navbar_dropdown-index">02</span>
          <span class="navbar_dropdown-text">Complete Shop</span>
          <span class="navbar_dropdown-tag">Cans &bull; Packs</span>
        </a>
        <a class="navbar_dropdown-link" href="/#benefits">
          <span class="navbar_dropdown-index">03</span>
          <span class="navbar_dropdown-text">The Science</span>
          <span class="navbar_dropdown-tag">Nootropics</span>
        </a>
        <a class="navbar_dropdown-link" href="/#wear">
          <span class="navbar_dropdown-index">04</span>
          <span class="navbar_dropdown-text">Studio Wear</span>
          <span class="navbar_dropdown-tag">Drop 01</span>
        </a>
        <a class="navbar_dropdown-link" href="/#faq">
          <span class="navbar_dropdown-index">05</span>
          <span class="navbar_dropdown-text">FAQ</span>
          <span class="navbar_dropdown-tag">Answers</span>
        </a>
        <a class="navbar_dropdown-link" href="/pages/contact">
          <span class="navbar_dropdown-index">06</span>
          <span class="navbar_dropdown-text">Contact</span>
          <span class="navbar_dropdown-tag">Inquiries</span>
        </a>
      {%- endif -%}
    </nav>

    <div class="navbar_dropdown-footer">
      <a href="/cart" class="navbar_dropdown-cart">
        <span class="flex items-center gap-1.5">
          <svg class="h-3.5 w-3.5 text-[#9089D3]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z" />
          </svg>
          <span>Shopping Cart</span>
        </span>
        <span class="font-mono text-xs text-white/70">({{ cart.item_count }})</span>
      </a>
      {%- if section.settings.cta_text != blank -%}
        <a class="button is-small is-primary is-full !py-2 !text-xs mt-2" href="{{ section.settings.cta_link | default: '/#range' }}">
          {{ section.settings.cta_text | default: 'Get Early Access' }}
        </a>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Asmaan Navbar",
  "tag": "div",
  "class": "asmaan-navbar-section",
  "settings": [
    {
      "type": "header",
      "content": "Announcement Marquee"
    },
    {
      "type": "checkbox",
      "id": "show_announcement",
      "label": "Show Announcement Marquee Bar",
      "default": true
    },
    {
      "type": "text",
      "id": "announcement_text",
      "label": "Announcement Text",
      "default": "FOUNDERS BATCH NOW LIVE • 100% BOTANICAL FOCUS TONIC • FREE SHIPPING OVER ₹999 • ZERO SUGAR • ZERO JITTERS"
    },
    {
      "type": "url",
      "id": "announcement_link",
      "label": "Announcement Link"
    },
    {
      "type": "header",
      "content": "Branding & Call to Action"
    },
    {
      "type": "text",
      "id": "wordmark",
      "label": "Wordmark",
      "default": "ASMAAN"
    },
    {
      "type": "text",
      "id": "cta_text",
      "label": "CTA Button Text",
      "default": "Get Early Access"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "CTA Button Link"
    },
    {
      "type": "header",
      "content": "Labels & Menu"
    },
    {
      "type": "text",
      "id": "motion_text",
      "label": "Motion Toggle Label",
      "default": "Motion"
    },
    {
      "type": "text",
      "id": "menu_text",
      "label": "Menu Toggle Label",
      "default": "Menu"
    },
    {
      "type": "checkbox",
      "id": "use_custom_menu",
      "label": "Use Custom Menu from Shopify Navigation",
      "default": false
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Custom Menu (if enabled above)"
    },
    {
      "type": "url",
      "id": "instagram_url",
      "label": "Instagram URL"
    }
  ],
  "presets": [
    {
      "name": "Asmaan Navbar"
    }
  ]
}
{% endschema %}
