{{ 'asmaan-prototype.css' | asset_url | stylesheet_tag }}
<script src="{{ 'asmaan-prototype.js' | asset_url }}" defer></script>

<header class="navbar">
  <div class="navbar_overlay"></div>
  <div class="navbar_content">
    <div class="scroll_component" aria-hidden="true">
      <div class="scroll_point"></div>
      <div class="scroll_wrapper">
        <div class="scroll_indicator">
          <div class="scroll_indicator__halo"></div>
          <div class="scroll_indicator__mid"></div>
          <div class="scroll_indicator__core"></div>
          <div class="scroll_indicator__hotspot"></div>
        </div>
      </div>
      <div class="scroll_point"></div>
    </div>

    <div class="navbar_container">
      <div class="navbar_side">
        <button type="button" class="navbar_toggle" aria-pressed="true">
          {% render 'asmaan-icons', name: 'bars', class: 'h-4 w-5' %}
          <span class="hidden sm:inline">Motion</span>
        </button>
      </div>

      <a class="navbar_wordmark" aria-label="{{ section.settings.wordmark | default: 'ASMAAN' }} — home" href="/">
        {{ section.settings.wordmark | default: 'ASMAAN' }}
      </a>

      <div class="navbar_side is-end">
        <button type="button" class="navbar_menu-button" aria-expanded="false" aria-controls="site-menu">
          {% render 'asmaan-icons', name: 'menu-dots', class: 'h-3 w-3' %}
          <span>Menu</span>
        </button>

        {%- if section.settings.cta_text != blank -%}
          <a class="button is-small hidden lg:inline-flex" href="{{ section.settings.cta_link | default: '#newsletter' }}">
            {{ section.settings.cta_text }}
          </a>
        {%- endif -%}
      </div>
    </div>
  </div>
</header>

<div id="site-menu" class="navbar_menu" data-open="false" aria-hidden="true">
  <nav class="navbar_link-list" aria-label="Primary">
    {%- if section.settings.menu != blank -%}
      {%- for link in linklists[section.settings.menu].links -%}
        <a class="navbar_link" tabindex="-1" href="{{ link.url }}">{{ link.title }}</a>
      {%- endfor -%}
    {%- else -%}
      <a class="navbar_link" tabindex="-1" href="#range">Range</a>
      <a class="navbar_link" tabindex="-1" href="#benefits">Benefits</a>
      <a class="navbar_link" tabindex="-1" href="#faq">FAQ</a>
      <a class="navbar_link" tabindex="-1" href="#newsletter">Newsletter</a>
    {%- endif -%}
  </nav>

  <div class="navbar_bottom">
    {%- if section.settings.cta_text != blank -%}
      <a class="button is-full" tabindex="-1" href="{{ section.settings.cta_link | default: '#newsletter' }}">
        {{ section.settings.cta_text }}
      </a>
    {%- endif -%}

    <div class="navbar_socials-links">
      {%- if section.settings.instagram_url != blank -%}
        <a href="{{ section.settings.instagram_url }}" target="_blank" rel="noreferrer" class="button is-secondary is-social" tabindex="-1" aria-label="Instagram">
          {% render 'asmaan-icons', name: 'instagram', class: 'h-4 w-4' %}
        </a>
      {%- endif -%}
      <div class="text-size-tiny text-white/50">
        &copy; {{ 'now' | date: '%Y' }} {{ section.settings.wordmark | default: 'ASMAAN' }}
      </div>
      <a class="button is-secondary is-social" tabindex="-1" href="{{ section.settings.cta_link | default: '#newsletter' }}">
        Contact
      </a>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Asmaan Navbar",
  "tag": "div",
  "class": "asmaan-navbar-section",
  "settings": [
    {
      "type": "text",
      "id": "wordmark",
      "label": "Wordmark",
      "default": "ASMAAN"
    },
    {
      "type": "text",
      "id": "cta_text",
      "label": "CTA Button Text",
      "default": "Get early access"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "CTA Button Link"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Menu"
    },
    {
      "type": "url",
      "id": "instagram_url",
      "label": "Instagram URL"
    }
  ],
  "presets": [
    {
      "name": "Asmaan Navbar"
    }
  ]
}
{% endschema %}
