{%- assign free_shipping_money = settings.free_shipping_threshold | money_without_trailing_zeros -%}
{%- if section.settings.show_announcement != false -%}
  <aside class="asmaan-announcement-bar" aria-label="Store Announcement">
    <a href="{{ section.settings.announcement_link | default: '/#range' }}" class="asmaan-announcement-track block text-inherit">
      <div class="asmaan-announcement-content">
        <span>{{ section.settings.announcement_text | escape | replace: '[free_shipping_threshold]', free_shipping_money }}</span>
        <span aria-hidden="true">•</span>
        <span>{{ section.settings.announcement_text | escape | replace: '[free_shipping_threshold]', free_shipping_money }}</span>
        <span aria-hidden="true">•</span>
        <span>{{ section.settings.announcement_text | escape | replace: '[free_shipping_threshold]', free_shipping_money }}</span>
      </div>
    </a>
  </aside>
{%- endif -%}

<header class="navbar">
  <div class="navbar_slide-bg" aria-hidden="true"></div>
  <div class="navbar_overlay"></div>
  <div class="navbar_content">
    <div class="scroll_component" aria-hidden="true">
      <div class="scroll_point"></div>
      <div class="scroll_wrapper">
        <div class="scroll_indicator">
          <div class="scroll_indicator__halo"></div>
          <div class="scroll_indicator__mid"></div>
          <div class="scroll_indicator__core"></div>
          <div class="scroll_indicator__hotspot"></div>
        </div>
      </div>
      <div class="scroll_point"></div>
    </div>

    <div class="navbar_container">
      <div class="navbar_side flex items-center gap-2">
        <button
          type="button"
          class="navbar_menu-button"
          aria-expanded="false"
          aria-controls="site-menu"
          data-menu-toggle
          aria-label="Toggle site navigation menu"
        >
          <svg viewBox="0 0 16 16" class="menu-button-icon" aria-hidden="true">
            <circle cx="3.2" cy="3.2" r="1.35" fill="currentColor"></circle>
            <circle cx="12.8" cy="3.2" r="1.35" fill="currentColor"></circle>
            <circle cx="3.2" cy="12.8" r="1.35" fill="currentColor"></circle>
            <circle cx="12.8" cy="12.8" r="1.35" fill="currentColor"></circle>
            <circle cx="8" cy="8" r="1.35" fill="currentColor" class="menu-button-center-dot" style="transform:scale(1);transform-origin:8px 8px;transition:transform 0.35s ease"></circle>
          </svg>
          <span class="menu-button-text">{{ section.settings.menu_text | default: 'Menu' }}</span>
        </button>
      </div>

      <a class="navbar_wordmark" aria-label="{{ section.settings.wordmark | default: 'ASMAAN' }} — home" href="/">
        {{ section.settings.wordmark | default: 'ASMAAN' }}
      </a>

      <div class="navbar_side is-end flex items-center gap-1 sm:gap-2">
        {%- if settings.predictive_search_enabled != false -%}
          <button
            type="button"
            class="navbar_icon-button text-white/80 hover:text-white p-2 rounded-full transition-colors flex items-center justify-center cursor-pointer"
            data-search-modal-open
            aria-label="{{ 'general.search.search' | t | default: 'Search' }}"
          >
            {% render 'asmaan-icons', name: 'search', class: 'h-5 w-5' %}
          </button>
        {%- endif -%}

        {%- if shop.customer_accounts_enabled -%}
          <a
            href="{%- if customer -%}{{ routes.account_url }}{%- else -%}{{ routes.account_login_url }}{%- endif -%}"
            class="navbar_icon-button flex text-white/80 hover:text-white p-2 rounded-full transition-colors items-center justify-center"
            aria-label="{{ 'customer.account_fallback' | t | default: 'Account' }}"
          >
            {% render 'asmaan-icons', name: 'user', class: 'h-5 w-5' %}
          </a>
        {%- endif -%}

        <button
          type="button"
          class="navbar_cart-button relative text-white/80 hover:text-white p-2 rounded-full transition-colors flex items-center justify-center cursor-pointer"
          data-cart-drawer-toggle
          aria-label="{{ 'general.cart.view' | t | default: 'Cart' }}"
        >
          {% render 'asmaan-icons', name: 'bag', class: 'h-5 w-5' %}
          <span
            id="cart-icon-bubble"
            class="cart-count-badge absolute -top-0.5 -right-0.5 w-4 h-4 rounded-full bg-white text-black font-mono text-[10px] font-bold flex items-center justify-center transition-transform {%- if cart.item_count == 0 %} hidden{%- endif -%}"
          >
            {{ cart.item_count }}
          </span>
        </button>

        {%- if section.settings.cta_text != blank -%}
          <a class="button is-small hidden lg:inline-flex" href="{{ section.settings.cta_link | default: '/pages/drink' }}">
            {{ section.settings.cta_text | default: 'Get Early Access' }}
          </a>
        {%- endif -%}
      </div>
    </div>
  </div>
</header>

<div id="site-menu" class="navbar_menu" data-open="false" aria-hidden="true">
  <nav class="navbar_link-list" aria-label="Primary" style="--menu-cols: {{ section.settings.menu_columns }};">
    {%- assign menu_links = linklists[section.settings.menu].links | default: linklists['main-menu'].links -%}
    {%- for link in menu_links -%}
      <a class="navbar_link" tabindex="-1" href="{{ link.url }}"{% if link.active %} aria-current="page"{% endif %}>{{ link.title | escape }}</a>
    {%- endfor -%}
  </nav>

  <div class="navbar_bottom">
    <a class="button is-full" tabindex="-1" href="{{ section.settings.cta_link | default: '/pages/drink' }}">
      {{ section.settings.cta_text | default: 'Get early access' }}
    </a>
    <div class="navbar_socials-links">
      <a href="{{ section.settings.instagram_url | default: 'https://www.instagram.com/drinkasmaan' }}" target="_blank" rel="noreferrer" class="navbar_social-link" tabindex="-1" aria-label="Instagram">
        <svg viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <rect x="3.5" y="3.5" width="17" height="17" rx="5"></rect>
          <circle cx="12" cy="12" r="4"></circle>
          <circle cx="17.2" cy="6.8" r="0.9" fill="currentColor" stroke="none"></circle>
        </svg>
      </a>
      <div class="text-size-tiny text-white/50">&copy; {{ 'now' | date: '%Y' }} {{ section.settings.wordmark | default: 'ASMAAN' }}</div>
      <a class="navbar_social-link navbar_contact-link" tabindex="-1" href="/pages/contact">Contact</a>
    </div>
  </div>
</div>

<style>
  /* Menu overlay: links in a grid so the whole menu fits on one screen without scrolling.
     !important is needed because asmaan-prototype.css declares these properties !important. */
  .navbar_menu .navbar_link-list {
    display: grid !important;
    grid-template-columns: repeat(var(--menu-cols, 2), minmax(0, 1fr)) !important;
    column-gap: var(--pad-l) !important;
    align-content: center !important;
    flex: 1 1 auto !important;
    min-height: 0 !important;
  }
  .navbar_menu .navbar_link {
    font-size: clamp(1.35rem, min(4.2vw, 5.5svh), 3.25rem) !important;
    padding: clamp(0.5rem, 1.6svh, 1rem) var(--pad-xs) !important;
    overflow-wrap: anywhere;
  }
  .navbar_menu .navbar_link[aria-current="page"] { color: #fff; }
  @media (max-width: 749px) {
    .navbar_menu .navbar_link-list { column-gap: 1rem !important; }
    .navbar_menu .navbar_link { font-size: clamp(1.1rem, min(6vw, 4.5svh), 1.75rem) !important; padding-inline: 0.25rem !important; }
  }
</style>

{% schema %}
{
  "name": "Asmaan Navbar",
  "tag": "div",
  "class": "asmaan-navbar-section",
  "settings": [
    {
      "type": "header",
      "content": "Announcement Marquee"
    },
    {
      "type": "checkbox",
      "id": "show_announcement",
      "label": "Show Announcement Marquee Bar",
      "default": true
    },
    {
      "type": "text",
      "id": "announcement_text",
      "label": "Announcement Text",
      "default": "FOUNDERS BATCH NOW LIVE • 100% BOTANICAL FOCUS TONIC • FREE SHIPPING OVER [free_shipping_threshold] • ZERO SUGAR • ZERO JITTERS",
      "info": "[free_shipping_threshold] is replaced with the amount in Theme settings › Cart."
    },
    {
      "type": "url",
      "id": "announcement_link",
      "label": "Announcement Link"
    },
    {
      "type": "header",
      "content": "Branding & Call to Action"
    },
    {
      "type": "text",
      "id": "wordmark",
      "label": "Wordmark",
      "default": "ASMAAN"
    },
    {
      "type": "text",
      "id": "cta_text",
      "label": "CTA Button Text",
      "default": "Get Early Access"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "CTA Button Link"
    },
    {
      "type": "header",
      "content": "Labels & Menu"
    },
    {
      "type": "text",
      "id": "menu_text",
      "label": "Menu Toggle Label",
      "default": "Menu"
    },
    {
      "type": "checkbox",
      "id": "use_custom_menu",
      "label": "Use Custom Menu from Shopify Navigation",
      "default": false,
      "info": "The menu below is always used; this option is kept for compatibility."
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Custom Menu (if enabled above)"
    },
    {
      "type": "range",
      "id": "menu_columns",
      "label": "Menu columns",
      "min": 1,
      "max": 3,
      "step": 1,
      "default": 2
    },
    {
      "type": "url",
      "id": "instagram_url",
      "label": "Instagram URL"
    }
  ],
  "presets": [
    {
      "name": "Asmaan Navbar"
    }
  ]
}
{% endschema %}
