{%- if section.settings.show_announcement != false -%}
  <aside class="asmaan-announcement-bar" aria-label="Store Announcement">
    <a href="{{ section.settings.announcement_link | default: '/#range' }}" class="asmaan-announcement-track block text-inherit">
      <div class="asmaan-announcement-content">
        <span>{{ section.settings.announcement_text | default: 'FOUNDERS BATCH NOW LIVE • 100% BOTANICAL FOCUS TONIC • FREE SHIPPING OVER ₹999 • ZERO SUGAR • ZERO JITTERS' }}</span>
        <span aria-hidden="true">•</span>
        <span>{{ section.settings.announcement_text | default: 'FOUNDERS BATCH NOW LIVE • 100% BOTANICAL FOCUS TONIC • FREE SHIPPING OVER ₹999 • ZERO SUGAR • ZERO JITTERS' }}</span>
        <span aria-hidden="true">•</span>
        <span>{{ section.settings.announcement_text | default: 'FOUNDERS BATCH NOW LIVE • 100% BOTANICAL FOCUS TONIC • FREE SHIPPING OVER ₹999 • ZERO SUGAR • ZERO JITTERS' }}</span>
      </div>
    </a>
  </aside>
{%- endif -%}

<header class="navbar">
  <div class="navbar_slide-bg" aria-hidden="true"></div>
  <div class="navbar_overlay"></div>
  <div class="navbar_content">
    <div class="scroll_component" aria-hidden="true">
      <div class="scroll_point"></div>
      <div class="scroll_wrapper">
        <div class="scroll_indicator">
          <div class="scroll_indicator__halo"></div>
          <div class="scroll_indicator__mid"></div>
          <div class="scroll_indicator__core"></div>
          <div class="scroll_indicator__hotspot"></div>
        </div>
      </div>
      <div class="scroll_point"></div>
    </div>

    <div class="navbar_container">
      <div class="navbar_side">
        <button type="button" class="navbar_toggle" aria-pressed="true" aria-label="Toggle motion effects" data-motion-toggle>
          <span class="navbar_toggle-icon-on flex items-center">
            {% render 'asmaan-icons', name: 'bars', class: 'h-4 w-5' %}
          </span>
          <span class="navbar_toggle-icon-off hidden items-center">
            {% render 'asmaan-icons', name: 'bars-off', class: 'h-4 w-5' %}
          </span>
          <span class="hidden sm:inline navbar_toggle-label">{{ section.settings.motion_text | default: 'Motion' }}</span>
        </button>
      </div>

      <a class="navbar_wordmark" aria-label="{{ section.settings.wordmark | default: 'ASMAAN' }} — home" href="/">
        {{ section.settings.wordmark | default: 'ASMAAN' }}
      </a>

      <div class="navbar_side is-end">
        <button
          type="button"
          class="navbar_menu-button"
          aria-expanded="false"
          aria-controls="site-menu"
          data-menu-toggle
          aria-label="Toggle site navigation menu"
        >
          <span class="pointer-events-none flex items-center gap-1.5">
            {% render 'asmaan-icons', name: 'menu-dots', class: 'h-3.5 w-3.5' %}
            <span class="menu-button-text">{{ section.settings.menu_text | default: 'Menu' }}</span>
          </span>
        </button>

        {%- if section.settings.cta_text != blank -%}
          <a class="button is-small hidden lg:inline-flex" href="{{ section.settings.cta_link | default: '/#range' }}">
            {{ section.settings.cta_text | default: 'Get Early Access' }}
          </a>
        {%- endif -%}
      </div>
    </div>
  </div>
</header>

<div id="site-menu" class="navbar_menu" data-open="false" aria-hidden="true">
  <div class="navbar_menu-backdrop" data-menu-close></div>
  <div class="navbar_menu-container">
    <div class="navbar_menu-header">
      <div class="flex items-center gap-2.5">
        <span class="ve-pill-glow"></span>
        <span class="font-mono text-[11px] uppercase tracking-[0.25em] text-white/70">
          {{ section.settings.wordmark | default: 'ASMAAN' }} &bull; DIRECTORY &amp; SHOP
        </span>
      </div>
      <button type="button" class="navbar_menu-close-btn" data-menu-close aria-label="Close navigation menu">
        <svg class="h-3.5 w-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
        <span>Close</span>
      </button>
    </div>

    <div class="navbar_menu-body">
      <nav class="navbar_link-list" aria-label="Primary">
        {%- if section.settings.use_custom_menu and section.settings.menu != blank -%}
          {%- for link in linklists[section.settings.menu].links -%}
            <a class="navbar_link" href="{{ link.url }}">
              <span class="navbar_link-index">0{{ forloop.index }}</span>
              <span class="navbar_link-text">{{ link.title }}</span>
            </a>
          {%- endfor -%}
        {%- else -%}
          <a class="navbar_link" href="/#range">
            <span class="navbar_link-index">01</span>
            <span class="navbar_link-text">Flagship Range</span>
            <span class="navbar_link-tag">3 Flavors</span>
          </a>
          <a class="navbar_link" href="/collections/all">
            <span class="navbar_link-index">02</span>
            <span class="navbar_link-text">Complete Shop</span>
            <span class="navbar_link-tag">Cans + Packs</span>
          </a>
          <a class="navbar_link" href="/#benefits">
            <span class="navbar_link-index">03</span>
            <span class="navbar_link-text">The Science</span>
            <span class="navbar_link-tag">Adaptogens</span>
          </a>
          <a class="navbar_link" href="/#wear">
            <span class="navbar_link-index">04</span>
            <span class="navbar_link-text">Studio Wear</span>
            <span class="navbar_link-tag">Lookbook</span>
          </a>
          <a class="navbar_link" href="/#faq">
            <span class="navbar_link-index">05</span>
            <span class="navbar_link-text">FAQ</span>
            <span class="navbar_link-tag">Answers</span>
          </a>
          <a class="navbar_link" href="/pages/contact">
            <span class="navbar_link-index">06</span>
            <span class="navbar_link-text">Contact</span>
            <span class="navbar_link-tag">Support</span>
          </a>
        {%- endif -%}
      </nav>

      <div class="navbar_menu-side-panel">
        <div class="navbar_menu-promo">
          <span class="font-mono text-[10px] uppercase tracking-widest text-[#9089D3] block mb-1">Direct Batch</span>
          <h4 class="text-sm font-bold uppercase tracking-tight text-white mb-1">Founders Allocation</h4>
          <p class="text-xs text-white/60 leading-relaxed mb-4">Crafted with raw green coffee bean caffeine, L-theanine, and KSM-66 ashwagandha. Zero sugar. Free shipping over ₹999.</p>
          <a class="button is-small is-primary is-full" href="{{ section.settings.cta_link | default: '/#range' }}">
            {{ section.settings.cta_text | default: 'Get Early Access' }}
          </a>
        </div>

        <div class="navbar_menu-quicklinks">
          <a href="/cart" class="navbar_menu-quicklink">
            <span>Your Cart</span>
            <span class="font-mono text-xs text-white/60">({{ cart.item_count }})</span>
          </a>
          <a href="/collections/all" class="navbar_menu-quicklink">
            <span>Browse All Packs</span>
            <span class="font-mono text-xs text-white/60">&rarr;</span>
          </a>
        </div>
      </div>
    </div>

    <div class="navbar_menu-footer">
      <div class="flex items-center gap-3">
        {%- if section.settings.instagram_url != blank -%}
          <a href="{{ section.settings.instagram_url }}" target="_blank" rel="noreferrer" class="button is-secondary is-social !w-auto px-3 py-1.5" aria-label="Instagram">
            {% render 'asmaan-icons', name: 'instagram', class: 'h-3.5 w-3.5' %}
            <span class="text-xs ml-1 font-mono">Instagram</span>
          </a>
        {%- endif -%}
        <div class="text-[11px] font-mono text-white/40 tracking-wider">
          &copy; {{ 'now' | date: '%Y' }} {{ section.settings.wordmark | default: 'ASMAAN' }} &bull; AMBITION TONIC
        </div>
      </div>
      <a class="button is-secondary is-social !w-auto px-3 py-1.5 text-xs font-mono" href="/pages/contact">
        Get In Touch
      </a>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Asmaan Navbar",
  "tag": "div",
  "class": "asmaan-navbar-section",
  "settings": [
    {
      "type": "header",
      "content": "Announcement Marquee"
    },
    {
      "type": "checkbox",
      "id": "show_announcement",
      "label": "Show Announcement Marquee Bar",
      "default": true
    },
    {
      "type": "text",
      "id": "announcement_text",
      "label": "Announcement Text",
      "default": "FOUNDERS BATCH NOW LIVE • 100% BOTANICAL FOCUS TONIC • FREE SHIPPING OVER ₹999 • ZERO SUGAR • ZERO JITTERS"
    },
    {
      "type": "url",
      "id": "announcement_link",
      "label": "Announcement Link"
    },
    {
      "type": "header",
      "content": "Branding & Call to Action"
    },
    {
      "type": "text",
      "id": "wordmark",
      "label": "Wordmark",
      "default": "ASMAAN"
    },
    {
      "type": "text",
      "id": "cta_text",
      "label": "CTA Button Text",
      "default": "Get Early Access"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "CTA Button Link"
    },
    {
      "type": "header",
      "content": "Labels & Menu"
    },
    {
      "type": "text",
      "id": "motion_text",
      "label": "Motion Toggle Label",
      "default": "Motion"
    },
    {
      "type": "text",
      "id": "menu_text",
      "label": "Menu Toggle Label",
      "default": "Menu"
    },
    {
      "type": "checkbox",
      "id": "use_custom_menu",
      "label": "Use Custom Menu from Shopify Navigation",
      "default": false
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Custom Menu (if enabled above)"
    },
    {
      "type": "url",
      "id": "instagram_url",
      "label": "Instagram URL"
    }
  ],
  "presets": [
    {
      "name": "Asmaan Navbar"
    }
  ]
}
{% endschema %}
