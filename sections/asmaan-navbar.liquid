{%- if section.settings.show_announcement -%}
  <aside class="asmaan-announcement-bar" aria-label="Store Announcement">
    <a href="{{ section.settings.announcement_link | default: '/#range' }}" class="asmaan-announcement-track block text-inherit">
      <div class="asmaan-announcement-content">
        <span>{{ section.settings.announcement_text | default: 'FOUNDERS BATCH NOW LIVE • 100% BOTANICAL FOCUS TONIC • FREE SHIPPING OVER ₹999 • ZERO SUGAR • ZERO JITTERS' }}</span>
        <span aria-hidden="true">•</span>
        <span>{{ section.settings.announcement_text | default: 'FOUNDERS BATCH NOW LIVE • 100% BOTANICAL FOCUS TONIC • FREE SHIPPING OVER ₹999 • ZERO SUGAR • ZERO JITTERS' }}</span>
        <span aria-hidden="true">•</span>
        <span>{{ section.settings.announcement_text | default: 'FOUNDERS BATCH NOW LIVE • 100% BOTANICAL FOCUS TONIC • FREE SHIPPING OVER ₹999 • ZERO SUGAR • ZERO JITTERS' }}</span>
      </div>
    </a>
  </aside>
{%- endif -%}

<header class="navbar">
  <div class="navbar_overlay"></div>
  <div class="navbar_content">
    <div class="scroll_component" aria-hidden="true">
      <div class="scroll_point"></div>
      <div class="scroll_wrapper">
        <div class="scroll_indicator">
          <div class="scroll_indicator__halo"></div>
          <div class="scroll_indicator__mid"></div>
          <div class="scroll_indicator__core"></div>
          <div class="scroll_indicator__hotspot"></div>
        </div>
      </div>
      <div class="scroll_point"></div>
    </div>

    <div class="navbar_container">
      <div class="navbar_side">
        <button type="button" class="navbar_toggle" aria-pressed="true" aria-label="Toggle motion effects">
          {% render 'asmaan-icons', name: 'bars', class: 'h-4 w-5' %}
          <span class="hidden sm:inline">{{ section.settings.motion_text | default: 'Motion' }}</span>
        </button>
      </div>

      <a class="navbar_wordmark" aria-label="{{ section.settings.wordmark | default: 'ASMAAN' }} — home" href="/">
        {{ section.settings.wordmark | default: 'ASMAAN' }}
      </a>

      <div class="navbar_side is-end">
        <button
          type="button"
          class="navbar_menu-button"
          aria-expanded="false"
          aria-controls="site-menu"
          data-menu-toggle
          aria-label="Toggle site navigation menu"
        >
          <span class="pointer-events-none flex items-center gap-1.5">
            {% render 'asmaan-icons', name: 'menu-dots', class: 'h-3.5 w-3.5' %}
            <span class="menu-button-text">{{ section.settings.menu_text | default: 'Menu' }}</span>
          </span>
        </button>

        {%- if section.settings.cta_text != blank -%}
          <a class="button is-small hidden lg:inline-flex" href="{{ section.settings.cta_link | default: '/#range' }}">
            {{ section.settings.cta_text }}
          </a>
        {%- endif -%}
      </div>
    </div>
  </div>
</header>

<div id="site-menu" class="navbar_menu" data-open="false" aria-hidden="true">
  <div class="navbar_menu-header">
    <div class="flex items-center gap-2">
      <span class="ve-pill-glow"></span>
      <span class="font-mono text-size-tiny uppercase tracking-[0.25em] text-white/60">
        {{ section.settings.wordmark | default: 'ASMAAN' }} &bull; MENU
      </span>
    </div>
    <button type="button" class="navbar_menu-close-btn" data-menu-close aria-label="Close menu">
      <svg class="h-3.5 w-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
      </svg>
      <span>Close</span>
    </button>
  </div>

  <nav class="navbar_link-list" aria-label="Primary">
    {%- if section.settings.menu != blank -%}
      {%- for link in linklists[section.settings.menu].links -%}
        <a class="navbar_link" href="{{ link.url }}">{{ link.title }}</a>
      {%- endfor -%}
    {%- else -%}
      <a class="navbar_link" href="/#range">Drink / Range</a>
      <a class="navbar_link" href="/pages/benefits">The Science</a>
      <a class="navbar_link" href="/pages/wear">Studio Wear</a>
      <a class="navbar_link" href="/#faq">FAQ</a>
      <a class="navbar_link" href="/pages/contact">Contact</a>
    {%- endif -%}
  </nav>

  <div class="navbar_bottom w-full max-w-lg mx-auto">
    {%- if section.settings.cta_text != blank -%}
      <a class="button is-full is-hero is-primary mb-4" href="{{ section.settings.cta_link | default: '/#range' }}">
        {{ section.settings.cta_text }}
      </a>
    {%- endif -%}

    <div class="navbar_socials-links flex items-center justify-between pt-4 border-t border-white/10">
      {%- if section.settings.instagram_url != blank -%}
        <a href="{{ section.settings.instagram_url }}" target="_blank" rel="noreferrer" class="button is-secondary is-social" aria-label="Instagram">
          {% render 'asmaan-icons', name: 'instagram', class: 'h-4 w-4' %}
        </a>
      {%- endif -%}
      <div class="text-size-tiny font-mono text-white/40 tracking-wider">
        &copy; {{ 'now' | date: '%Y' }} {{ section.settings.wordmark | default: 'ASMAAN' }} &bull; ALL RIGHTS RESERVED
      </div>
      <a class="button is-secondary is-social" href="/pages/contact">
        Contact
      </a>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Asmaan Navbar",
  "tag": "div",
  "class": "asmaan-navbar-section",
  "settings": [
    {
      "type": "header",
      "content": "Announcement Marquee"
    },
    {
      "type": "checkbox",
      "id": "show_announcement",
      "label": "Show Announcement Marquee Bar",
      "default": true
    },
    {
      "type": "text",
      "id": "announcement_text",
      "label": "Announcement Text",
      "default": "FOUNDERS BATCH NOW LIVE • 100% BOTANICAL FOCUS TONIC • FREE SHIPPING OVER ₹999 • ZERO SUGAR • ZERO JITTERS"
    },
    {
      "type": "url",
      "id": "announcement_link",
      "label": "Announcement Link",
      "default": "/#range"
    },
    {
      "type": "header",
      "content": "Branding & Call to Action"
    },
    {
      "type": "text",
      "id": "wordmark",
      "label": "Wordmark",
      "default": "ASMAAN"
    },
    {
      "type": "text",
      "id": "cta_text",
      "label": "CTA Button Text",
      "default": "Order Now"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "CTA Button Link",
      "default": "/#range"
    },
    {
      "type": "header",
      "content": "Labels & Menu"
    },
    {
      "type": "text",
      "id": "motion_text",
      "label": "Motion Toggle Label",
      "default": "Motion"
    },
    {
      "type": "text",
      "id": "menu_text",
      "label": "Menu Toggle Label",
      "default": "Menu"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Menu (optional custom menu)"
    },
    {
      "type": "url",
      "id": "instagram_url",
      "label": "Instagram URL",
      "default": "https://www.instagram.com/drinkasmaan"
    }
  ],
  "presets": [
    {
      "name": "Asmaan Navbar"
    }
  ]
}
{% endschema %}
