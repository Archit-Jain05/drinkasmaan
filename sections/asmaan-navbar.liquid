{%- if section.settings.show_announcement != false -%}
  <aside class="asmaan-announcement-bar" aria-label="Store Announcement">
    <a href="{{ section.settings.announcement_link | default: '/#range' }}" class="asmaan-announcement-track block text-inherit">
      <div class="asmaan-announcement-content">
        <span>{{ section.settings.announcement_text | default: 'FOUNDERS BATCH NOW LIVE • 100% BOTANICAL FOCUS TONIC • FREE SHIPPING OVER ₹999 • ZERO SUGAR • ZERO JITTERS' }}</span>
        <span aria-hidden="true">•</span>
        <span>{{ section.settings.announcement_text | default: 'FOUNDERS BATCH NOW LIVE • 100% BOTANICAL FOCUS TONIC • FREE SHIPPING OVER ₹999 • ZERO SUGAR • ZERO JITTERS' }}</span>
        <span aria-hidden="true">•</span>
        <span>{{ section.settings.announcement_text | default: 'FOUNDERS BATCH NOW LIVE • 100% BOTANICAL FOCUS TONIC • FREE SHIPPING OVER ₹999 • ZERO SUGAR • ZERO JITTERS' }}</span>
      </div>
    </a>
  </aside>
{%- endif -%}

<header class="navbar">
  <div class="navbar_slide-bg" aria-hidden="true"></div>
  <div class="navbar_overlay"></div>
  <div class="navbar_content">
    <div class="scroll_component" aria-hidden="true">
      <div class="scroll_point"></div>
      <div class="scroll_wrapper">
        <div class="scroll_indicator">
          <div class="scroll_indicator__halo"></div>
          <div class="scroll_indicator__mid"></div>
          <div class="scroll_indicator__core"></div>
          <div class="scroll_indicator__hotspot"></div>
        </div>
      </div>
      <div class="scroll_point"></div>
    </div>

    <div class="navbar_container">
      <div class="navbar_side">
        <button type="button" class="navbar_toggle" aria-pressed="true" aria-label="Toggle motion effects" data-motion-toggle>
          <span class="navbar_toggle-icon-on flex items-center">
            {% render 'asmaan-icons', name: 'bars', class: 'h-4 w-5' %}
          </span>
          <span class="navbar_toggle-icon-off hidden items-center">
            {% render 'asmaan-icons', name: 'bars-off', class: 'h-4 w-5' %}
          </span>
          <span class="hidden sm:inline navbar_toggle-label">{{ section.settings.motion_text | default: 'Motion' }}</span>
        </button>
      </div>

      <a class="navbar_wordmark" aria-label="{{ section.settings.wordmark | default: 'ASMAAN' }} — home" href="/">
        {{ section.settings.wordmark | default: 'ASMAAN' }}
      </a>

      <div class="navbar_side is-end">
        <button
          type="button"
          class="navbar_menu-button"
          aria-expanded="false"
          aria-controls="site-menu"
          data-menu-toggle
          aria-label="Toggle site navigation menu"
        >
          <svg viewBox="0 0 16 16" class="menu-button-icon" aria-hidden="true">
            <circle cx="3.2" cy="3.2" r="1.35" fill="currentColor"></circle>
            <circle cx="12.8" cy="3.2" r="1.35" fill="currentColor"></circle>
            <circle cx="3.2" cy="12.8" r="1.35" fill="currentColor"></circle>
            <circle cx="12.8" cy="12.8" r="1.35" fill="currentColor"></circle>
            <circle cx="8" cy="8" r="1.35" fill="currentColor" class="menu-button-center-dot" style="transform:scale(1);transform-origin:8px 8px;transition:transform 0.35s ease"></circle>
          </svg>
          <span class="menu-button-text">{{ section.settings.menu_text | default: 'Menu' }}</span>
        </button>

        {%- if section.settings.cta_text != blank -%}
          <a class="button is-small hidden lg:inline-flex" href="{{ section.settings.cta_link | default: '/#range' }}">
            {{ section.settings.cta_text | default: 'Get Early Access' }}
          </a>
        {%- endif -%}
      </div>
    </div>
  </div>
</header>

<div id="site-menu" class="navbar_menu" data-open="false" aria-hidden="true">
  <nav class="navbar_link-list" aria-label="Primary">
    {%- if section.settings.use_custom_menu and section.settings.menu != blank -%}
      {%- for link in linklists[section.settings.menu].links -%}
        <a class="navbar_link" tabindex="-1" href="{{ link.url }}">{{ link.title }}</a>
      {%- endfor -%}
    {%- else -%}
      <a class="navbar_link" tabindex="-1" href="/#range">Range</a>
      <a class="navbar_link" tabindex="-1" href="/#benefits">Benefits</a>
      <a class="navbar_link" tabindex="-1" href="/#wear">Wear</a>
      <a class="navbar_link" tabindex="-1" href="/#faq">FAQ</a>
      <a class="navbar_link" tabindex="-1" href="{{ section.settings.cta_link | default: '/#range' }}">Newsletter</a>
    {%- endif -%}
  </nav>

  <div class="navbar_bottom">
    <a class="button is-full" tabindex="-1" href="{{ section.settings.cta_link | default: '/#range' }}">
      {{ section.settings.cta_text | default: 'Get early access' }}
    </a>
    <div class="navbar_socials-links">
      <a href="{{ section.settings.instagram_url | default: 'https://www.instagram.com/drinkasmaan' }}" target="_blank" rel="noreferrer" class="button is-secondary is-social" tabindex="-1" aria-label="Instagram">
        <svg viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <rect x="3.5" y="3.5" width="17" height="17" rx="5"></rect>
          <circle cx="12" cy="12" r="4"></circle>
          <circle cx="17.2" cy="6.8" r="0.9" fill="currentColor" stroke="none"></circle>
        </svg>
      </a>
      <div class="text-size-tiny text-white/50">&copy; {{ 'now' | date: '%Y' }} {{ section.settings.wordmark | default: 'ASMAAN' }}</div>
      <a class="button is-secondary is-social" tabindex="-1" href="/pages/contact">Contact</a>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Asmaan Navbar",
  "tag": "div",
  "class": "asmaan-navbar-section",
  "settings": [
    {
      "type": "header",
      "content": "Announcement Marquee"
    },
    {
      "type": "checkbox",
      "id": "show_announcement",
      "label": "Show Announcement Marquee Bar",
      "default": true
    },
    {
      "type": "text",
      "id": "announcement_text",
      "label": "Announcement Text",
      "default": "FOUNDERS BATCH NOW LIVE • 100% BOTANICAL FOCUS TONIC • FREE SHIPPING OVER ₹999 • ZERO SUGAR • ZERO JITTERS"
    },
    {
      "type": "url",
      "id": "announcement_link",
      "label": "Announcement Link"
    },
    {
      "type": "header",
      "content": "Branding & Call to Action"
    },
    {
      "type": "text",
      "id": "wordmark",
      "label": "Wordmark",
      "default": "ASMAAN"
    },
    {
      "type": "text",
      "id": "cta_text",
      "label": "CTA Button Text",
      "default": "Get Early Access"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "CTA Button Link"
    },
    {
      "type": "header",
      "content": "Labels & Menu"
    },
    {
      "type": "text",
      "id": "motion_text",
      "label": "Motion Toggle Label",
      "default": "Motion"
    },
    {
      "type": "text",
      "id": "menu_text",
      "label": "Menu Toggle Label",
      "default": "Menu"
    },
    {
      "type": "checkbox",
      "id": "use_custom_menu",
      "label": "Use Custom Menu from Shopify Navigation",
      "default": false
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Custom Menu (if enabled above)"
    },
    {
      "type": "url",
      "id": "instagram_url",
      "label": "Instagram URL"
    }
  ],
  "presets": [
    {
      "name": "Asmaan Navbar"
    }
  ]
}
{% endschema %}
