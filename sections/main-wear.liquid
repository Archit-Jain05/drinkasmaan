<div id="top">
  {%- comment -%}
    The clothing page: a drop teaser, not a shop.
    One full-bleed picture (or interactive fallback ambient canvas), one button,
    one warning line, and the drop waitlist modal dialog.
  {%- endcomment -%}

  <section id="wear-hero" class="wear_hero" aria-label="{{ section.settings.title | default: 'Wear' }}">
    <!-- Parallax media wrapper -->
    <div class="wear_media" data-wear-media>
      <div class="wear_fallback" aria-hidden="true">
        <span class="wear_fallback-mark">{{ section.settings.wordmark | default: 'ASMAAN' }}</span>
      </div>

      {%- if section.settings.image != blank -%}
        <img
          src="{{ section.settings.image | image_url: width: 2400 }}"
          width="{{ section.settings.image.width }}"
          height="{{ section.settings.image.height }}"
          alt="{{ section.settings.title | default: 'Asmaan clothing' | escape }}"
          class="wear_photo"
          loading="eager"
          fetchpriority="high"
          onerror="this.style.display='none'"
        >
      {%- endif -%}
    </div>

    <!-- Foreground Content -->
    <div class="wear_content">
      <h1 class="sr-only">
        {{ shop.name }} — {{ section.settings.title | default: 'Wear' }}
      </h1>

      <button type="button" class="wear_cta" data-drop-modal-open aria-haspopup="dialog" aria-expanded="false">
        {{ section.settings.cta_text | default: 'Get notified' }}
        {% render 'asmaan-icons', name: 'star', class: 'wear_cta-star' %}
      </button>

      <p class="wear_line">
        {{ section.settings.line_text | default: 'Drops land without warning. If you are not on the list, you will miss it.' }}
      </p>
    </div>
  </section>

  <!-- Drop Waitlist Modal Dialog -->
  <div
    id="drop-modal"
    class="drop_modal"
    data-open="false"
    aria-hidden="true"
    role="dialog"
    aria-modal="true"
    aria-labelledby="drop-title"
  >
    <div class="drop_sheet" role="document">
      <button
        type="button"
        class="drop_close"
        data-drop-modal-close
        aria-label="{{ section.settings.modal_close_text | default: 'Close' }}"
      >
        <span class="sr-only">{{ section.settings.modal_close_text | default: 'Close' }}</span>
        {% render 'asmaan-icons', name: 'cross', class: 'h-3 w-3' %}
      </button>

      <h2 id="drop-title" class="heading-style-h2">
        {{ section.settings.modal_title | default: 'On the list' }}
      </h2>
      <p class="mt-[var(--pad-s)] text-white/70">
        {{ section.settings.modal_body | default: 'One mail, the morning the drop goes live. Nothing else, ever.' }}
      </p>

      <div class="drop-form-wrapper mt-[var(--pad-l)] text-left">
        {%- form 'customer', class: 'drop-customer-form', id: 'WearDropForm' -%}
          <input type="hidden" name="contact[tags]" value="{{ section.settings.waitlist_tags | escape }}">

          {%- if form.posted_successfully? -%}
            <p class="text-size-medium text-center text-white" role="status" aria-live="polite">
              {{ section.settings.modal_success | default: "You're on. Watch your inbox the morning it lands." }}
            </p>
          {%- else -%}
            <div class="newsletter_field relative">
              <input
                id="drop-email"
                type="email"
                name="contact[email]"
                required
                autocomplete="email"
                placeholder=" "
                class="newsletter_input"
                value="{{ form.email }}"
                aria-required="true"
                {% if form.errors %}aria-invalid="true" aria-describedby="drop-error"{% endif %}
              >
              <label for="drop-email" class="newsletter_label">
                {{ section.settings.modal_placeholder | default: 'Your email address' }}
              </label>
            </div>

            {%- if form.errors -%}
              <p id="drop-error" class="mt-[var(--pad-xxs)] text-size-small text-[#ff7676]" role="alert">
                {{ form.errors.translated_fields['email'] | capitalize }} {{ form.errors.messages['email'] | default: "That address didn't look right. Try again?" }}
              </p>
            {%- endif -%}

            <button
              type="submit"
              class="button is-full mt-[var(--pad-m)]"
            >
              {{ section.settings.modal_cta | default: 'Notify me' }}
            </button>
          {%- endif -%}
        {%- endform -%}
      </div>
    </div>
  </div>
</div>

<script>
  (function() {
    function initWearPage() {
      var hero = document.getElementById('wear-hero');
      var media = hero ? hero.querySelector('[data-wear-media]') : null;
      var modal = document.getElementById('drop-modal');
      var openBtns = document.querySelectorAll('[data-drop-modal-open]');
      var closeBtns = document.querySelectorAll('[data-drop-modal-close]');
      var emailInput = document.getElementById('drop-email');

      // Parallax effect on scroll
      var PARALLAX = 0.25;
      var ticking = false;

      function onScroll() {
        if (!ticking) {
          window.requestAnimationFrame(function() {
            if (hero && media) {
              var scrollY = window.pageYOffset || document.documentElement.scrollTop;
              var top = hero.offsetTop;
              media.style.transform = 'translate3d(0, ' + ((scrollY - top) * PARALLAX) + 'px, 0)';
            }
            ticking = false;
          });
          ticking = true;
        }
      }

      window.addEventListener('scroll', onScroll, { passive: true });
      onScroll();

      // Modal open / close handlers
      function openModal() {
        if (!modal) return;
        modal.setAttribute('data-open', 'true');
        modal.setAttribute('aria-hidden', 'false');
        document.body.style.overflow = 'hidden';
        openBtns.forEach(function(btn) { btn.setAttribute('aria-expanded', 'true'); });
        if (emailInput) {
          setTimeout(function() { emailInput.focus(); }, 100);
        }
      }

      function closeModal() {
        if (!modal) return;
        modal.setAttribute('data-open', 'false');
        modal.setAttribute('aria-hidden', 'true');
        document.body.style.overflow = '';
        openBtns.forEach(function(btn) { btn.setAttribute('aria-expanded', 'false'); });
      }

      openBtns.forEach(function(btn) {
        btn.addEventListener('click', openModal);
      });

      closeBtns.forEach(function(btn) {
        btn.addEventListener('click', closeModal);
      });

      if (modal) {
        modal.addEventListener('click', function(e) {
          if (e.target === modal) closeModal();
        });
      }

      window.addEventListener('keydown', function(e) {
        if (e.key === 'Escape' && modal && modal.getAttribute('data-open') === 'true') {
          closeModal();
        }
      });

      // Auto-open modal if posted with error or success
      var formSuccess = modal ? modal.querySelector('[role="status"]') : null;
      var formError = modal ? modal.querySelector('[role="alert"]') : null;
      if (formSuccess || formError) {
        openModal();
      }
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initWearPage);
    } else {
      initWearPage();
    }
  })();
</script>

{% schema %}
{
  "name": "Wear Drop Teaser",
  "tag": "section",
  "class": "asmaan-wear-page-section",
  "settings": [
    {
      "type": "header",
      "content": "Hero Configuration"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Page Title",
      "default": "Wear"
    },
    {
      "type": "text",
      "id": "wordmark",
      "label": "Brand Wordmark Watermark",
      "default": "ASMAAN"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Lifestyle Hero Image",
      "info": "Leave blank to display the built-in ambient atmosphere fallback composition."
    },
    {
      "type": "text",
      "id": "cta_text",
      "label": "Hero Button Text",
      "default": "Get notified"
    },
    {
      "type": "textarea",
      "id": "line_text",
      "label": "Teaser Warning Line",
      "default": "Drops land without warning. If you are not on the list, you will miss it."
    },
    {
      "type": "header",
      "content": "Drop Waitlist Modal"
    },
    {
      "type": "text",
      "id": "modal_title",
      "label": "Modal Heading",
      "default": "On the list"
    },
    {
      "type": "textarea",
      "id": "modal_body",
      "label": "Modal Subtitle",
      "default": "One mail, the morning the drop goes live. Nothing else, ever."
    },
    {
      "type": "text",
      "id": "modal_placeholder",
      "label": "Email Input Label",
      "default": "Your email address"
    },
    {
      "type": "text",
      "id": "modal_cta",
      "label": "Modal Button Text",
      "default": "Notify me"
    },
    {
      "type": "text",
      "id": "modal_close_text",
      "label": "Close Button Text",
      "default": "Close"
    },
    {
      "type": "textarea",
      "id": "modal_success",
      "label": "Success Message",
      "default": "You're on. Watch your inbox the morning it lands."
    },
    {
      "type": "text",
      "id": "waitlist_tags",
      "label": "Customer tags",
      "default": "newsletter,wear-drop-waitlist"
    }
  ],
  "presets": [
    {
      "name": "Wear Drop Teaser"
    }
  ]
}
{% endschema %}
