<div class="min-h-screen flex flex-col items-center justify-center text-center px-4 bg-black text-white">
  <div class="loader_mark mb-6">
    ASMAAN
    <span class="loader_tagline">AMBITION TONIC</span>
  </div>
  <h1 class="text-3xl font-bold tracking-tight mb-4">Opening soon</h1>
  <p class="text-white/70 max-w-md mb-8">We are preparing the first batch. Enter your store password below to enter.</p>
  {%- form 'storefront_password', class: 'w-full max-w-sm flex gap-2' -%}
    <input
      type="password"
      name="password"
      placeholder="Store password"
      class="flex-1 bg-white/10 border border-white/20 rounded-full px-5 py-3 text-white placeholder-white/40 focus:outline-none focus:border-white"
    >
    <button type="submit" class="button">Enter</button>
  {%- endform -%}
</div>

{% schema %}
{
  "name": "Password Page",
  "settings": []
}
{% endschema %}
