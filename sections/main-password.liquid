{{ 'asmaan-prelaunch.css' | asset_url | stylesheet_tag }}

<section class="prelaunch" data-prelaunch data-sheet-url="{{ section.settings.sheet_url }}">
  <div class="prelaunch_inner">
    <div class="loader_mark prelaunch_mark">
      ASMAAN
      <span class="loader_tagline is-visible">AMBITION TONIC</span>
    </div>

    <h1 class="prelaunch_title">{{ section.settings.heading | escape }}</h1>
    <p class="prelaunch_lead">{{ section.settings.subheading | escape }}</p>

    <div class="prelaunch_stock" data-pl-stock data-total="{{ section.settings.total }}" data-per="{{ section.settings.per_registration }}" hidden>
      <div class="prelaunch_stock-row">
        <span>{{ section.settings.stock_label | escape }}</span>
        <span class="prelaunch_stock-count" aria-live="polite"><b data-pl-left>{{ section.settings.total }}</b> / {{ section.settings.total }}</span>
      </div>
      <div class="prelaunch_stock-bar"><span data-pl-bar></span></div>
    </div>

    <div class="prelaunch_card">
      {%- form 'contact', id: 'prelaunch-form', class: 'prelaunch_form', novalidate: 'novalidate' -%}
        <input type="hidden" name="contact[tags]" value="prelaunch, free-sample">
        <input type="hidden" name="contact[subject]" value="Free sample request">

        <div class="prelaunch_field">
          <label for="pl-name">{{ section.settings.label_name | escape }}</label>
          <input id="pl-name" name="contact[name]" type="text" autocomplete="name" required>
        </div>
        <div class="prelaunch_field">
          <label for="pl-email">{{ section.settings.label_email | escape }}</label>
          <input id="pl-email" name="contact[email]" type="email" autocomplete="email" required>
        </div>
        <div class="prelaunch_field">
          <label for="pl-address">{{ section.settings.label_address | escape }}</label>
          <textarea id="pl-address" name="contact[body]" rows="3" autocomplete="street-address" required></textarea>
        </div>

        <p class="prelaunch_error" data-pl-error role="alert" hidden></p>
        <button type="submit" class="prelaunch_btn" data-pl-submit>{{ section.settings.button | escape }}</button>
        <p class="prelaunch_note">{{ section.settings.note | escape }}</p>
      {%- endform -%}

      <div class="prelaunch_done" data-pl-done hidden tabindex="-1">
        <svg viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M5 12.5l4.5 4.5L19 7.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
        <h2>{{ section.settings.done_title | escape }}</h2>
        <p>{{ section.settings.done_text | escape }}</p>
      </div>
    </div>

    <details class="prelaunch_owner">
      <summary>Store owner? Enter with password</summary>
      {%- form 'storefront_password', class: 'prelaunch_pw' -%}
        <input type="password" name="password" placeholder="Store password" aria-label="Store password">
        <button type="submit">Enter</button>
        {%- if form.errors -%}<span class="prelaunch_pw-err">Wrong password</span>{%- endif -%}
      {%- endform -%}
    </details>
  </div>
</section>

<script src="{{ 'asmaan-prelaunch.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Prelaunch",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Get a free sample before anyone else" },
    { "type": "textarea", "id": "subheading", "label": "Subheading", "default": "Asmaan is almost here. Leave your details and we will send you a can to try." },
    { "type": "text", "id": "label_name", "label": "Name label", "default": "Full name" },
    { "type": "text", "id": "label_email", "label": "Email label", "default": "Email" },
    { "type": "text", "id": "label_address", "label": "Address label", "default": "Delivery address" },
    { "type": "text", "id": "button", "label": "Button", "default": "Request my free sample" },
    { "type": "text", "id": "note", "label": "Note under button", "default": "Free. No payment needed." },
    { "type": "text", "id": "done_title", "label": "Success title", "default": "You're on the list" },
    { "type": "textarea", "id": "done_text", "label": "Success text", "default": "Thank you! Our team will reach out to you soon. A confirmation is on its way to your inbox." },
    { "type": "text", "id": "stock_label", "label": "Counter label", "default": "Free sample cans left" },
    { "type": "number", "id": "total", "label": "Total cans", "default": 1000 },
    { "type": "number", "id": "per_registration", "label": "Cans per registration", "default": 6 },
    { "type": "text", "id": "sheet_url", "label": "Google Apps Script URL", "info": "Web app URL that saves to the sheet and sends the emails. See PRELAUNCH_SETUP.md." }
  ]
}
{% endschema %}
