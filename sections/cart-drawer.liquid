{%- assign threshold = settings.free_shipping_threshold | default: 99900 -%}

<div id="cart-drawer-overlay" class="cart-drawer-overlay pointer-events-none opacity-0" aria-hidden="true"></div>

<aside id="cart-drawer" class="cart-drawer translate-x-full" role="dialog" aria-modal="true" aria-labelledby="cart-drawer-title" aria-hidden="true">
  <!-- Drawer Header -->
  <div class="cart-drawer-header">
    <div class="flex items-center">
      <h2 id="cart-drawer-title">
        {{ 'cart.general.title' | t | default: 'Your Cart' }}
      </h2>
      <span class="cart-drawer-badge" id="cart-drawer-count">
        {{ cart.item_count }}
      </span>
    </div>
    <button type="button" id="cart-drawer-close" class="cart-drawer-close-btn" aria-label="{{ 'accessibility.close' | t | default: 'Close cart' }}">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
        <line x1="18" y1="6" x2="6" y2="18"></line>
        <line x1="6" y1="6" x2="18" y2="18"></line>
      </svg>
    </button>
  </div>

  <!-- Free Shipping Progress Bar -->
  {%- if settings.show_free_shipping_bar != false -%}
    <div class="cart-drawer-shipping" id="cart-drawer-shipping">
      {%- assign progress = cart.total_price | times: 100 | divided_by: threshold -%}
      {%- if progress > 100 -%}{%- assign progress = 100 -%}{%- endif -%}
      <div class="cart-drawer-shipping-text">
        {%- if cart.total_price >= threshold -%}
          <span style="color: #34d399; font-weight: bold;">&check; {{ 'cart.general.free_shipping_unlocked' | t | default: 'Free Shipping Unlocked!' }}</span>
        {%- else -%}
          {%- assign remaining = threshold | minus: cart.total_price -%}
          <span>Add <strong style="color: #fff;">{{ remaining | money }}</strong> for Free Shipping</span>
        {%- endif -%}
        <span style="color: rgba(255,255,255,0.4);">{{ progress }}%</span>
      </div>
      <div class="cart-drawer-progress-track">
        <div class="cart-drawer-progress-bar" style="width: {{ progress }}%;"></div>
      </div>
    </div>
  {%- endif -%}

  <!-- Drawer Body: Line Items or Empty State -->
  <div class="cart-drawer-body" id="cart-drawer-items">
    {%- if cart.item_count > 0 -%}
      {%- for item in cart.items -%}
        <div class="cart-drawer-item" data-line-key="{{ item.key }}" data-line-index="{{ forloop.index }}">
          <div class="cart-drawer-item-img">
            {%- if item.image -%}
              <img src="{{ item.image | image_url: width: 140 }}" width="{{ item.image.width }}" height="{{ item.image.height }}" alt="{{ item.title | escape }}" loading="lazy">
            {%- elsif item.product.featured_image -%}
              <img src="{{ item.product.featured_image | image_url: width: 140 }}" width="{{ item.product.featured_image.width }}" height="{{ item.product.featured_image.height }}" alt="{{ item.title | escape }}" loading="lazy">
            {%- endif -%}
          </div>
          <div class="cart-drawer-item-details">
            <h3 class="cart-drawer-item-title">{{ item.product.title }}</h3>
            {%- unless item.product.has_only_default_variant -%}
              <p class="cart-drawer-item-variant">{{ item.variant.title }}</p>
            {%- endunless -%}
            <div class="cart-drawer-item-price">{{ item.final_price | money }}</div>

            <div class="cart-drawer-item-actions">
              <div class="cart-drawer-qty-wrap">
                <button type="button" data-cart-qty-btn="-1" aria-label="Decrease quantity">&minus;</button>
                <span data-cart-qty>{{ item.quantity }}</span>
                <button type="button" data-cart-qty-btn="1" aria-label="Increase quantity">&plus;</button>
              </div>
              <button type="button" class="cart-drawer-remove-btn" data-cart-remove-btn aria-label="{{ 'cart.general.remove' | t | default: 'Remove' }}">
                &times; {{ 'cart.general.remove' | t | default: 'Remove' }}
              </button>
            </div>
          </div>
        </div>
      {%- endfor -%}
    {%- else -%}
      <div class="cart-drawer-empty" id="cart-drawer-empty">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
          <circle cx="9" cy="21" r="1"></circle>
          <circle cx="20" cy="21" r="1"></circle>
          <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path>
        </svg>
        <p class="cart-drawer-empty-text">{{ 'cart.general.empty' | t | default: 'Your cart is currently empty' }}</p>
        <button type="button" class="button is-small is-secondary" data-cart-continue-btn style="font-size: 12px; padding: 0.6rem 1.4rem;">
          {{ 'cart.general.continue_shopping' | t | default: 'Continue Shopping' }}
        </button>
      </div>
    {%- endif -%}
  </div>

  <!-- Drawer Footer: Subtotal & Checkout -->
  {%- if cart.item_count > 0 -%}
    <div class="cart-drawer-footer" id="cart-drawer-footer">
      {%- if settings.enable_order_notes != false -%}
        <details style="font-family: var(--font-mono, monospace); font-size: 12px;">
          <summary style="cursor: pointer; color: rgba(255,255,255,0.6); display: flex; justify-content: space-between;">
            <span>{{ 'cart.general.note' | t | default: 'Add order note' }}</span>
            <span>&darr;</span>
          </summary>
          <textarea id="cart-drawer-note" style="width: 100%; margin-top: 0.5rem; padding: 0.5rem; border-radius: 0.5rem; background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.1); color: #fff; font-size: 12px; box-sizing: border-box;" rows="2" placeholder="{{ 'cart.general.note_placeholder' | t | default: 'Special instructions...' }}">{{ cart.note }}</textarea>
        </details>
      {%- endif -%}

      <div class="cart-drawer-subtotal-row">
        <span>{{ 'cart.general.subtotal' | t | default: 'Subtotal' }}</span>
        <span id="cart-drawer-subtotal">{{ cart.total_price | money }}</span>
      </div>

      <p style="font-family: var(--font-mono, monospace); font-size: 11px; color: rgba(255,255,255,0.4); text-align: center; margin: 0;">
        {{ 'cart.general.shipping_at_checkout' | t | default: 'Taxes and shipping calculated at checkout' }}
      </p>

      <form action="/checkout" method="post" style="margin: 0;">
        <button type="submit" name="checkout" class="cart-drawer-checkout-btn">
          {{ 'cart.general.checkout' | t | default: 'Check Out' }} &rarr;
        </button>
      </form>
    </div>
  {%- endif -%}
</aside>

<style>
  /* -------------------------------------------------------------
     Self-Contained Asmaan Cart Drawer Styles
     ------------------------------------------------------------- */
  #cart-drawer-overlay {
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    background: rgba(0, 0, 0, 0.75);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    z-index: 99998;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }
  #cart-drawer-overlay.is-active {
    opacity: 1 !important;
    pointer-events: auto !important;
  }

  #cart-drawer {
    position: fixed;
    top: 0;
    right: 0;
    bottom: 0;
    width: 100%;
    max-width: 440px;
    height: 100vh;
    background: #0d0d11;
    border-left: 1px solid rgba(255, 255, 255, 0.12);
    z-index: 99999;
    display: flex;
    flex-direction: column;
    transform: translateX(100%);
    transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1);
    box-shadow: -15px 0 45px rgba(0, 0, 0, 0.85);
    color: #ffffff;
    font-family: var(--font-sans, -apple-system, sans-serif);
    box-sizing: border-box;
  }
  #cart-drawer.is-active,
  #cart-drawer[aria-hidden="false"] {
    transform: translateX(0) !important;
  }

  .cart-drawer-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1.5rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
  }
  .cart-drawer-header h2 {
    margin: 0;
    font-family: var(--font-mono, monospace);
    font-size: 0.95rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: #fff;
  }
  .cart-drawer-badge {
    font-family: var(--font-mono, monospace);
    font-size: 12px;
    padding: 0.15rem 0.5rem;
    border-radius: 9999px;
    background: rgba(255, 255, 255, 0.1);
    color: rgba(255, 255, 255, 0.8);
    margin-left: 0.5rem;
  }
  .cart-drawer-close-btn {
    background: transparent;
    border: none;
    color: rgba(255, 255, 255, 0.6);
    cursor: pointer;
    padding: 0.4rem;
    border-radius: 0.5rem;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: color 0.2s, background 0.2s;
  }
  .cart-drawer-close-btn:hover {
    color: #fff;
    background: rgba(255, 255, 255, 0.08);
  }
  .cart-drawer-close-btn svg {
    width: 1.25rem;
    height: 1.25rem;
  }

  .cart-drawer-shipping {
    padding: 1rem 1.5rem;
    background: rgba(255, 255, 255, 0.02);
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    font-family: var(--font-mono, monospace);
    font-size: 12px;
  }
  .cart-drawer-shipping-text {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 0.5rem;
  }
  .cart-drawer-progress-track {
    width: 100%;
    height: 5px;
    background: rgba(255, 255, 255, 0.1);
    border-radius: 9999px;
    overflow: hidden;
  }
  .cart-drawer-progress-bar {
    height: 100%;
    background: linear-gradient(90deg, #9089d3 0%, #34d399 100%);
    border-radius: 9999px;
    transition: width 0.4s ease;
  }

  .cart-drawer-body {
    flex: 1;
    overflow-y: auto;
    padding: 1.5rem;
    box-sizing: border-box;
  }

  .cart-drawer-empty {
    height: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 2rem 1rem;
    box-sizing: border-box;
  }
  .cart-drawer-empty svg {
    width: 48px !important;
    height: 48px !important;
    max-width: 48px !important;
    max-height: 48px !important;
    color: rgba(255, 255, 255, 0.25) !important;
    margin: 0 auto 1.25rem !important;
    display: block !important;
  }
  .cart-drawer-empty-text {
    font-family: var(--font-mono, monospace);
    font-size: 0.85rem;
    color: rgba(255, 255, 255, 0.6);
    margin: 0 0 1.5rem 0;
  }

  .cart-drawer-item {
    display: flex;
    gap: 1rem;
    padding: 1rem 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }
  .cart-drawer-item:first-child { padding-top: 0; }
  .cart-drawer-item:last-child { border-bottom: none; }
  .cart-drawer-item-img {
    width: 4.5rem;
    height: 4.5rem;
    border-radius: 0.75rem;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.1);
    padding: 0.4rem;
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    box-sizing: border-box;
  }
  .cart-drawer-item-img img {
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
  }
  .cart-drawer-item-details {
    flex: 1;
    min-width: 0;
  }
  .cart-drawer-item-title {
    font-size: 0.9rem;
    font-weight: 700;
    color: #fff;
    margin: 0 0 0.25rem 0;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .cart-drawer-item-variant {
    font-family: var(--font-mono, monospace);
    font-size: 12px;
    color: rgba(255, 255, 255, 0.5);
    margin: 0 0 0.5rem 0;
  }
  .cart-drawer-item-price {
    font-family: var(--font-mono, monospace);
    font-size: 0.85rem;
    color: rgba(255, 255, 255, 0.9);
    margin-bottom: 0.5rem;
  }
  .cart-drawer-item-actions {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .cart-drawer-qty-wrap {
    display: inline-flex;
    align-items: center;
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: 0.5rem;
    background: rgba(255, 255, 255, 0.05);
    overflow: hidden;
  }
  .cart-drawer-qty-wrap button {
    width: 1.75rem;
    height: 1.75rem;
    border: none;
    background: transparent;
    color: rgba(255, 255, 255, 0.7);
    cursor: pointer;
    font-size: 0.9rem;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background 0.2s, color 0.2s;
  }
  .cart-drawer-qty-wrap button:hover {
    background: rgba(255, 255, 255, 0.15);
    color: #fff;
  }
  .cart-drawer-qty-wrap span {
    width: 1.75rem;
    text-align: center;
    font-family: var(--font-mono, monospace);
    font-size: 12px;
    color: #fff;
    font-weight: 700;
  }
  .cart-drawer-remove-btn {
    border: none;
    background: transparent;
    color: rgba(244, 63, 94, 0.75);
    font-family: var(--font-mono, monospace);
    font-size: 12px;
    cursor: pointer;
    transition: color 0.2s;
    text-decoration: underline;
  }
  .cart-drawer-remove-btn:hover { color: rgb(244, 63, 94); }

  .cart-drawer-footer {
    padding: 1.5rem;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    background: #0d0d11;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .cart-drawer-subtotal-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-family: var(--font-mono, monospace);
  }
  .cart-drawer-subtotal-row span:first-child {
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: rgba(255, 255, 255, 0.6);
  }
  .cart-drawer-subtotal-row span:last-child {
    font-size: 1.1rem;
    font-weight: 700;
    color: #fff;
  }
  .cart-drawer-checkout-btn {
    width: 100%;
    padding: 0.9rem;
    border-radius: 9999px;
    background: #ffffff;
    color: #000000;
    font-family: var(--font-sans, sans-serif);
    font-weight: 700;
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    border: none;
    cursor: pointer;
    transition: opacity 0.2s, transform 0.2s;
  }
  .cart-drawer-checkout-btn:hover {
    opacity: 0.9;
    transform: translateY(-1px);
  }
</style>

{% schema %}
{
  "name": "Cart Drawer",
  "tag": "div",
  "class": "cart-drawer-section",
  "settings": []
}
{% endschema %}
