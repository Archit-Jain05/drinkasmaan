{%- assign threshold = settings.free_shipping_threshold | default: 99900 -%}

<div id="cart-drawer-overlay" class="fixed inset-0 bg-black/75 backdrop-blur-sm z-50 transition-opacity duration-300 opacity-0 pointer-events-none" aria-hidden="true"></div>

<aside id="cart-drawer" class="fixed top-0 right-0 h-full w-full max-w-md bg-[#0a0a0f] border-l border-white/10 z-50 flex flex-col transform translate-x-full transition-transform duration-300 ease-out shadow-2xl text-white" role="dialog" aria-modal="true" aria-labelledby="cart-drawer-title" aria-hidden="true">
  <!-- Drawer Header -->
  <div class="flex items-center justify-between p-6 border-b border-white/10">
    <div class="flex items-center gap-3">
      <h2 id="cart-drawer-title" class="font-mono text-base uppercase tracking-[0.2em] font-bold">
        {{ 'cart.general.title' | t: default: 'Your Cart' }}
      </h2>
      <span class="font-mono text-xs px-2 py-0.5 rounded-full bg-white/10 text-white/70" id="cart-drawer-count">
        {{ cart.item_count }}
      </span>
    </div>
    <button type="button" id="cart-drawer-close" class="p-2 text-white/60 hover:text-white rounded-lg hover:bg-white/5 transition-colors" aria-label="{{ 'accessibility.close' | t: default: 'Close cart' }}">
      <svg viewBox="0 0 24 24" class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
        <line x1="18" y1="6" x2="6" y2="18"></line>
        <line x1="6" y1="6" x2="18" y2="18"></line>
      </svg>
    </button>
  </div>

  <!-- Free Shipping Progress Bar -->
  {%- if settings.show_free_shipping_bar != false -%}
    <div class="px-6 py-4 bg-white/[0.02] border-b border-white/10" id="cart-drawer-shipping">
      {%- assign progress = cart.total_price | times: 100 | divided_by: threshold -%}
      {%- if progress > 100 -%}{%- assign progress = 100 -%}{%- endif -%}
      <div class="flex justify-between items-center text-xs font-mono mb-2">
        {%- if cart.total_price >= threshold -%}
          <span class="text-emerald-400 font-bold">&check; {{ 'cart.general.free_shipping_unlocked' | t: default: 'Free Shipping Unlocked!' }}</span>
        {%- else -%}
          {%- assign remaining = threshold | minus: cart.total_price -%}
          <span class="text-white/80">Add <strong class="text-white">{{ remaining | money }}</strong> for Free Shipping</span>
        {%- endif -%}
        <span class="text-white/40">{{ progress }}%</span>
      </div>
      <div class="w-full h-1.5 bg-white/10 rounded-full overflow-hidden">
        <div class="h-full bg-gradient-to-r from-[#9089D3] to-emerald-400 rounded-full transition-all duration-500" style="width: {{ progress }}%;"></div>
      </div>
    </div>
  {%- endif -%}

  <!-- Drawer Body: Line Items or Empty State -->
  <div class="flex-1 overflow-y-auto p-6 divide-y divide-white/10" id="cart-drawer-items">
    {%- if cart.item_count > 0 -%}
      {%- for item in cart.items -%}
        <div class="py-4 flex gap-4 first:pt-0 last:pb-0" data-line-key="{{ item.key }}" data-line-index="{{ forloop.index }}">
          <div class="w-20 h-20 rounded-xl bg-white/[0.03] border border-white/10 p-2 flex-shrink-0 flex items-center justify-center">
            {%- if item.image -%}
              <img src="{{ item.image | image_url: width: 140 }}" alt="{{ item.title | escape }}" class="max-h-full max-w-full object-contain">
            {%- elsif item.product.featured_image -%}
              <img src="{{ item.product.featured_image | image_url: width: 140 }}" alt="{{ item.title | escape }}" class="max-h-full max-w-full object-contain">
            {%- endif -%}
          </div>
          <div class="flex-1 min-w-0">
            <h3 class="font-bold text-sm text-white truncate">{{ item.product.title }}</h3>
            {%- unless item.product.has_only_default_variant -%}
              <p class="font-mono text-xs text-white/50 mt-0.5 truncate">{{ item.variant.title }}</p>
            {%- endunless -%}
            <div class="font-mono text-xs text-white/80 mt-1">{{ item.final_price | money }}</div>

            <div class="flex items-center justify-between mt-3">
              <div class="flex items-center rounded-lg border border-white/20 bg-white/5">
                <button type="button" class="w-7 h-7 flex items-center justify-center text-white/60 hover:text-white transition-colors" data-cart-qty-btn="-1" aria-label="Decrease quantity">&minus;</button>
                <span class="w-7 text-center font-mono text-xs text-white font-bold" data-cart-qty>{{ item.quantity }}</span>
                <button type="button" class="w-7 h-7 flex items-center justify-center text-white/60 hover:text-white transition-colors" data-cart-qty-btn="1" aria-label="Increase quantity">&plus;</button>
              </div>
              <button type="button" class="text-xs font-mono text-rose-400/80 hover:text-rose-400 transition-colors" data-cart-remove-btn aria-label="{{ 'cart.general.remove' | t: default: 'Remove' }}">
                &times; Remove
              </button>
            </div>
          </div>
        </div>
      {%- endfor -%}
    {%- else -%}
      <div class="h-full flex flex-col items-center justify-center text-center py-12">
        <svg viewBox="0 0 24 24" class="w-12 h-12 text-white/20 mb-4" fill="none" stroke="currentColor" stroke-width="1">
          <circle cx="9" cy="21" r="1"></circle>
          <circle cx="20" cy="21" r="1"></circle>
          <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path>
        </svg>
        <p class="font-mono text-sm text-white/60 mb-6">{{ 'cart.general.empty' | t: default: 'Your cart is currently empty' }}</p>
        <button type="button" class="button is-small is-secondary !text-xs" data-cart-continue-btn>
          {{ 'cart.general.continue_shopping' | t: default: 'Continue Shopping' }}
        </button>
      </div>
    {%- endif -%}
  </div>

  <!-- Drawer Footer: Subtotal & Checkout -->
  {%- if cart.item_count > 0 -%}
    <div class="p-6 border-t border-white/10 bg-[#0a0a0f]/95 flex flex-col gap-4" id="cart-drawer-footer">
      {%- if settings.enable_order_notes != false -%}
        <details class="text-xs font-mono group">
          <summary class="cursor-pointer text-white/60 hover:text-white flex items-center justify-between">
            <span>{{ 'cart.general.note' | t: default: 'Add order note' }}</span>
            <span class="group-open:rotate-180 transition-transform">&darr;</span>
          </summary>
          <textarea id="cart-drawer-note" class="w-full mt-2 p-2 rounded-lg bg-white/5 border border-white/10 text-white placeholder-white/30 text-xs focus:outline-none focus:border-white/30" rows="2" placeholder="{{ 'cart.general.note_placeholder' | t: default: 'Special instructions...' }}">{{ cart.note }}</textarea>
        </details>
      {%- endif -%}

      <div class="flex items-center justify-between font-mono">
        <span class="text-xs uppercase tracking-wider text-white/60">{{ 'cart.general.subtotal' | t: default: 'Subtotal' }}</span>
        <span class="text-base font-bold text-white" id="cart-drawer-subtotal">{{ cart.total_price | money }}</span>
      </div>

      <p class="text-[11px] font-mono text-white/40 text-center">
        {{ 'cart.general.shipping_at_checkout' | t: default: 'Taxes and shipping calculated at checkout' }}
      </p>

      <form action="/checkout" method="post">
        <button type="submit" name="checkout" class="button is-primary is-full !text-xs uppercase tracking-widest py-3 font-bold">
          {{ 'cart.general.checkout' | t: default: 'Check Out' }} &rarr;
        </button>
      </form>
    </div>
  {%- endif -%}
</aside>

{% schema %}
{
  "name": "Cart Drawer",
  "tag": "div",
  "class": "cart-drawer-section",
  "settings": []
}
{% endschema %}