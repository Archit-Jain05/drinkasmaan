{%- if settings.predictive_search_enabled != false -%}
<div id="predictive-search-modal" class="predictive-search-modal" role="dialog" aria-modal="true" aria-label="{{ 'general.search.search' | t | default: 'Search' }}">
  <!-- Backdrop -->
  <div class="predictive-search-backdrop" data-search-close></div>

  <!-- Search Panel -->
  <div class="predictive-search-panel">
    <!-- Search Input Header -->
    <div class="predictive-search-header">
      <form action="{{ routes.search_url }}" method="get" role="search" class="predictive-search-form">
        <span class="predictive-search-icon-left">
          {% render 'asmaan-icons', name: 'search', class: 'w-5 h-5' %}
        </span>
        <input
          type="search"
          name="q"
          id="predictive-search-input"
          class="predictive-search-input"
          placeholder="{{ 'general.search.placeholder' | t | default: 'Search products, collections, stories...' }}"
          autocomplete="off"
          autocorrect="off"
          autocapitalize="off"
          spellcheck="false"
        >
        <div class="predictive-search-actions">
          <button
            type="button"
            id="predictive-search-clear"
            class="predictive-search-clear-btn"
            style="display: none;"
            aria-label="{{ 'accessibility.close' | t | default: 'Clear' }}"
          >
            {% render 'asmaan-icons', name: 'cross', class: 'w-3.5 h-3.5' %}
          </button>
          <button
            type="button"
            class="predictive-search-esc-badge"
            data-search-close
            aria-label="{{ 'accessibility.close' | t | default: 'Close' }}"
          >
            ESC
          </button>
        </div>
      </form>
    </div>

    <!-- Live Search Content & Suggestions -->
    <div id="predictive-search-results" class="predictive-search-body">
      <!-- Default Trending / Quick Links (shown when query is empty) -->
      <div id="predictive-search-default">
        <div>
          <h4 style="font-family: var(--font-mono, monospace); font-size: 11px; letter-spacing: 0.15em; text-transform: uppercase; color: rgba(255,255,255,0.4); margin: 0 0 0.75rem 0;">
            {{ 'general.search.popular_searches' | t | default: 'Popular Searches' }}
          </h4>
          <div class="predictive-search-tag-group">
            {%- assign popular_terms = section.settings.popular_searches | newline_to_br | split: '<br />' -%}
            {%- for term in popular_terms -%}
              {%- assign term_text = term | strip -%}
              {%- if term_text != blank -%}
                <button type="button" class="predictive-search-tag" data-search-term="{{ term_text | escape }}">{{ term_text | escape }}</button>
              {%- endif -%}
            {%- endfor -%}
          </div>
        </div>
      </div>

      <!-- Spinner -->
      <div id="predictive-search-loading" style="display: none; padding: 3rem 0; text-align: center;">
        <div style="width: 1.5rem; height: 1.5rem; border: 2px solid rgba(255,255,255,0.2); border-top-color: #fff; border-radius: 50%; display: inline-block; animation: asmaan-spin 0.8s linear infinite;"></div>
      </div>

      <!-- Live Dynamic Results -->
      <div id="predictive-search-dynamic" style="display: none;">
        <!-- Injected via JS -->
      </div>
    </div>

    <!-- Footer Action -->
    <div id="predictive-search-footer" class="predictive-search-footer" style="display: none;">
      <span id="predictive-search-count" style="color: rgba(255,255,255,0.5);"></span>
      <a id="predictive-search-view-all" href="{{ routes.search_url }}" style="color: #fff; text-decoration: none; display: flex; items-center: center; gap: 0.25rem;">
        <span>{{ 'general.search.view_all' | t | default: 'View all results' }}</span>
        {% render 'asmaan-icons', name: 'arrow', class: 'w-3.5 h-3.5' %}
      </a>
    </div>
  </div>
</div>

<style>
  /* -------------------------------------------------------------
     Self-Contained Asmaan Predictive Search Styles
     ------------------------------------------------------------- */
  #predictive-search-modal {
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    z-index: 99999;
    display: none;
    align-items: flex-start;
    justify-content: center;
    padding: 3rem 1rem 1rem;
    box-sizing: border-box;
  }
  #predictive-search-modal.is-active {
    display: flex !important;
  }

  .predictive-search-backdrop {
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    background: rgba(0, 0, 0, 0.85);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    z-index: 1;
    opacity: 0;
    transition: opacity 0.3s ease;
  }
  #predictive-search-modal.is-active .predictive-search-backdrop {
    opacity: 1 !important;
  }

  .predictive-search-panel {
    position: relative;
    z-index: 2;
    width: 100%;
    max-width: 46rem;
    background: #111114;
    border: 1px solid rgba(255, 255, 255, 0.15);
    border-radius: 1.25rem;
    box-shadow: 0 30px 70px rgba(0, 0, 0, 0.95);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    max-height: 82vh;
    opacity: 0;
    transform: translateY(-12px);
    transition: opacity 0.3s ease, transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    box-sizing: border-box;
  }
  #predictive-search-modal.is-active .predictive-search-panel {
    opacity: 1 !important;
    transform: translateY(0) !important;
  }

  .predictive-search-header {
    padding: 1.25rem 1.5rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    position: relative;
  }
  .predictive-search-form {
    position: relative;
    display: flex;
    align-items: center;
    margin: 0;
  }
  .predictive-search-icon-left {
    position: absolute;
    left: 1rem;
    color: rgba(255, 255, 255, 0.4);
    display: flex;
    align-items: center;
    pointer-events: none;
  }
  .predictive-search-icon-left svg {
    width: 1.25rem;
    height: 1.25rem;
  }
  .predictive-search-input {
    width: 100%;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.15);
    border-radius: 0.85rem;
    padding: 0.85rem 6.5rem 0.85rem 3rem;
    font-size: 1rem;
    color: #fff;
    box-sizing: border-box;
    font-family: var(--font-sans, sans-serif);
    transition: border-color 0.2s, background 0.2s;
  }
  .predictive-search-input:focus {
    outline: none;
    border-color: rgba(255, 255, 255, 0.4);
    background: rgba(255, 255, 255, 0.08);
  }
  .predictive-search-actions {
    position: absolute;
    right: 0.75rem;
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  .predictive-search-clear-btn {
    background: transparent;
    border: none;
    color: rgba(255, 255, 255, 0.5);
    cursor: pointer;
    padding: 0.35rem;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .predictive-search-clear-btn:hover { color: #fff; }
  .predictive-search-esc-badge {
    background: rgba(255, 255, 255, 0.1);
    border: 1px solid rgba(255, 255, 255, 0.15);
    color: rgba(255, 255, 255, 0.6);
    font-family: var(--font-mono, monospace);
    font-size: 11px;
    padding: 0.25rem 0.5rem;
    border-radius: 0.35rem;
    cursor: pointer;
    text-transform: uppercase;
  }

  .predictive-search-body {
    flex: 1;
    overflow-y: auto;
    padding: 1.5rem;
    box-sizing: border-box;
  }
  .predictive-search-tag-group {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .predictive-search-tag {
    padding: 0.45rem 0.9rem;
    border-radius: 9999px;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.12);
    color: rgba(255, 255, 255, 0.85);
    font-size: 0.8rem;
    cursor: pointer;
    transition: background 0.2s, border-color 0.2s, color 0.2s;
  }
  .predictive-search-tag:hover {
    background: rgba(255, 255, 255, 0.15);
    color: #fff;
    border-color: rgba(255, 255, 255, 0.25);
  }

  .predictive-search-product-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 0.75rem;
    margin-top: 0.75rem;
  }
  .predictive-search-product-card {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.65rem;
    border-radius: 0.75rem;
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.08);
    text-decoration: none;
    color: inherit;
    transition: background 0.2s, border-color 0.2s;
    box-sizing: border-box;
  }
  .predictive-search-product-card:hover {
    background: rgba(255, 255, 255, 0.08);
    border-color: rgba(255, 255, 255, 0.2);
  }
  .predictive-search-product-img {
    width: 3.5rem;
    height: 3.5rem;
    border-radius: 0.5rem;
    background: rgba(255, 255, 255, 0.05);
    overflow: hidden;
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .predictive-search-product-img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .predictive-search-footer {
    padding: 1rem 1.5rem;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    background: rgba(255, 255, 255, 0.02);
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-family: var(--font-mono, monospace);
    font-size: 0.8rem;
  }

  @keyframes asmaan-spin {
    to { transform: rotate(360deg); }
  }
</style>
{%- endif -%}

<script type="application/json" id="predictive-search-labels">
  {
    "moneyFormat": {{ shop.money_format | json }},
    "noResults": {{ section.settings.label_no_results | json }},
    "noResultsHint": {{ section.settings.label_no_results_hint | json }},
    "products": {{ section.settings.label_products | json }},
    "collections": {{ section.settings.label_collections | json }},
    "info": {{ section.settings.label_info | json }},
    "article": {{ section.settings.label_article | json }},
    "page": {{ section.settings.label_page | json }},
    "soldOut": {{ section.settings.label_sold_out | json }},
    "showing": {{ section.settings.label_showing | json }},
    "error": {{ section.settings.label_error | json }}
  }
</script>

{% schema %}
{
  "name": "Predictive search",
  "settings": [
    { "type": "textarea", "id": "popular_searches", "label": "Popular searches", "default": "Botanical\nFocus Tonic\nZero Sugar\nHoodie\nTee", "info": "One search term per line." },
    { "type": "header", "content": "Labels" },
    { "type": "text", "id": "label_no_results", "label": "No results", "default": "No results found for \"{query}\"" },
    { "type": "text", "id": "label_no_results_hint", "label": "No results hint", "default": "Try checking your spelling or using more general terms." },
    { "type": "text", "id": "label_products", "label": "Products heading", "default": "Products ({count})" },
    { "type": "text", "id": "label_collections", "label": "Collections heading", "default": "Collections ({count})" },
    { "type": "text", "id": "label_info", "label": "Articles and pages heading", "default": "Stories & Info ({count})" },
    { "type": "text", "id": "label_article", "label": "Article", "default": "Article" },
    { "type": "text", "id": "label_page", "label": "Page", "default": "Page" },
    { "type": "text", "id": "label_sold_out", "label": "Sold out", "default": "Sold out" },
    { "type": "text", "id": "label_showing", "label": "Result count", "default": "Showing {count} suggestions" },
    { "type": "text", "id": "label_error", "label": "Error", "default": "An error occurred while fetching suggestions. Press Enter to view full results." }
  ]
}
{% endschema %}
