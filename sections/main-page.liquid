<section class="section relative bg-black text-white min-h-[60vh] py-16">
  <div class="padding-global">
    <div class="container-large max-w-4xl mx-auto px-4">
      <h1 class="text-3xl sm:text-5xl font-bold tracking-tight mb-8">{{ page.title }}</h1>
      <div class="prose prose-invert max-w-none text-white/80 leading-relaxed space-y-4">
        {{ page.content }}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Page Content",
  "settings": []
}
{% endschema %}
