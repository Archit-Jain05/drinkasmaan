{%- assign free_shipping_money = settings.free_shipping_threshold | money_without_trailing_zeros -%}
<section class="asmaan-subpage-section pt-24 pb-20">
  <div class="padding-global">
    <div class="container-large max-w-4xl mx-auto px-4">
      <div class="asmaan-subpage-hero text-left mb-16">
        <span class="font-mono text-xs uppercase tracking-[0.25em] text-[#9089D3] block mb-2">{{ section.settings.kicker | default: 'Our Origins • Manifesto' }}</span>
        <h1 class="text-4xl sm:text-6xl font-black uppercase tracking-tight text-white mb-6">{{ section.settings.title | default: 'The Ambition Tonic' }}</h1>
        <p class="text-white/80 text-base sm:text-lg leading-relaxed font-light">
          {{ section.settings.intro | default: 'Energy drinks were engineered for extreme sports and nightclub floors: saturated in 30g of refined sugars, synthetic taurine, and jittery caffeine spikes designed for rapid heart rates rather than sustained, quiet cognitive concentration.' }}
        </p>
      </div>

      <div class="space-y-16 text-white/80 text-sm sm:text-base leading-relaxed">
        <div class="p-8 sm:p-10 rounded-3xl bg-white/[0.02] border border-white/10 space-y-4">
          <span class="font-mono text-xs uppercase tracking-widest text-emerald-400 block">The Premise</span>
          <h2 class="text-2xl sm:text-3xl font-bold uppercase tracking-tight text-white">{{ section.settings.premise_title | default: 'Engineered For Modern Creators' }}</h2>
          <p>
            {{ section.settings.premise_p1 | default: 'We built Asmaan for programmers writing code at 2 AM, designers obsessing over typography, writers finishing their fifth draft, and founders building companies from nothing.' }}
          </p>
          <p class="text-white/60 text-sm">
            {{ section.settings.premise_p2 | default: "You don't need a heart-racing adrenaline spike. You need a calm, steady cognitive floor that holds you in flow state for four straight hours without anxiety, irritability, or an afternoon crash." }}
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
          <div class="p-6 rounded-2xl bg-white/[0.02] border border-white/10">
            <span class="font-mono text-xs uppercase tracking-widest text-[#9089D3] block mb-2">Pillar I</span>
            <h3 class="text-xl font-bold uppercase text-white mb-2">Raw Green Coffee</h3>
            <p class="text-white/60 text-xs leading-relaxed">
              We extract 100mg of caffeine from raw unroasted green coffee beans rather than synthetic lab compounds. It metabolizes smoothly and prevents the jagged spikes of energy shots.
            </p>
          </div>

          <div class="p-6 rounded-2xl bg-white/[0.02] border border-white/10">
            <span class="font-mono text-xs uppercase tracking-widest text-[#9089D3] block mb-2">Pillar II</span>
            <h3 class="text-xl font-bold uppercase text-white mb-2">Suntheanine &amp; KSM-66</h3>
            <p class="text-white/60 text-xs leading-relaxed">
              200mg L-theanine directly offsets peripheral jitters by stimulating alpha brain waves, while 300mg KSM-66 ashwagandha dampens stress and mental fatigue.
            </p>
          </div>

          <div class="p-6 rounded-2xl bg-white/[0.02] border border-white/10">
            <span class="font-mono text-xs uppercase tracking-widest text-[#9089D3] block mb-2">Pillar III</span>
            <h3 class="text-xl font-bold uppercase text-white mb-2">Zero Sugar &bull; 10 Calories</h3>
            <p class="text-white/60 text-xs leading-relaxed">
              No insulin rollercoasters. No brain fog. Fruit botanicals (Kala Jamun, Alphonso Mango, Rose &amp; Guava) provide clean, natural acidity.
            </p>
          </div>

          <div class="p-6 rounded-2xl bg-white/[0.02] border border-white/10">
            <span class="font-mono text-xs uppercase tracking-widest text-[#9089D3] block mb-2">Pillar IV</span>
            <h3 class="text-xl font-bold uppercase text-white mb-2">Pure Mountain Water</h3>
            <p class="text-white/60 text-xs leading-relaxed">
              Filtered Himalayan mineral water with balanced potassium and magnesium electrolytes to support neural transmission and all-day hydration.
            </p>
          </div>
        </div>

        <div class="p-8 sm:p-10 rounded-3xl bg-white/[0.03] border border-white/10 flex flex-col sm:flex-row items-center justify-between gap-8">
          <div>
            <h3 class="text-xl sm:text-2xl font-bold uppercase text-white mb-2">{{ section.settings.batch_title | default: 'Experience The Flagship Batch' }}</h3>
            <p class="text-xs text-white/60">{{ section.settings.batch_sub | escape | replace: '[free_shipping_threshold]', free_shipping_money }}</p>
          </div>
          <a href="{{ section.settings.batch_cta_url | default: '/#range' }}" class="button is-primary is-small whitespace-nowrap">
            {{ section.settings.batch_cta_label | default: 'Explore Flavors' }}
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "About Manifesto",
  "tag": "section",
  "class": "section-main-about",
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "Hero Kicker",
      "default": "Our Origins • Manifesto"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Hero Title",
      "default": "The Ambition Tonic"
    },
    {
      "type": "textarea",
      "id": "intro",
      "label": "Hero Intro",
      "default": "Energy drinks were engineered for extreme sports and nightclub floors: saturated in 30g of refined sugars, synthetic taurine, and jittery caffeine spikes designed for rapid heart rates rather than sustained, quiet cognitive concentration."
    },
    {
      "type": "header",
      "content": "The Premise"
    },
    {
      "type": "text",
      "id": "premise_title",
      "label": "Premise Title",
      "default": "Engineered For Modern Creators"
    },
    {
      "type": "textarea",
      "id": "premise_p1",
      "label": "Premise Paragraph 1",
      "default": "We built Asmaan for programmers writing code at 2 AM, designers obsessing over typography, writers finishing their fifth draft, and founders building companies from nothing."
    },
    {
      "type": "textarea",
      "id": "premise_p2",
      "label": "Premise Paragraph 2",
      "default": "You don't need a heart-racing adrenaline spike. You need a calm, steady cognitive floor that holds you in flow state for four straight hours without anxiety, irritability, or an afternoon crash."
    },
    {
      "type": "header",
      "content": "Flagship Batch Callout"
    },
    {
      "type": "text",
      "id": "batch_title",
      "label": "Callout Title",
      "default": "Experience The Flagship Batch"
    },
    {
      "type": "text",
      "id": "batch_sub",
      "label": "Callout Subtext",
      "default": "Dispatched direct from our studio with free express delivery over [free_shipping_threshold]."
    },
    {
      "type": "text",
      "id": "batch_cta_label",
      "label": "Callout Button Label",
      "default": "Explore Flavors"
    },
    {
      "type": "url",
      "id": "batch_cta_url",
      "label": "Callout Button Link"
    }
  ],
  "presets": [
    {
      "name": "About Manifesto"
    }
  ]
}
{% endschema %}
