{%- comment -%}
  About, first half: the title with the three cans standing over it, then the words printed on
  the side of the can set large beside a crop of that panel, and who the drink is for.
  Styles: assets/asmaan-about.css (shared with main-benefits).
{%- endcomment -%}
{{ 'asmaan-about.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign manifesto_lines = section.settings.manifesto | newline_to_br | split: '<br />'
  assign people = section.settings.people | newline_to_br | split: '<br />'
-%}

<section class="about_hero" aria-labelledby="about-title-{{ section.id }}">
  <h1 id="about-title-{{ section.id }}" class="about_title heading-style-display" data-about-reveal>
    {{- section.settings.title | escape | newline_to_br -}}
  </h1>
  <div class="about_cans" aria-hidden="true">
    <img class="about_can is-left" src="{{ 'print-front.webp' | asset_url }}" width="760" height="1950" alt="" loading="eager" decoding="async">
    <img class="about_can is-mid" src="{{ 'jamun-front.webp' | asset_url }}" width="760" height="1950" alt="" loading="eager" decoding="async">
    <img class="about_can is-right" src="{{ 'mango-front.webp' | asset_url }}" width="760" height="1950" alt="" loading="eager" decoding="async">
  </div>
  {%- if section.settings.intro != blank -%}
    <p class="about_intro" data-about-reveal>{{ section.settings.intro | escape }}</p>
  {%- endif -%}
</section>

<section class="about_can-words" aria-labelledby="about-words-{{ section.id }}">
  <h2 id="about-words-{{ section.id }}" class="sr-only">{{ section.settings.words_label | escape }}</h2>
  <div class="about_can-words-grid">
    <figure class="about_panel">
      <div class="about_panel-frame">
        <img src="{{ section.settings.panel_asset | default: 'jamun-left.webp' | asset_url }}" width="760" height="1950" alt="{{ section.settings.panel_alt | escape }}" loading="lazy" decoding="async">
      </div>
      <figcaption>{{ section.settings.panel_caption | escape }}</figcaption>
    </figure>

    <div class="about_words">
      <blockquote class="about_quote" data-about-lines>
        {%- for line in manifesto_lines -%}
          {%- assign l = line | strip -%}
          {%- if l != blank -%}<span class="about_quote-line">{{ l | escape }}</span>{%- endif -%}
        {%- endfor -%}
        <footer class="about_quote-sign">{% render 'asmaan-logo' %}</footer>
      </blockquote>
    </div>
  </div>
</section>

<section class="about_people" aria-labelledby="about-people-{{ section.id }}">
  <h2 id="about-people-{{ section.id }}" class="about_section-title heading-style-display" data-about-reveal>{{ section.settings.premise_title | escape | newline_to_br }}</h2>
  <ul class="about_people-list">
    {%- for person in people -%}
      {%- assign p = person | strip -%}
      {%- if p != blank -%}<li data-about-reveal>{{ p | escape }}</li>{%- endif -%}
    {%- endfor -%}
  </ul>
  {%- if section.settings.premise_p2 != blank -%}
    <p class="about_people-close" data-about-reveal>{{ section.settings.premise_p2 | escape }}</p>
  {%- endif -%}
</section>

<script>
  (function () {
    // Entrances: each [data-about-reveal] rises in once, and the can's words light up line by
    // line as they pass the middle of the screen. Everything is visible without JavaScript.
    var root = document.documentElement;
    if (root.dataset.aboutMotion) return;
    var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (reduce || !('IntersectionObserver' in window)) return;
    root.dataset.aboutMotion = 'on';

    var io = new IntersectionObserver(function (entries) {
      entries.forEach(function (e) {
        if (e.isIntersecting) { e.target.classList.add('is-in'); io.unobserve(e.target); }
      });
    }, { rootMargin: '0px 0px -12% 0px' });

    function watch() {
      document.querySelectorAll('[data-about-reveal]:not(.is-armed)').forEach(function (el) {
        el.classList.add('is-armed');
        io.observe(el);
      });
      document.querySelectorAll('[data-about-lines] .about_quote-line:not(.is-armed)').forEach(function (el) {
        el.classList.add('is-armed');
        lineIo.observe(el);
      });
    }

    var lineIo = new IntersectionObserver(function (entries) {
      entries.forEach(function (e) { e.target.classList.toggle('is-lit', e.isIntersecting || e.boundingClientRect.top < 0); });
    }, { rootMargin: '0px 0px -45% 0px' });

    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', watch);
    else watch();
    document.addEventListener('shopify:section:load', watch);
  })();
</script>

{% schema %}
{
  "name": "About: story",
  "tag": "div",
  "class": "section-main-about",
  "settings": [
    {
      "type": "textarea",
      "id": "title",
      "label": "Title",
      "default": "The ambition\ntonic",
      "info": "Each line break starts a new line."
    },
    {
      "type": "textarea",
      "id": "intro",
      "label": "Intro",
      "default": "Energy drinks were built for sport and for the night out: a spike, then a crash. Asmaan is built for the work in between — a drink for the hours you spend on one thing."
    },
    {
      "type": "header",
      "content": "The words on the can"
    },
    {
      "type": "text",
      "id": "words_label",
      "label": "Heading for screen readers",
      "default": "Printed on the side of every can"
    },
    {
      "type": "textarea",
      "id": "manifesto",
      "label": "Lines",
      "default": "If you're reading this, you're probably in the middle of something that matters.\nThe kind of work nobody applauds yet.\nKeep showing up.\nThe results will eventually introduce themselves.\nUntil then, protect the person building them.",
      "info": "One line per line break. They light up one by one as the page scrolls."
    },
    {
      "type": "text",
      "id": "panel_asset",
      "label": "Can panel image (theme asset)",
      "default": "jamun-left.webp"
    },
    {
      "type": "text",
      "id": "panel_alt",
      "label": "Can panel image description",
      "default": "The side panel of a Kala Jamun can, where the same words are printed."
    },
    {
      "type": "text",
      "id": "panel_caption",
      "label": "Caption",
      "default": "Left panel, every can"
    },
    {
      "type": "header",
      "content": "Who it is for"
    },
    {
      "type": "textarea",
      "id": "premise_title",
      "label": "Heading",
      "default": "Made for\nthe work"
    },
    {
      "type": "textarea",
      "id": "people",
      "label": "People",
      "default": "Programmers writing code at 2 AM\nDesigners on their fifth pass at the type\nWriters finishing the fifth draft\nFounders building something from nothing",
      "info": "One per line."
    },
    {
      "type": "textarea",
      "id": "premise_p2",
      "label": "Closing line",
      "default": "Not a heart-racing spike. A steady floor that holds for about four hours, then lets you down gently."
    }
  ]
}
{% endschema %}
