{%- assign stage_collection = section.settings.collection | default: settings.featured_can_collection | default: collections['frontpage'] | default: collections.all -%}
<script>
  window.ASMAAN_TASTES = [
    {%- if section.blocks.size > 0 -%}
      {%- assign total_items = section.blocks.size -%}
      {%- assign max_idx = total_items | minus: 1 -%}
      {%- for block in section.blocks -%}
        {%- liquid
          if total_items > 1
            assign cx_val = forloop.index0 | times: 196 | divided_by: max_idx | plus: 22
          else
            assign cx_val = 120
          endif
          assign b_prod = block.settings.product
          if b_prod != blank
            assign p_id = b_prod.handle
            assign p_title = b_prod.title
            assign words = p_title | split: ' '
            assign p_line1 = block.settings.line1 | default: words[0]
            if words.size > 1
              assign rem = p_title | remove_first: words[0] | strip
              assign p_line2 = block.settings.line2 | default: rem
            else
              assign p_line2 = block.settings.line2 | default: ''
            endif
            assign p_url = b_prod.url
            assign p_tag = block.settings.tag | default: b_prod.metafields.custom.tagline.value | default: b_prod.type | default: section.settings.default_tag
            assign p_blurb = block.settings.blurb | default: b_prod.metafields.custom.blurb.value | default: b_prod.description | strip_html | truncate: 160

            assign p_primary = block.settings.primary_color | default: b_prod.metafields.custom.primary_color.value
            assign p_secondary = block.settings.secondary_color | default: b_prod.metafields.custom.accent_color.value
            assign p_secondary = p_secondary | default: section.settings.fallback_secondary
            assign p_primary = p_primary | default: section.settings.fallback_primary

            assign p_poster = block.settings.poster | default: b_prod.featured_media | default: b_prod.featured_image
            if p_poster != blank
              assign poster_url = p_poster | image_url: width: 1040
            else
              assign poster_url = ''
            endif

            assign label_url = ''
            if block.settings.label_image != blank
              assign label_url = block.settings.label_image | image_url: width: 2048
            elsif b_prod.images.size > 0
              assign label_url = b_prod.images.last | image_url: width: 2048
            elsif b_prod.media.size > 0
              assign label_url = b_prod.media.last | image_url: width: 2048
            elsif poster_url != blank
              assign label_url = poster_url
            endif
          else
            assign p_id = block.id
            assign p_line1 = block.settings.line1
            assign p_line2 = block.settings.line2
            assign p_primary = block.settings.primary_color | default: section.settings.fallback_primary
            assign p_secondary = block.settings.secondary_color | default: section.settings.fallback_secondary
            assign p_tag = block.settings.tag | default: section.settings.default_tag
            assign p_blurb = block.settings.blurb
            assign p_url = '/#range'
            if block.settings.poster != blank
              assign poster_url = block.settings.poster | image_url: width: 1040
            else
              assign poster_url = ''
            endif
            if block.settings.label_image != blank
              assign label_url = block.settings.label_image | image_url: width: 2048
            else
              assign label_url = poster_url
            endif
          endif
        -%}
        {
          id: {{ p_id | json }},
          line1: {{ p_line1 | json }},
          line2: {{ p_line2 | json }},
          primary: {{ p_primary | json }},
          secondary: {{ p_secondary | json }},
          labelUrl: {{ label_url | json }},
          posterUrl: {{ poster_url | json }},
          tag: {{ p_tag | json }},
          blurb: {{ p_blurb | json }},
          cx: {{ cx_val }},
          productUrl: {{ p_url | json }}
        }{%- unless forloop.last -%},{%- endunless -%}
      {%- endfor -%}
    {%- elsif stage_collection != blank and stage_collection.products.size > 0 -%}
      {%- assign total_items = stage_collection.products.size -%}
      {%- assign max_idx = total_items | minus: 1 -%}
      {%- for product in stage_collection.products -%}
        {%- liquid
          if total_items > 1
            assign cx_val = forloop.index0 | times: 196 | divided_by: max_idx | plus: 22
          else
            assign cx_val = 120
          endif
          assign p_id = product.handle
          assign p_title = product.title
          assign words = p_title | split: ' '
          assign p_line1 = words[0]
          if words.size > 1
            assign p_line2 = p_title | remove_first: words[0] | strip
          else
            assign p_line2 = ''
          endif
          assign p_url = product.url
          assign p_tag = product.metafields.custom.tagline.value | default: product.type | default: section.settings.default_tag
          assign p_blurb = product.metafields.custom.blurb.value | default: product.description | strip_html | truncate: 160

          assign p_primary = product.metafields.custom.primary_color.value
          assign p_secondary = product.metafields.custom.accent_color.value | default: section.settings.fallback_secondary
          assign p_primary = p_primary | default: section.settings.fallback_primary

          assign p_poster = product.featured_media | default: product.featured_image
          if p_poster != blank
            assign poster_url = p_poster | image_url: width: 1040
          else
            assign poster_url = ''
          endif

          # Dynamically take the LAST image from the product in Shopify backend for 3D label
          assign label_url = ''
          if product.images.size > 0
            assign label_url = product.images.last | image_url: width: 2048
          elsif product.media.size > 0
            assign label_url = product.media.last | image_url: width: 2048
          elsif product.metafields.custom.label_image != blank
            assign label_url = product.metafields.custom.label_image | image_url: width: 2048
          elsif p_poster != blank
            assign label_url = poster_url
          endif
        -%}
        {
          id: {{ p_id | json }},
          line1: {{ p_line1 | json }},
          line2: {{ p_line2 | json }},
          primary: {{ p_primary | json }},
          secondary: {{ p_secondary | json }},
          labelUrl: {{ label_url | json }},
          posterUrl: {{ poster_url | json }},
          tag: {{ p_tag | json }},
          blurb: {{ p_blurb | json }},
          cx: {{ cx_val }},
          productUrl: {{ p_url | json }}
        }{%- unless forloop.last -%},{%- endunless -%}
      {%- endfor -%}
    {%- endif -%}
  ];
</script>

<div id="stage" class="pointer-events-none relative">
  <!-- 3D Can Fixed Viewport Stage -->
  <div class="pointer-events-none fixed inset-0 z-[2]" style="transition: opacity 0.3s linear">
    <div
      class="relative pointer-events-auto absolute inset-0 h-full w-full"
      role="img"
      aria-label="A 250 ml can of Asmaan Ambition Tonic. Interactive 3D model — drag it to turn the can."
      data-asmaan-stage-can
    >
      {%- liquid
        assign first_prod = stage_collection.products.first
        if section.blocks.size > 0
          assign first_prod = section.blocks.first.settings.product
        endif
      -%}
      {%- if first_prod != blank and first_prod.featured_image != blank -%}
        <img
          alt="{{ first_prod.title | escape }}"
          width="{{ first_prod.featured_image.width }}"
          height="{{ first_prod.featured_image.height }}"
          decoding="async"
          class="object-contain transition-opacity duration-700 opacity-100"
          style="position: absolute; height: 100%; width: 100%; left: 0; top: 0; right: 0; bottom: 0; color: transparent;"
          src="{{ first_prod.featured_image | image_url: width: 1040 }}"
        >
      {%- endif -%}
      <canvas class="absolute inset-0 h-full w-full transition-opacity duration-700 opacity-0 cursor-grab touch-pan-y active:cursor-grabbing"></canvas>
    </div>
  </div>

  <!-- Interactive Cosmic Space Starfield Background -->
  <canvas id="asmaan-starfield" class="asmaan-starfield-canvas" aria-hidden="true"></canvas>

  <main class="pointer-events-none relative">
    <!-- 1. Hero Range -->
    <section id="range" aria-label="The range" class="section is-pinned" style="height: 170svh;">
      <div class="gamme_container">
        <div class="pin_fade">
          <div class="padding-global">
            <div class="container-large">
              <div class="relative mx-auto max-width-medium pb-[var(--pad-m)]">
                <div class="gamme_gradient-wrapper" aria-hidden="true">
                  <div class="gamme_gradient-position">
                    <div class="gamme_gradient"></div>
                  </div>
                </div>

                <h1 class="sr-only">{{ section.settings.seo_h1 | default: 'Asmaan — the ambition tonic' }}</h1>

                <div class="carousel_container">
                  <div class="carousel_stack" data-taste-stack>
                    {%- if section.blocks.size > 0 -%}
                      {%- for block in section.blocks -%}
                        {%- liquid
                          assign b_prod = block.settings.product
                          if b_prod != blank
                            assign p_title = b_prod.title
                            assign words = p_title | split: ' '
                            assign s_line1 = block.settings.line1 | default: words[0]
                            if words.size > 1
                              assign rem = p_title | remove_first: words[0] | strip
                              assign s_line2 = block.settings.line2 | default: rem
                            else
                              assign s_line2 = block.settings.line2 | default: ''
                            endif
                          else
                            assign s_line1 = block.settings.line1
                            assign s_line2 = block.settings.line2
                          endif
                        -%}
                        <div class="carousel_slide" data-active="{% if forloop.first %}true{% else %}false{% endif %}" {{ block.shopify_attributes }}>
                          <div class="heading-style-h2">
                            <span class="block">{{ s_line1 }}</span>
                            <span class="block">{{ s_line2 }}</span>
                          </div>
                        </div>
                      {%- endfor -%}
                    {%- elsif stage_collection != blank and stage_collection.products.size > 0 -%}
                      {%- for product in stage_collection.products -%}
                        {%- liquid
                          assign p_title = product.title
                          assign words = p_title | split: ' '
                          assign s_line1 = words[0]
                          if words.size > 1
                            assign s_line2 = p_title | remove_first: words[0] | strip
                          else
                            assign s_line2 = ''
                          endif
                        -%}
                        <div class="carousel_slide" data-active="{% if forloop.first %}true{% else %}false{% endif %}">
                          <div class="heading-style-h2">
                            <span class="block">{{ s_line1 }}</span>
                            <span class="block">{{ s_line2 }}</span>
                          </div>
                        </div>
                      {%- endfor -%}
                    {%- endif -%}
                  </div>

                  <div class="carousel_nav pointer-events-auto">
                    <button type="button" class="carousel_arrow is-prev" data-carousel-prev aria-label="Previous colourway">
                      {% render 'asmaan-icons', name: 'arrow', direction: 'left', class: 'h-5 w-5' %}
                    </button>
                    <button type="button" class="carousel_arrow is-next" data-carousel-next aria-label="Next colourway">
                      {% render 'asmaan-icons', name: 'arrow', direction: 'right', class: 'h-5 w-5' %}
                    </button>
                  </div>
                </div>

                <div class="scroll_discover font-mono pointer-events-auto">{{ section.settings.discover_text | default: 'Scroll to discover' }}</div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- 2. Profile Section (Tasting Notes) -->
    <section aria-label="Tasting notes" class="section is-pinned" style="height: 170svh;">
      <div class="profile_container">
        <div class="pin_fade">
          <div class="padding-global">
            <div class="container-large">
              <div class="max-width-custom relative">
                <div class="pin_scrim" aria-hidden="true"></div>
                <div class="mb-[var(--pad-m)] md:mb-[var(--pad-l)]">
                  <div class="carousel_stack" data-taste-stack>
                    {%- if section.blocks.size > 0 -%}
                      {%- for block in section.blocks -%}
                        {%- liquid
                          assign b_prod = block.settings.product
                          if b_prod != blank
                            assign p_title = b_prod.title
                            assign words = p_title | split: ' '
                            assign s_line1 = block.settings.line1 | default: words[0]
                            if words.size > 1
                              assign rem = p_title | remove_first: words[0] | strip
                              assign s_line2 = block.settings.line2 | default: rem
                            else
                              assign s_line2 = block.settings.line2 | default: ''
                            endif
                          else
                            assign s_line1 = block.settings.line1
                            assign s_line2 = block.settings.line2
                          endif
                        -%}
                        <div class="carousel_slide" data-active="{% if forloop.first %}true{% else %}false{% endif %}" {{ block.shopify_attributes }}>
                          <div class="heading-style-h2">
                            <span class="block">{{ s_line1 }}</span>
                            <span class="block">{{ s_line2 }}</span>
                          </div>
                        </div>
                      {%- endfor -%}
                    {%- elsif stage_collection != blank and stage_collection.products.size > 0 -%}
                      {%- for product in stage_collection.products -%}
                        {%- liquid
                          assign p_title = product.title
                          assign words = p_title | split: ' '
                          assign s_line1 = words[0]
                          if words.size > 1
                            assign s_line2 = p_title | remove_first: words[0] | strip
                          else
                            assign s_line2 = ''
                          endif
                        -%}
                        <div class="carousel_slide" data-active="{% if forloop.first %}true{% else %}false{% endif %}">
                          <div class="heading-style-h2">
                            <span class="block">{{ s_line1 }}</span>
                            <span class="block">{{ s_line2 }}</span>
                          </div>
                        </div>
                      {%- endfor -%}
                    {%- endif -%}
                  </div>
                </div>

                <div class="profile_desc">
                  {% render 'asmaan-icons', name: 'corner', class: 'corner-left h-2 w-2 text-white/50' %}
                  <div class="carousel_stack" data-taste-stack>
                    {%- if section.blocks.size > 0 -%}
                      {%- for block in section.blocks -%}
                        {%- liquid
                          assign b_prod = block.settings.product
                          if b_prod != blank
                            assign b_blurb = block.settings.blurb | default: b_prod.metafields.custom.blurb.value | default: b_prod.description | strip_html | truncate: 160
                            assign b_tag = block.settings.tag | default: b_prod.metafields.custom.tagline.value | default: b_prod.type | default: section.settings.default_tag
                          else
                            assign b_blurb = block.settings.blurb
                            assign b_tag = block.settings.tag | default: section.settings.default_tag
                          endif
                        -%}
                        <div class="carousel_slide" data-active="{% if forloop.first %}true{% else %}false{% endif %}" {{ block.shopify_attributes }}>
                          <p class="text-white/80">{{ b_blurb }}</p>
                          <p class="mt-[var(--pad-s)] font-mono text-size-tiny uppercase tracking-[0.22em] text-white/40">{{ b_tag }}</p>
                        </div>
                      {%- endfor -%}
                    {%- elsif stage_collection != blank and stage_collection.products.size > 0 -%}
                      {%- for product in stage_collection.products -%}
                        {%- liquid
                          assign b_blurb = product.metafields.custom.blurb.value | default: product.description | strip_html | truncate: 160
                          assign b_tag = product.metafields.custom.tagline.value | default: product.type | default: section.settings.default_tag
                        -%}
                        <div class="carousel_slide" data-active="{% if forloop.first %}true{% else %}false{% endif %}">
                          <p class="text-white/80">{{ b_blurb }}</p>
                          <p class="mt-[var(--pad-s)] font-mono text-size-tiny uppercase tracking-[0.22em] text-white/40">{{ b_tag }}</p>
                        </div>
                      {%- endfor -%}
                    {%- endif -%}
                  </div>
                  {% render 'asmaan-icons', name: 'corner', flip: true, class: 'corner-right h-2 w-2 text-white/50' %}
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- 3. Benefits Section -->
    <div id="benefits">
      <section id="benefit-sugar" aria-label="{{ section.settings.b1_title | default: 'Zero sugar' }}" class="section is-pinned" style="height: 170svh;">
        <div class="benefits_container">
          <div class="pin_fade">
            <div class="padding-global">
              <div class="container-large">
                <div class="padding-section-medium">
                  <div class="benefits_text">
                    <div class="benefits_max-width relative" style="--benefits-line: 1;">
                      <div class="pin_scrim" aria-hidden="true"></div>
                      <div class="mb-[var(--pad-s)]">
                        <div class="subhead_wrapper align-center">
                          <div class="subhead">
                            <div class="subhead_icon">
                              {% render 'asmaan-icons', name: 'cross', class: 'h-2.5 w-2.5' %}
                            </div>
                            <div class="subhead_text">{{ section.settings.b1_struck | default: 'Sugar' }}</div>
                          </div>
                        </div>
                      </div>
                      <div class="mb-[var(--pad-xs)]">
                        <h2 class="heading-style-h2">{{ section.settings.b1_title | default: 'Zero sugar' }}</h2>
                      </div>
                      <p class="text-white/75">{{ section.settings.b1_body | default: 'Ten calories a can. Nothing is sweetened up to cover a flat recipe — the fruit is doing the work, so there is nothing to hide behind.' }}</p>
                      <div class="max-width-xsmall mt-[var(--pad-s)] font-mono text-size-tiny uppercase tracking-[0.22em] text-white/40">{{ section.settings.b1_note | default: '10 kcal per 250 ml' }}</div>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>

      <section id="benefit-caffeine" aria-label="{{ section.settings.b2_title | default: 'Caffeine from green coffee' }}" class="section is-pinned" style="height: 170svh;">
        <div class="benefits_container">
          <div class="pin_fade">
            <div class="padding-global">
              <div class="container-large">
                <div class="padding-section-medium">
                  <div class="benefits_text">
                    <div class="benefits_max-width relative" style="--benefits-line: 0;">
                      <div class="pin_scrim" aria-hidden="true"></div>
                      <div class="mb-[var(--pad-s)]">
                        <div class="subhead_wrapper align-center">
                          <div class="subhead">
                            <div class="subhead_icon">
                              {% render 'asmaan-icons', name: 'cross', class: 'h-2.5 w-2.5' %}
                            </div>
                            <div class="subhead_text">{{ section.settings.b2_struck | default: 'Synthetic caffeine' }}</div>
                          </div>
                        </div>
                      </div>
                      <div class="mb-[var(--pad-xs)]">
                        <h2 class="heading-style-h2">{{ section.settings.b2_title | default: 'Caffeine from green coffee' }}</h2>
                      </div>
                      <p class="text-white/75">{{ section.settings.b2_body | default: '100 mg drawn from green coffee beans rather than synthesised. It arrives slower, holds longer, and lands nothing like a shot of the lab-made version.' }}</p>
                      <div class="max-width-xsmall mt-[var(--pad-s)] font-mono text-size-tiny uppercase tracking-[0.22em] text-white/40">{{ section.settings.b2_note | default: '100 mg per can' }}</div>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>

      <section id="benefit-crash" aria-label="{{ section.settings.b3_title | default: 'L-theanine and ashwagandha' }}" class="section is-pinned" style="height: 170svh;">
        <div class="benefits_container">
          <div class="pin_fade">
            <div class="padding-global">
              <div class="container-large">
                <div class="padding-section-medium">
                  <div class="benefits_text">
                    <div class="benefits_max-width relative" style="--benefits-line: 0;">
                      <div class="pin_scrim" aria-hidden="true"></div>
                      <div class="mb-[var(--pad-s)]">
                        <div class="subhead_wrapper align-center">
                          <div class="subhead">
                            <div class="subhead_icon">
                              {% render 'asmaan-icons', name: 'cross', class: 'h-2.5 w-2.5' %}
                            </div>
                            <div class="subhead_text">{{ section.settings.b3_struck | default: 'The crash' }}</div>
                          </div>
                        </div>
                      </div>
                      <div class="mb-[var(--pad-xs)]">
                        <h2 class="heading-style-h2">{{ section.settings.b3_title | default: 'L-theanine and ashwagandha' }}</h2>
                      </div>
                      <p class="text-white/75">{{ section.settings.b3_body | default: '200 mg of L-theanine to take the edge off the caffeine, and 300 mg of KSM-66 ashwagandha under it. The curve climbs instead of spiking, then comes down flat.' }}</p>
                      <div class="max-width-xsmall mt-[var(--pad-s)] font-mono text-size-tiny uppercase tracking-[0.22em] text-white/40">{{ section.settings.b3_note | default: '200 mg L-theanine &middot; 300 mg KSM-66' }}</div>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>

      <section id="benefit-colour" aria-label="{{ section.settings.b4_title | default: 'Colour from food' }}" class="section is-pinned" style="height: 170svh;">
        <div class="benefits_container">
          <div class="pin_fade">
            <div class="padding-global">
              <div class="container-large">
                <div class="padding-section-medium">
                  <div class="benefits_text">
                    <div class="benefits_max-width relative" style="--benefits-line: 0;">
                      <div class="pin_scrim" aria-hidden="true"></div>
                      <div class="mb-[var(--pad-s)]">
                        <div class="subhead_wrapper align-center">
                          <div class="subhead">
                            <div class="subhead_icon">
                              {% render 'asmaan-icons', name: 'cross', class: 'h-2.5 w-2.5' %}
                            </div>
                            <div class="subhead_text">{{ section.settings.b4_struck | default: 'Artificial colour' }}</div>
                          </div>
                        </div>
                      </div>
                      <div class="mb-[var(--pad-xs)]">
                        <h2 class="heading-style-h2">{{ section.settings.b4_title | default: 'Colour from food' }}</h2>
                      </div>
                      <p class="text-white/75">{{ section.settings.b4_body | default: 'No synthetic dyes and no proprietary blend. Every milligram in the can is printed on the can, and the colour comes from what is already in it.' }}</p>
                      <div class="max-width-xsmall mt-[var(--pad-s)] font-mono text-size-tiny uppercase tracking-[0.22em] text-white/40">{{ section.settings.b4_note | default: 'Vegan &middot; no artificial colour' }}</div>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- Benefits Floating Side-Nav -->
      <div class="benefits_nav" style="opacity: 0; visibility: hidden;" aria-hidden="true">
        <div class="contents">
          <a href="#benefit-sugar" class="benefits_icon-wrapper is-active" aria-label="{{ section.settings.b1_title | default: 'Zero sugar' }}" aria-current="true">
            <div class="benefits_icon">
              {% render 'asmaan-icons', name: 'benefit', icon: 'sugar', class: 'h-full w-full' %}
            </div>
          </a>
        </div>
        <div class="contents">
          <div class="benefits_icon-separator"></div>
          <a href="#benefit-caffeine" class="benefits_icon-wrapper" aria-label="{{ section.settings.b2_title | default: 'Caffeine from green coffee' }}" aria-current="false">
            <div class="benefits_icon">
              {% render 'asmaan-icons', name: 'benefit', icon: 'bean', class: 'h-full w-full' %}
            </div>
          </a>
        </div>
        <div class="contents">
          <div class="benefits_icon-separator"></div>
          <a href="#benefit-crash" class="benefits_icon-wrapper" aria-label="{{ section.settings.b3_title | default: 'L-theanine and ashwagandha' }}" aria-current="false">
            <div class="benefits_icon">
              {% render 'asmaan-icons', name: 'benefit', icon: 'curve', class: 'h-full w-full' %}
            </div>
          </a>
        </div>
        <div class="contents">
          <div class="benefits_icon-separator"></div>
          <a href="#benefit-colour" class="benefits_icon-wrapper" aria-label="{{ section.settings.b4_title | default: 'Colour from food' }}" aria-current="false">
            <div class="benefits_icon">
              {% render 'asmaan-icons', name: 'benefit', icon: 'drop', class: 'h-full w-full' %}
            </div>
          </a>
        </div>
      </div>
    </div>

    <!-- 4. Manifesto Section -->
    <div class="manifesto_layer" data-active="false" aria-hidden="true">
      <div class="manifesto_wash" style="background: radial-gradient(115% 95% at 50% 54%, #9089D3 0%, #9089D3 10%, #2A1D4A 72%, #07050f 100%);">
        <div class="manifesto_field" style="--blob: #9089D3; --blob-dark: #2A1D4A;">
          <span class="manifesto_blob"></span>
          <span class="manifesto_blob"></span>
          <span class="manifesto_blob"></span>
          <span class="manifesto_blob"></span>
          <span class="manifesto_blob"></span>
        </div>
        <div class="manifesto_shade"></div>
      </div>
      <div class="manifesto_type">
        <span>{{ section.settings.manifesto_line1 | default: 'Nothing' }}</span>
        <span>{{ section.settings.manifesto_line2 | default: 'Hidden' }}</span>
      </div>
    </div>

    <section class="section is-pinned is-manifesto" style="height: 170svh;">
      <div class="manifesto_container">
        <div class="pin_fade">
          <h2 class="sr-only">{{ section.settings.manifesto_label | default: 'Nothing hidden — every milligram is printed on the can.' }}</h2>
        </div>
      </div>
    </section>
  </main>

  <div aria-hidden="true" class="h-[10svh]"></div>
</div>

