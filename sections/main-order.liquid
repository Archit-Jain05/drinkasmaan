<section class="section relative bg-black text-white min-h-[80vh] py-16 sm:py-24">
  <div class="padding-global max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="mb-8">
      <a href="{{ routes.account_url }}" class="inline-flex items-center gap-2 text-xs font-mono text-white/50 hover:text-white transition-colors mb-4">
        &larr; {{ 'customer.account.return' | t | default: 'Return to Account' }}
      </a>
      <h1 class="text-3xl sm:text-4xl font-black uppercase tracking-tight text-white mb-2">
        {{ 'customer.orders.title' | t: name: order.name | default: order.name }}
      </h1>
      <p class="text-xs font-mono text-white/50">
        {{ 'customer.orders.date' | t: date: order.created_at | default: order.created_at | time_tag: format: 'date_at_time' }}
      </p>
    </div>

    {% if order.cancelled %}
      <div class="p-4 mb-8 rounded-xl bg-red-500/10 border border-red-500/30 text-xs text-red-300">
        {{ 'customer.orders.cancelled' | t: date: order.cancelled_at | default: 'Order Cancelled' }} &bull; {{ order.cancel_reason_label }}
      </div>
    {% endif %}

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
      <!-- Line Items -->
      <div class="lg:col-span-2 space-y-6">
        <div class="p-6 rounded-2xl bg-white/[0.02] border border-white/10">
          <table class="w-full text-left text-xs font-mono">
            <thead>
              <tr class="border-b border-white/15 text-white/50 uppercase pb-2">
                <th class="py-2">Item</th>
                <th class="py-2 text-center">Qty</th>
                <th class="py-2 text-right">Price</th>
                <th class="py-2 text-right">Total</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-white/5">
              {% for line_item in order.line_items %}
                <tr>
                  <td class="py-4 pr-2">
                    <div class="font-sans font-medium text-white text-sm">{{ line_item.title }}</div>
                    {% if line_item.sku != blank %}<div class="text-[10px] text-white/40">SKU: {{ line_item.sku }}</div>{% endif %}
                    {% if line_item.fulfillment %}
                      <div class="mt-1 text-[10px] text-blue-400">
                        Fulfilled {{ line_item.fulfillment.created_at | time_tag: format: 'date' }}
                        {% if line_item.fulfillment.tracking_url %}&bull; <a href="{{ line_item.fulfillment.tracking_url }}" target="_blank" class="underline">Track</a>{% endif %}
                      </div>
                    {% endif %}
                  </td>
                  <td class="py-4 px-2 text-center text-white/70">{{ line_item.quantity }}</td>
                  <td class="py-4 px-2 text-right text-white/70">{{ line_item.original_price | money }}</td>
                  <td class="py-4 pl-2 text-right font-bold text-white">{{ line_item.final_line_price | money }}</td>
                </tr>
              {% endfor %}
            </tbody>
            <tfoot class="border-t border-white/15 text-xs">
              <tr>
                <td colspan="3" class="pt-4 text-white/50">Subtotal</td>
                <td class="pt-4 text-right text-white">{{ order.line_items_subtotal_price | money }}</td>
              </tr>
              {% for shipping_method in order.shipping_methods %}
                <tr>
                  <td colspan="3" class="py-1 text-white/50">Shipping ({{ shipping_method.title }})</td>
                  <td class="py-1 text-right text-white">{{ shipping_method.price | money }}</td>
                </tr>
              {% endfor %}
              {% for tax_line in order.tax_lines %}
                <tr>
                  <td colspan="3" class="py-1 text-white/50">Tax ({{ tax_line.title }} {{ tax_line.rate | times: 100 }}%)</td>
                  <td class="py-1 text-right text-white">{{ tax_line.price | money }}</td>
                </tr>
              {% endfor %}
              <tr class="font-bold text-sm">
                <td colspan="3" class="pt-3 text-white uppercase">Total</td>
                <td class="pt-3 text-right text-white">{{ order.total_net_amount | money_with_currency }}</td>
              </tr>
            </tfoot>
          </table>
        </div>
      </div>

      <!-- Address sidebar -->
      <div class="space-y-6">
        <div class="p-6 rounded-2xl bg-white/[0.02] border border-white/10 space-y-4 text-xs font-mono">
          <div>
            <h3 class="font-bold text-white uppercase tracking-wider mb-2">{{ 'customer.orders.billing_address' | t | default: 'Billing Address' }}</h3>
            <span class="px-2 py-0.5 rounded-full text-[10px] uppercase {% if order.financial_status == 'paid' %}bg-emerald-500/20 text-emerald-300{% else %}bg-yellow-500/20 text-yellow-300{% endif %} inline-block mb-2">
              {{ order.financial_status_label }}
            </span>
            <div class="text-white/70 font-sans leading-relaxed">
              {{ order.billing_address | format_address }}
            </div>
          </div>

          <div class="pt-4 border-t border-white/10">
            <h3 class="font-bold text-white uppercase tracking-wider mb-2">{{ 'customer.orders.shipping_address' | t | default: 'Shipping Address' }}</h3>
            <span class="px-2 py-0.5 rounded-full text-[10px] uppercase {% if order.fulfillment_status == 'fulfilled' %}bg-blue-500/20 text-blue-300{% else %}bg-white/10 text-white/60{% endif %} inline-block mb-2">
              {{ order.fulfillment_status_label }}
            </span>
            <div class="text-white/70 font-sans leading-relaxed">
              {{ order.shipping_address | format_address }}
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Order Details",
  "settings": []
}
{% endschema %}
