{% paginate blog.articles by 9 %}
<section class="section relative bg-black text-white min-h-[80vh] py-16 sm:py-24">
  <div class="padding-global max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Hero Header -->
    <div class="text-center max-w-2xl mx-auto mb-12">
      <span class="text-xs font-mono uppercase tracking-widest text-[#9089D3] block mb-2">Editorial & Journal</span>
      <h1 class="text-4xl sm:text-6xl font-black uppercase tracking-tight text-white mb-4">
        {{ blog.title }}
      </h1>
      <p class="text-white/60 text-sm sm:text-base leading-relaxed">
        Formulation journals, botanical science, creative dispatch, and updates from the team.
      </p>

      <!-- Tag filters if tags exist -->
      {% if blog.all_tags.size > 0 %}
        <div class="flex flex-wrap items-center justify-center gap-2 mt-6">
          <a href="{{ blog.url }}" class="px-3 py-1 rounded-full text-xs font-mono uppercase tracking-wider {% if current_tags == blank %}bg-white text-black font-bold{% else %}bg-white/5 text-white/60 hover:text-white border border-white/10{% endif %} transition-colors">
            All
          </a>
          {% for tag in blog.all_tags %}
            <a href="{{ blog.url }}/tagged/{{ tag | handle }}" class="px-3 py-1 rounded-full text-xs font-mono uppercase tracking-wider {% if current_tags contains tag %}bg-white text-black font-bold{% else %}bg-white/5 text-white/60 hover:text-white border border-white/10{% endif %} transition-colors">
              {{ tag }}
            </a>
          {% endfor %}
        </div>
      {% endif %}
    </div>

    <!-- Article Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 mb-16">
      {% for article in blog.articles %}
        <article class="article-card group bg-white/[0.02] hover:bg-white/[0.05] border border-white/10 hover:border-white/30 rounded-2xl overflow-hidden transition-all duration-300 flex flex-col justify-between">
          <div>
            {% if article.image %}
              <a href="{{ article.url }}" class="block relative aspect-[16/10] overflow-hidden bg-white/5">
                <img
                  src="{{ article.image | image_url: width: 800 }}"
                  alt="{{ article.image.alt | default: article.title | escape }}"
                  loading="lazy"
                  width="800"
                  height="500"
                  class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                >
              </a>
            {% endif %}

            <div class="p-6">
              <div class="flex items-center gap-3 text-[10px] font-mono text-white/40 uppercase tracking-wider mb-2">
                <span>{{ article.published_at | time_tag: format: 'date' }}</span>
                <span>&bull;</span>
                <span>{{ article.author }}</span>
              </div>

              <h2 class="text-xl font-bold text-white group-hover:text-white/90 mb-3 leading-snug">
                <a href="{{ article.url }}">{{ article.title }}</a>
              </h2>

              <p class="text-xs text-white/60 line-clamp-3 leading-relaxed mb-4">
                {% if article.excerpt.size > 0 %}
                  {{ article.excerpt | strip_html }}
                {% else %}
                  {{ article.content | strip_html | truncate: 140 }}
                {% endif %}
              </p>
            </div>
          </div>

          <div class="px-6 pb-6 pt-0">
            <a href="{{ article.url }}" class="inline-flex items-center gap-2 text-xs font-mono uppercase tracking-wider text-white hover:text-white/70 transition-colors">
              <span>Read story</span>
              {% render 'asmaan-icons', name: 'arrow', class: 'w-3 h-3' %}
            </a>
          </div>
        </article>
      {% endfor %}
    </div>

    <!-- Pagination -->
    {% if paginate.pages > 1 %}
      <div class="pagination flex justify-center items-center gap-3 pt-8 border-t border-white/10 font-mono text-xs">
        {% if paginate.previous %}
          <a href="{{ paginate.previous.url }}" class="px-4 py-2 rounded-lg bg-white/5 hover:bg-white/10 border border-white/10 text-white transition-colors">&larr; Previous</a>
        {% endif %}
        <span class="text-white/40 px-2">Page {{ paginate.current_page }} of {{ paginate.pages }}</span>
        {% if paginate.next %}
          <a href="{{ paginate.next.url }}" class="px-4 py-2 rounded-lg bg-white/5 hover:bg-white/10 border border-white/10 text-white transition-colors">Next &rarr;</a>
        {% endif %}
      </div>
    {% endif %}

  </div>
</section>
{% endpaginate %}

{% schema %}
{
  "name": "Blog",
  "settings": []
}
{% endschema %}
