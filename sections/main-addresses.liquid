<section class="section relative bg-black text-white min-h-[80vh] py-16 sm:py-24" style="padding-top: calc(var(--asmaan-header-h, 90px) + 2rem);">
  <div class="padding-global max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex flex-col sm:flex-row sm:items-center justify-between pb-8 mb-8 border-b border-white/10 gap-4">
      <div>
        <a href="{{ routes.account_url }}" class="inline-flex items-center gap-2 text-xs font-mono text-white/50 hover:text-white transition-colors mb-2">
          &larr; {{ 'customer.account.return' | t | default: 'Return to Account' }}
        </a>
        <h1 class="text-3xl sm:text-4xl font-black uppercase tracking-tight text-white">
          {{ 'customer.addresses.title' | t | default: 'Your Addresses' }}
        </h1>
      </div>
      <button type="button" id="AddNewAddressToggle" class="px-5 py-2.5 rounded-xl bg-white text-black font-semibold text-xs hover:bg-white/90 transition-colors">
        + {{ 'customer.addresses.add_new' | t | default: 'Add New Address' }}
      </button>
    </div>

    <!-- Add New Address Form Modal/Panel -->
    <div id="AddAddressPanel" class="hidden mb-12 p-6 sm:p-8 rounded-2xl bg-white/[0.03] border border-white/15">
      <h2 class="text-lg font-bold uppercase tracking-wider mb-6">{{ 'customer.addresses.add_new' | t | default: 'Add a New Address' }}</h2>
      {% form 'customer_address', customer.new_address %}
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 text-xs font-mono">
          <div>
            <label class="block text-white/60 uppercase mb-1">{{ 'customer.addresses.first_name' | t | default: 'First Name' }}</label>
            <input type="text" name="address[first_name]" value="{{ form.first_name }}" class="w-full bg-white/5 border border-white/15 rounded-xl px-4 py-2.5 text-white focus:outline-none focus:border-white">
          </div>
          <div>
            <label class="block text-white/60 uppercase mb-1">{{ 'customer.addresses.last_name' | t | default: 'Last Name' }}</label>
            <input type="text" name="address[last_name]" value="{{ form.last_name }}" class="w-full bg-white/5 border border-white/15 rounded-xl px-4 py-2.5 text-white focus:outline-none focus:border-white">
          </div>
          <div class="sm:col-span-2">
            <label class="block text-white/60 uppercase mb-1">{{ 'customer.addresses.company' | t | default: 'Company' }}</label>
            <input type="text" name="address[company]" value="{{ form.company }}" class="w-full bg-white/5 border border-white/15 rounded-xl px-4 py-2.5 text-white focus:outline-none focus:border-white">
          </div>
          <div class="sm:col-span-2">
            <label class="block text-white/60 uppercase mb-1">{{ 'customer.addresses.address1' | t | default: 'Address 1' }}</label>
            <input type="text" name="address[address1]" value="{{ form.address1 }}" required class="w-full bg-white/5 border border-white/15 rounded-xl px-4 py-2.5 text-white focus:outline-none focus:border-white">
          </div>
          <div class="sm:col-span-2">
            <label class="block text-white/60 uppercase mb-1">{{ 'customer.addresses.address2' | t | default: 'Address 2' }}</label>
            <input type="text" name="address[address2]" value="{{ form.address2 }}" class="w-full bg-white/5 border border-white/15 rounded-xl px-4 py-2.5 text-white focus:outline-none focus:border-white">
          </div>
          <div>
            <label class="block text-white/60 uppercase mb-1">{{ 'customer.addresses.city' | t | default: 'City' }}</label>
            <input type="text" name="address[city]" value="{{ form.city }}" required class="w-full bg-white/5 border border-white/15 rounded-xl px-4 py-2.5 text-white focus:outline-none focus:border-white">
          </div>
          <div>
            <label class="block text-white/60 uppercase mb-1">{{ 'customer.addresses.country' | t | default: 'Country' }}</label>
            <select name="address[country]" class="w-full bg-white/5 border border-white/15 rounded-xl px-4 py-2.5 text-white focus:outline-none focus:border-white cursor-pointer">
              {{ all_country_option_tags }}
            </select>
          </div>
          <div>
            <label class="block text-white/60 uppercase mb-1">{{ 'customer.addresses.zip' | t | default: 'Postal / ZIP' }}</label>
            <input type="text" name="address[zip]" value="{{ form.zip }}" class="w-full bg-white/5 border border-white/15 rounded-xl px-4 py-2.5 text-white focus:outline-none focus:border-white">
          </div>
          <div>
            <label class="block text-white/60 uppercase mb-1">{{ 'customer.addresses.phone' | t | default: 'Phone' }}</label>
            <input type="tel" name="address[phone]" value="{{ form.phone }}" class="w-full bg-white/5 border border-white/15 rounded-xl px-4 py-2.5 text-white focus:outline-none focus:border-white">
          </div>
          <div class="sm:col-span-2 flex items-center gap-2 pt-2">
            {{ form.set_as_default_checkbox }}
            <label for="address_default_address_new" class="text-white/80 cursor-pointer">{{ 'customer.addresses.set_default' | t | default: 'Set as default address' }}</label>
          </div>
          <div class="sm:col-span-2 flex gap-3 pt-4">
            <button type="submit" class="px-6 py-2.5 rounded-xl bg-white text-black font-semibold hover:bg-white/90 transition-colors">
              {{ 'customer.addresses.add' | t | default: 'Save Address' }}
            </button>
            <button type="button" id="CancelAddAddress" class="px-6 py-2.5 rounded-xl bg-white/10 text-white hover:bg-white/20 transition-colors">
              {{ 'customer.addresses.cancel' | t | default: 'Cancel' }}
            </button>
          </div>
        </div>
      {% endform %}
    </div>

    <!-- Existing Addresses Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {% for address in customer.addresses %}
        <div class="p-6 rounded-2xl bg-white/[0.02] border border-white/10 flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between mb-4">
              <span class="font-mono text-xs text-white/40 uppercase">Address #{{ forloop.index }}</span>
              {% if address == customer.default_address %}
                <span class="px-2.5 py-0.5 rounded-full text-[10px] font-mono uppercase bg-white text-black font-bold">
                  {{ 'customer.addresses.default' | t | default: 'Default' }}
                </span>
              {% endif %}
            </div>
            <div class="text-xs leading-relaxed text-white/80 font-sans mb-6">
              <div class="font-bold text-white text-sm mb-1">{{ address.name }}</div>
              {% if address.company != blank %}<div>{{ address.company }}</div>{% endif %}
              <div>{{ address.address1 }}</div>
              {% if address.address2 != blank %}<div>{{ address.address2 }}</div>{% endif %}
              <div>{{ address.city }}, {{ address.province_code }} {{ address.zip }}</div>
              <div>{{ address.country }}</div>
              {% if address.phone != blank %}<div class="text-white/50 mt-1">{{ address.phone }}</div>{% endif %}
            </div>
          </div>

          <div class="pt-4 border-t border-white/10 flex gap-3 font-mono text-xs">
            <form method="post" action="/account/addresses/{{ address.id }}">
              <input type="hidden" name="_method" value="delete">
              <button type="submit" class="text-red-400 hover:text-red-300 underline" onclick="return confirm('{{ 'customer.addresses.delete_confirm' | t | default: 'Are you sure you wish to delete this address?' }}')">
                {{ 'customer.addresses.delete' | t | default: 'Delete' }}
              </button>
            </form>
          </div>
        </div>
      {% endfor %}
    </div>
  </div>
</section>

<script>
  (function() {
    var toggleBtn = document.getElementById('AddNewAddressToggle');
    var cancelBtn = document.getElementById('CancelAddAddress');
    var panel = document.getElementById('AddAddressPanel');

    if (toggleBtn && panel) {
      toggleBtn.addEventListener('click', function() {
        panel.classList.toggle('hidden');
      });
    }
    if (cancelBtn && panel) {
      cancelBtn.addEventListener('click', function() {
        panel.classList.add('hidden');
      });
    }
  })();
</script>

{% schema %}
{
  "name": "Customer Addresses",
  "settings": []
}
{% endschema %}
